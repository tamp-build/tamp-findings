<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / OpenAPI">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Entity Framework Core + Postgres">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="Logging / config">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup Label="Tamp ecosystem (TFND-14 — dogfood pipeline)">
    <!-- Meta package brings: Core, NetCli.V10, CycloneDx.V6, OpenGrep,
         OsvScanner.V2, Trivy, Sarif, Sbom, DependencyTrack.V1, DefectDojo.V2.
         As of 1.12.0 (TAM-254), each security-chain wrapper ships from its own
         satellite repo at 1.11.2+. PackageReferences resolve transparently.
         1.13.0 (TAM-274/275) adds SecurityPipelineMetrics auto-target —
         emits tamp.security.scan.findings_count + sbom.components_count
         counters for free under `tamp Security`. -->
    <PackageVersion Include="Tamp.Security.Pipeline" Version="1.13.0" />
    <!-- Not in the meta package — secrets scanning satellite. -->
    <PackageVersion Include="Tamp.TruffleHog.V3" Version="0.1.1" />
    <!-- TAM-276: TS/JS style + best-practice (the ReSharper analogue for the
         SPA). Covers what OpenGrep's security packs intentionally don't. -->
    <PackageVersion Include="Tamp.Eslint.V9" Version="0.1.0" />
    <!-- TAM-277 / TFND-27: axe-core a11y. Scan + ConvertToSarif verbs. SARIF
         output plugs into /ingest/findings the same way ESLint/Trivy do. -->
    <PackageVersion Include="Tamp.AxeCore" Version="0.1.0" />
    <!-- TAM-278 / TAM-280 / TFND-38: DAST against a deployed target. Both
         emit SARIF natively, so unlike axe-core there's no converter leg. -->
    <PackageVersion Include="Tamp.Zap" Version="0.1.1" />
    <PackageVersion Include="Tamp.Nuclei" Version="0.1.0" />
    <!-- TAM-279: pinned ahead of what Tamp.Security.Pipeline 1.13.0 pulls in
         transitively (1.13.0). 1.14.0 models region.snippet, which is what
         lets SarifIngestMapper stop passing Snippet: null — that improves
         cross-build dedup for EVERY SARIF scanner, not just the DAST ones.
         Transitive pinning is on, so this wins over the transitive version. -->
    <PackageVersion Include="Tamp.Sarif" Version="1.14.0" />
    <!-- Versioning + GitHub CLI for release/PR plumbing. -->
    <PackageVersion Include="Tamp.GitVersion.V6" Version="0.2.0" />
    <PackageVersion Include="Tamp.GitHubCli.V2" Version="0.1.1" />
    <!-- Coverage + reporting. -->
    <PackageVersion Include="Tamp.DotNetCoverage.V18" Version="1.11.1" />
    <PackageVersion Include="Tamp.Coverlet.V6" Version="0.2.0" />
    <PackageVersion Include="Tamp.ReportGenerator.V5" Version="0.1.1" />
    <!-- EF Core wrapper for migrations from the build script. -->
    <PackageVersion Include="Tamp.EFCore.V10" Version="0.4.0" />
    <!-- SBOM + CVE scanners (not in Security.Pipeline meta yet). -->
    <PackageVersion Include="Tamp.Syft.V1" Version="1.11.0" />
    <PackageVersion Include="Tamp.Grype" Version="0.1.0" />
    <!-- TFND-43 lab cluster deploy: container build + push, kubectl apply.
         Tamp.Kubectl 0.1.0 (TAM-221), Tamp.Docker.V27 0.3.1. Helm reserved
         for if we move to a chart later. -->
    <PackageVersion Include="Tamp.Docker.V27" Version="0.3.1" />
    <PackageVersion Include="Tamp.Kubectl" Version="0.1.0" />
    <PackageVersion Include="Tamp.Helm.V3" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup Label="Roslyn security analyzers (TFND-14 — TAM-248 pattern; gated by /p:IncludeSecurityAnalyzers=true)">
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.25.0.139117" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup Label="Transitive pins (CVE patches; central package transitive pinning surfaces these)">
    <!-- Npgsql 10.0.1 pulls in System.Security.Cryptography.Xml 9.0.0 which has
         known high-severity advisories (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf).
         Pin to a patched 10.x. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup Label="Test stack (TFND mirrors tamp test stack)">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Bogus" Version="35.6.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup Label="Source link">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
  </ItemGroup>

</Project>
