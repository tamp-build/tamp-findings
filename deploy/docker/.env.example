# tamp.findings — plain-Docker deployment config.
# Copy to deploy/docker/.env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------

# Postgres password (used by both the postgres and api containers).
DB_PASSWORD=change-me

# GitHub OAuth app. Register one at https://github.com/settings/developers with
# callback URL  https://<your-host>/auth/github/callback  (production) — a
# separate app with http://localhost:5173/auth/github/callback is used for dev.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The GitHub login that auto-promotes to instance admin on first sign-in.
GITHUB_BOOTSTRAP_ADMIN_LOGIN=

# --- Optional ---------------------------------------------------------------

# Host port to publish the app on (behind your reverse proxy). Default 5080.
TAMP_FINDINGS_PORT=5080

# Gate enforcement (ADR 0004). Leave blank for the advisory default.
#   TAMP_FINDINGS_ENFORCEMENT_MODE=enforcing
#   TAMP_FINDINGS_ENFORCEMENT_LOCKED=true    # platform floor; the in-app admin cannot lower it
TAMP_FINDINGS_ENFORCEMENT_MODE=
TAMP_FINDINGS_ENFORCEMENT_LOCKED=

# Provenance verification trust root — a PEM public key inbound DSSE
# attestations must be signed by for SSDF PS.2.1 to read "Yes". Blank = nothing
# is verified (attestations show as "Partial: unverified").
#   TAMP_FINDINGS_PROVENANCE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
TAMP_FINDINGS_PROVENANCE_PUBLIC_KEY=

# Attestation signing key — a PEM private key used to key-back the outbound
# attestation signature. Blank = attestations are signed off by name only.
#   TAMP_FINDINGS_ATTESTATION_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
TAMP_FINDINGS_ATTESTATION_SIGNING_KEY=
