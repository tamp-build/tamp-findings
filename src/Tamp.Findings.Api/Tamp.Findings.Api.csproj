<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tamp.Findings.Api</RootNamespace>
    <IsPackable>false</IsPackable>
    <UserSecretsId>tamp.findings.api</UserSecretsId>
    <Description>ASP.NET minimal API host for tamp.findings. Serves OpenAPI, ingestion, query, and (in prod) the static SPA bundle.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The authentication handlers are internal because nothing outside the
         host should invoke them, and they are exactly where a mistake mints a
         cookie that should not exist — so they have to be asserted directly
         rather than inferred from a rendered page. -->
    <InternalsVisibleTo Include="Tamp.Findings.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Generic OIDC (TFND-111). One handler covers Entra, Okta,
         Keycloak and Auth0 because discovery reads the endpoints from
         the authority. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- TFND-12: the MCP endpoint is served by this host, in process. Tools
         reach the Application layer directly, so an agent's read goes through
         the same CapabilityEvaluator a human's does. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tamp.Findings.Domain\Tamp.Findings.Domain.csproj" />
    <ProjectReference Include="..\Tamp.Findings.Data\Tamp.Findings.Data.csproj" />
    <ProjectReference Include="..\Tamp.Findings.Application\Tamp.Findings.Application.csproj" />
    <ProjectReference Include="..\Tamp.Findings.Web\Tamp.Findings.Web.csproj" />
    <ProjectReference Include="..\Tamp.Findings.Workflows\Tamp.Findings.Workflows.csproj" />
    <ProjectReference Include="..\Tamp.Findings.Mcp\Tamp.Findings.Mcp.csproj" />
  </ItemGroup>

</Project>
