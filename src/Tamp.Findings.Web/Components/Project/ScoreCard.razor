@* "How are we trending" — the score, its band, and the ranked contribution
   table that replaces the six-of-twelve concentric rings.

   The old rings drew six of twelve categories. Showing ALL of them is the
   point: a category contributing nothing is information, and a category that
   is disabled in policy is different information again. *@

@inject ViewPreferences Prefs

<Card>
    <div class="kicker">How are we trending</div>

    <div class="score">
        <span class="score__value" style="color: @BandTone(Data.Risk.Band)">@Data.Risk.Score.ToString("F1")</span>
        <Chip Label="@Data.Risk.Band" Tone="@BandTone(Data.Risk.Band)" />
        @if (Prefs.ShowDeltas && Data.Gates.DeltaPoints is { } delta)
        {
            @* Never wraps: a delta that falls to its own line reads as a
               separate fact rather than as a qualifier on the score. *@
            <span class="score__delta num">@Signed(delta) vs prior build</span>
        }
        <div class="score__caption">
            <div>@Bands()</div>
            <div class="muted">Categories saturate — the score is posture, not volume.</div>
        </div>
    </div>

    @* The trend across the recent canonical builds — the multi-build view the
       single "vs prior" delta cannot give. Lower is better, so a falling line is
       an improving posture. *@
    @if (TrendSeries.Count >= 2)
    {
        <div class="score__trend" title="@TrendTitle">
            <Sparkline Points="TrendSeries" Color="@TrendColor" Width="220" Height="44" AriaLabel="@TrendTitle" />
            <span class="mono score__trendlabel" style="color: @TrendColor">@TrendLabel</span>
        </div>
    }

    <div class="contrib">
        @foreach (var row in Data.Risk.Breakdown)
        {
            <div class="contrib__row @(row.Contribution > 0 ? "contrib__row--hot" : null) @(row.Enabled ? null : "contrib__row--off")">
                <div>
                    @* Every scored category has a detail page (v3 §3); the label
                       links to it in the accent colour. *@
                    <a class="contrib__label" href="@CategoryHref(row.Key)">@Label(row.Key)</a>
                    <div class="contrib__key mono">@row.Key</div>
                </div>

                <div class="contrib__bar" role="img" aria-label="@BarLabel(row)">
                    <div class="contrib__fill" style="width: @Percent(row)%; background: @FillTone(row)"></div>
                </div>

                <div class="num contrib__points">
                    @row.Contribution.ToString("F1") / @row.EffectiveMax.ToString("F0")
                </div>

                <div>
                    @if (row.Saturated)
                    {
                        @* SAT and the red fill read the same fact off the same
                           field, so they cannot disagree (TFND-76). *@
                        <span class="contrib__sat mono">SAT</span>
                    }
                </div>

                <div class="contrib__evidence">
                    @if (!row.Enabled)
                    {
                        <span class="muted">disabled in policy</span>
                    }
                    else
                    {
                        <span>@Evidence(row)</span>
                    }
                </div>
            </div>
        }
    </div>

    <p class="field__help">
        SAT = category saturated: more findings of that class cannot raise the score.
        @Data.Risk.Breakdown.Count of @Data.Risk.Breakdown.Count scored categories shown.
    </p>
</Card>

@code {
    [Parameter, EditorRequired] public ProjectHubData Data { get; set; } = default!;

    // History is newest-first; the sparkline reads left (past) to right (now).
    private IReadOnlyList<double> TrendSeries => Data.History.Select(h => h.Score).Reverse().ToArray();

    private double TrendChange => TrendSeries is { Count: >= 2 } s ? s[^1] - s[0] : 0;
    private bool TrendFlat => Math.Abs(TrendChange) < 0.05;
    private bool TrendImproving => TrendChange < 0;   // lower is better

    private string TrendColor =>
        TrendFlat ? "var(--color-neutral-600)"
        : TrendImproving ? "var(--color-band-green)" : "var(--color-band-red)";

    private string TrendLabel
    {
        get
        {
            var n = TrendSeries.Count;
            if (TrendFlat) return $"— flat over {n} builds";
            var arrow = TrendImproving ? "▼" : "▲";
            var sign = TrendChange > 0 ? "+" : "−";
            return $"{arrow} {sign}{Math.Abs(TrendChange):F1} over {n} builds";
        }
    }

    private string TrendTitle =>
        TrendSeries.Count < 2 ? ""
        : $"{TrendSeries.Count} builds: {TrendSeries[0]:F1} → {TrendSeries[^1]:F1} "
          + $"({(TrendFlat ? "flat" : TrendImproving ? "improving" : "worsening")})";

    private string CategoryHref(string key) =>
        Routes.Category(Data.Project.ClientName, Data.Project.ProjectName,
            Data.CommitSha ?? Routes.LatestBuild, key);

    private static string Signed(double d) => d > 0 ? $"+{d:F1}" : d.ToString("F1");

    private static string BandTone(string band) => band switch
    {
        "green" => "var(--color-band-green)",
        "yellow" => "var(--color-band-yellow)",
        "orange" => "var(--color-band-orange)",
        _ => "var(--color-band-red)",
    };

    private double Percent(RiskCategoryBreakdown row) =>
        row.EffectiveMax <= 0 ? 0 : Math.Clamp(row.Contribution / row.EffectiveMax * 100, 0, 100);

    private static string FillTone(RiskCategoryBreakdown row) =>
        row.Saturated ? "var(--color-critical)"
        : row.Contribution > 0 ? "var(--color-accent)"
        : "var(--color-neutral-400)";

    // The bar is decorative on its own — the numbers beside it carry the same
    // value — but a screen reader should not be handed an unlabelled div.
    private string BarLabel(RiskCategoryBreakdown row) =>
        $"{Label(row.Key)}: {row.Contribution:F1} of {row.EffectiveMax:F0} points"
        + (row.Saturated ? ", saturated" : "");

    private string Bands()
    {
        // Read from the live policy rather than hard-coded, so the caption
        // cannot contradict the band the chip is showing.
        return "Bands are set by the project's risk policy.";
    }

    private static string Evidence(RiskCategoryBreakdown row) =>
        row.Contribution <= 0 ? "nothing found" : $"{row.SubScore * 100:F0}% of this category's ceiling";

    // Human labels for policy keys. Data, not copy — the KEY is the identifier
    // the policy editor and the API use, and it stays visible beneath.
    private static string Label(string key) => key switch
    {
        "cve" => "Known CVEs",
        "secrets" => "Secrets",
        "sast" => "Static analysis",
        "dast" => "Dynamic scan",
        "iac" => "IaC misconfig",
        "coverage" => "Coverage",
        "tests" => "Tests",
        "sbom" => "SBOM freshness",
        "licenses" => "Licences",
        "missingScanners" => "Missing scanners",
        _ => key,
    };
}
