@* Evidence · <commit> — one tile per collected-evidence source (v3 §2.4). Each
   tile carries a status mark, a one-line status, and a GATE LINE that says
   whether this evidence blocks the build, and a 2px top border in the status
   colour. A red ✕ mark means an enabled gate is failing; anything that needs
   attention but is not gated is an amber ! . A missing scan is dashed and
   orange — never green, because "a missing scan is not a clean scan".

   ADR conformance has no producer yet (that lands with the conformance ingest,
   ADR 0006 / core ADR 0023), so it renders honestly as "not scanned". *@

@using Tamp.Findings.Domain.Risk

<Card>
    <div class="kicker">Evidence · <span class="mono">@Sha</span></div>
    <div class="evtiles">
        @foreach (var t in Tiles)
        {
            <a class="evtile @(t.Dashed ? "evtile--dashed" : null)" href="@EvidenceHref(t.Key)" style="border-top-color: @t.Color">
                <div class="evtile__head">
                    <span class="evtile__label">@t.Label</span>
                    <span class="evtile__mark" style="color: @t.Color">@t.Mark</span>
                </div>
                <div class="evtile__status">@t.Status</div>
                <div class="evtile__gate mono" style="color: @t.GateColor">@t.GateLine</div>
            </a>
        }
    </div>
</Card>

@code {
    [Parameter, EditorRequired] public ProjectHubData Data { get; set; } = default!;
    [Parameter] public int PoamPastDue { get; set; }
    [Parameter] public string? Sha { get; set; }

    private sealed record Tile(
        string Key, string Label, string Mark, string Color, bool Dashed, string Status, string GateLine, string GateColor);

    private string EvidenceHref(string key) =>
        Routes.Evidence(Data.Project.ClientName, Data.Project.ProjectName, Data.CommitSha ?? Routes.LatestBuild, key);

    // (mark, colour, dashed) for each status.
    private static readonly (string Mark, string Color, bool Dashed) Ok = ("✓", "var(--color-pass)", false);
    private static readonly (string Mark, string Color, bool Dashed) Warn = ("!", "var(--color-medium)", false);
    private static readonly (string Mark, string Color, bool Dashed) Bad = ("✕", "var(--color-critical)", false);
    private static readonly (string Mark, string Color, bool Dashed) Missing = ("—", "var(--color-high)", true);

    private IReadOnlyList<Tile> Tiles => Build();

    private IReadOnlyList<Tile> Build()
    {
        var i = Data.Inputs;
        var tiles = new List<Tile>();

        // ADR conformance — no producer (phase 7). Honest not-scanned.
        tiles.Add(Make(EvidenceKeys.Conformance, "ADR conformance", Missing, "Not scanned", Gate()));

        // Dynamic scan (DAST).
        var dast = i.DastCritical + i.DastHigh + i.DastMedium + i.DastLow;
        var dastGate = Gate(GateKeys.CriticalDast, GateKeys.HighDast);
        tiles.Add(!i.RanDast
            ? Make(EvidenceKeys.Dast, "Dynamic scan", Missing, "Not scanned", dastGate)
            : dast == 0
                ? Make(EvidenceKeys.Dast, "Dynamic scan", Ok, "No alerts", dastGate)
                : Make(EvidenceKeys.Dast, "Dynamic scan", ForGate(dastGate), $"{dast} alert{Plural(dast)}", dastGate));

        // KEV exposure.
        var kevGate = Gate(GateKeys.KevExposure);
        tiles.Add(i.KevListedCves == 0
            ? Make(EvidenceKeys.Kev, "KEV exposure", Ok, "None exposed", kevGate)
            : Make(EvidenceKeys.Kev, "KEV exposure", ForGate(kevGate), $"{i.KevListedCves} KEV-listed CVE{Plural(i.KevListedCves)}", kevGate));

        // Design & quality (not gated).
        tiles.Add(i.RanQuality
            ? Make(EvidenceKeys.Quality, "Design & quality", Ok, "Checked", Gate())
            : Make(EvidenceKeys.Quality, "Design & quality", Missing, "Not scanned", Gate()));

        // Accessibility (not gated).
        tiles.Add(i.RanAccessibility
            ? Make(EvidenceKeys.Accessibility, "Accessibility", Ok, "Checked", Gate())
            : Make(EvidenceKeys.Accessibility, "Accessibility", Missing, "Not scanned", Gate()));

        // Base image age.
        var baseGate = Gate(GateKeys.BaseImageAge);
        var oldest = Data.Images
            .Select(im => im.BaseImageAgeInDays)
            .Where(a => a is not null).Select(a => a!.Value)
            .DefaultIfEmpty(-1).Max();
        // Age-driven, not presence-driven: a young base image is healthy, not a
        // warning. >30 days needs attention; a blocking gate makes it ✕.
        var baseStatus = baseGate.Line == "✕ blocks ship" ? Bad : oldest > 30 ? Warn : Ok;
        tiles.Add(oldest < 0
            ? Make(EvidenceKeys.BaseImage, "Base image age", Missing, "No image inspected", baseGate)
            : Make(EvidenceKeys.BaseImage, "Base image age", baseStatus, $"Oldest base image {oldest} day{Plural(oldest)}", baseGate));

        // POA&M due dates.
        var poamGate = Gate(GateKeys.PoamPastDue);
        tiles.Add(PoamPastDue == 0
            ? Make(EvidenceKeys.Poam, "POA&M due dates", Ok, "None past due", poamGate)
            : Make(EvidenceKeys.Poam, "POA&M due dates", ForGate(poamGate), $"{PoamPastDue} past due", poamGate));

        return tiles;
    }

    // The gate line for this evidence: does an enabled gate over these keys
    // block, pass, or is it disabled or absent?
    private (string Line, string Color) Gate(params string[] keys)
    {
        var gates = Data.Gates.Results.Where(r => keys.Contains(r.Key)).ToArray();
        var enabled = gates.Where(g => g.Enabled).ToArray();
        if (enabled.Any(g => g.Blocks)) return ("✕ blocks ship", "var(--color-critical)");
        if (enabled.Length > 0) return ("gated · passing", "var(--color-pass)");
        if (gates.Length > 0) return ("gate disabled", "var(--color-neutral-500)");
        return ("not gated", "var(--color-neutral-500)");
    }

    // A source that HAS findings: red ✕ if its gate blocks, amber ! otherwise.
    private static (string, string, bool) ForGate((string Line, string Color) gate) =>
        gate.Line == "✕ blocks ship" ? Bad : Warn;

    private static Tile Make(
        string key, string label, (string Mark, string Color, bool Dashed) s, string status, (string Line, string Color) gate) =>
        new(key, label, s.Mark, s.Color, s.Dashed, status, gate.Line, gate.Color);

    private static string Plural(int n) => n == 1 ? "" : "s";
}
