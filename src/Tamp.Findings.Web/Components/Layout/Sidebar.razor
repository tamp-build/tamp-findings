@* Fixed 238px sidebar on --color-neutral-100 with a right hairline.

   Below the dense breakpoint it becomes a full-width band above the content
   rather than a column beside it (ADR 0003) — the page reflows, and a fixed
   238px column at 320px would guarantee two-dimensional scrolling.

   Counts are OMITTED when unknown rather than shown as zero. A nav item
   reading "Findings (0)" when nobody has counted is the same lie as a gate
   passing because no scanner ran. *@

@inject RouteScope Scope
@inject NavigationManager Nav
@implements IDisposable

<nav class="sidebar" aria-label="Primary">
    <div class="sidebar__brand">
        <div class="brand">tamp<span class="brand__accent">.findings</span></div>
        <div class="kicker">attestation evidence</div>
    </div>

    @* The four tiers of the domain model. This hierarchy is load-bearing and
       appears on nearly every screen, so it is chrome rather than content. *@
    <Card Class="sidebar__scope">
        @foreach (var tier in Tiers)
        {
            <div class="scope-row">
                <div class="scope-row__label">@tier.Label</div>
                <div class="scope-row__value mono" title="@tier.Value">@(tier.Value ?? "—")</div>
                <Icon Name="chevron-right" Size="12" Class="scope-row__chevron" />
            </div>
        }
    </Card>

    @foreach (var group in Groups)
    {
        <div class="navgroup @(group.Instance ? "navgroup--instance" : null)">
            <div class="navgroup__label">@group.Label</div>
            @foreach (var item in group.Items)
            {
                <a class="navitem @(IsActive(item) ? "navitem--active" : null)"
                   href="@item.Href"
                   aria-current="@(IsActive(item) ? "page" : null)">
                    <span class="navitem__label">@item.Label</span>
                    @if (item.Count is not null)
                    {
                        <span class="navitem__count num">@item.Count</span>
                    }
                </a>
            }
        </div>
    }

    <div class="sidebar__foot">
        <AuthorizeView>
            <Authorized>
                <div class="mono">@context.User.Identity?.Name</div>
                <div class="kicker">signed in</div>
            </Authorized>
            <NotAuthorized>
                <div class="kicker">not signed in</div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    private sealed record NavItem(string Label, string Href, string? Count = null);
    private sealed record NavGroup(string Label, IReadOnlyList<NavItem> Items, bool Instance = false);

    private (string Label, string? Value)[] Tiers =>
    [
        ("Client", Scope.Client),
        ("Project", Scope.Project),
        ("Component", Scope.Component),
        ("Build", Scope.Build),
    ];

    private IReadOnlyList<NavGroup> Groups
    {
        get
        {
            var c = Scope.Client;
            var p = Scope.Project;
            var b = Scope.Build;
            var scoped = c is not null && p is not null;

            var groups = new List<NavGroup>
            {
                new("Scope",
                [
                    new("Portfolio", Routes.Portfolio),
                    .. scoped && b is not null
                        ? new[] { new NavItem("Project hub", Routes.ProjectHub(c!, p!, b)) }
                        : [],
                ]),
            };

            // The explore and evidence groups only mean anything inside a
            // project, so they are absent rather than dead outside one.
            if (scoped && b is not null)
            {
                groups.Add(new("Explore",
                [
                    new("Findings", Routes.Explorer(c!, p!, b, Spines.Sast)),
                    new("Dynamic scan", Routes.Explorer(c!, p!, b, Spines.Dast)),
                    new("SBOM", Routes.Explorer(c!, p!, b, Spines.Sbom)),
                    new("Coverage", Routes.Explorer(c!, p!, b, Spines.Coverage)),
                    new("Tests", Routes.Explorer(c!, p!, b, Spines.Tests)),
                ]));
            }

            if (scoped)
            {
                var evidence = new List<NavItem>
                {
                    new("POA&M", Routes.Poam(c!, p!)),
                    new("VEX statements", Routes.Vex(c!, p!)),
                };
                if (b is not null) evidence.Add(new("Attestation", Routes.Attestation(c!, p!, b)));
                groups.Add(new("Evidence", evidence));

                groups.Add(new("Project admin",
                [
                    new("Policy & gates", Routes.Policy(c!, p!)),
                    new("Ingest keys", Routes.Keys(c!, p!)),
                ]));
            }

            // Visually separated: a top hairline, extra padding above, and a
            // group label in the accent rather than neutral — it sits outside
            // the project scope and the nav says so.
            groups.Add(new("System · instance",
            [
                new("Users & RBAC", Routes.System(SystemPanels.Users)),
                new("Authentication", Routes.System(SystemPanels.Authentication)),
                new("Scanners & ingest", Routes.System(SystemPanels.Scanners)),
                new("Instance settings", Routes.System(SystemPanels.Settings)),
                new("Audit log", Routes.System(SystemPanels.Audit)),
            ], Instance: true));

            return groups;
        }
    }

    private bool IsActive(NavItem item)
    {
        var current = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        var path = current.Split('#')[0].Split('?')[0].TrimEnd('/');
        var href = item.Href.Split('#')[0].TrimEnd('/');
        return string.Equals(path, href, StringComparison.OrdinalIgnoreCase);
    }

    protected override void OnInitialized()
    {
        Scope.Changed += Refresh;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? _, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs __) => Refresh();

    public void Dispose()
    {
        Scope.Changed -= Refresh;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
