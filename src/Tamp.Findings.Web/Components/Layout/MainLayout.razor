@inherits LayoutComponentBase
@inject ViewPreferences Prefs
@implements IDisposable

@* A flex row: fixed sidebar, main column filling the rest.

   Per ADR 0003 there is no min-width. Below the dense breakpoint the row
   becomes a column — sidebar above content — so the page reflows instead of
   scrolling in two dimensions. *@

<div class="layout @Prefs.DensityClass">
    <Sidebar />
    <main class="layout__main">
        <AppHeader />
        <div class="shell">
            @Body
        </div>
    </main>
</div>

@code {
    protected override void OnInitialized() => Prefs.Changed += Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only after the first INTERACTIVE render: during prerender there is
        // no browser to read localStorage from and the interop call throws.
        if (firstRender) await Prefs.LoadAsync();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Prefs.Changed -= Refresh;
}
