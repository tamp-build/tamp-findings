@* 24px square accent avatar with the user's initials, the login in monospace,
   and a caret. Opens a 246px blueprint menu on --color-neutral-100.

   Sign out is in #dd5f5f because it ends the session — the design's rule that
   destructive actions look destructive applies to leaving, not just deleting. *@

@inject NavigationManager Nav
@inject RouteScope Scope
@inject IStringLocalizer<UiStrings> L

<AuthorizeView>
    <Authorized>
        <div class="account">
            <button type="button" class="account__trigger" @onclick="Toggle"
                    aria-haspopup="menu" aria-expanded="@_open.ToString().ToLowerInvariant()">
                <span class="avatar" aria-hidden="true">@Initials(context.User.Identity?.Name)</span>
                <span class="mono account__login">@context.User.Identity?.Name</span>
                <Icon Name="chevron-down" Size="12" />
            </button>

            @if (_open)
            {
                @* Click-away layer. A menu that only closes via its own trigger
                   is a trap for anyone who opened it by accident. *@
                <div class="account__scrim" @onclick="Close"></div>

                <Card Surface="true" Padded="false" Class="account__menu" role="menu">
                    <div class="account__head">
                        <span class="avatar avatar--lg" aria-hidden="true">@Initials(context.User.Identity?.Name)</span>
                        <div>
                            <div class="mono">@context.User.Identity?.Name</div>
                            <div class="kicker">@L["Account.SignedIn"]</div>
                        </div>
                    </div>

                    @foreach (var item in Items)
                    {
                        <a class="account__item" role="menuitem" href="@item.Href" @onclick="Close">
                            <span class="@(item.Danger ? "account__item-danger" : null)">@item.Label</span>
                            <span class="account__item-sub">@item.Sub</span>
                        </a>
                    }

                    @* Locale. Ports LanguageSwitcher.tsx, and it is not
                       decoration: the pseudo-locale is how the ~40% expansion
                       gets verified per screen without a translator (TFND-67),
                       so it has to be reachable from every screen. *@
                    <div class="account__head" style="border-top: 1px solid var(--color-divider)">
                        <div style="width: 100%">
                            <div class="kicker">@L["Account.Locale"]</div>
                            <div class="row" style="gap: var(--space-2); margin-top: var(--space-1)">
                                @foreach (var locale in Locales)
                                {
                                    <a class="chip @(IsCurrent(locale.Key) ? "chip--solid" : "chip--outlined")"
                                       style="color: var(--color-accent)"
                                       href="@LocaleHref(locale.Key)">@locale.Value</a>
                                }
                            </div>
                        </div>
                    </div>
                </Card>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <a class="btn" href="/auth/login">@L["Account.SignIn"]</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private sealed record MenuItem(LocalizedString Label, LocalizedString Sub, string Href, bool Danger = false);

    private bool _open;

    private static readonly KeyValuePair<string, string>[] Locales =
    [
        new("en", "en"),
        new(PseudoLocale.CultureName, "pseudo"),
    ];

    // Scope-aware. The settings screens live under a project, and a hardcoded
    // placeholder scope sent the reader to a project called "-" that does not
    // exist — a dead link on every screen. With no project in scope the items
    // point at the portfolio, which is where you pick one.
    private IReadOnlyList<MenuItem> Items =>
        Scope.HasProject
        ?
        [
            new(L["Account.Profile"], L["Account.ProfileSub"], Settings("account")),
            new(L["Account.ApiKeys"], L["Account.ApiKeysSub"], Settings("keys")),
            new(L["Nav.PolicyAndGates"], L["Account.PolicySub"], Settings("policy")),
            new(L["Account.SignOut"], L["Account.SignOutSub"], "/auth/logout", Danger: true),
        ]
        :
        [
            new(L["Nav.Portfolio"], L["Account.ProfileSub"], Routes.Portfolio),
            new(L["Account.SignOut"], L["Account.SignOutSub"], "/auth/logout", Danger: true),
        ];

    private string Settings(string tab) =>
        $"/c/{Uri.EscapeDataString(Scope.Client!)}/p/{Uri.EscapeDataString(Scope.Project!)}/settings/{tab}";

    private static bool IsCurrent(string culture) =>
        string.Equals(System.Globalization.CultureInfo.CurrentUICulture.Name, culture,
                      StringComparison.OrdinalIgnoreCase);

    // Round-trips through the server so the culture cookie is set and the
    // request re-runs under it. A client-side swap would change the labels
    // without changing what the server formats — dates and numbers would stay
    // in the old locale, which is worse than not offering the switch.
    private string LocaleHref(string culture)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri);
        var separator = current.Contains('?') ? '&' : '?';
        return $"/{current}{separator}culture={culture}";
    }

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split([' ', '-', '.', '_'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[1][0]))
            : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }
}
