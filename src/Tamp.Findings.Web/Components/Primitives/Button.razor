@* The primary variant is the one solid object in the design system. *@

@* Extra attributes are splatted so callers can pass title, aria-* and data-*
   without every one needing its own parameter. DisabledReason wins over a
   caller's title when the button is disabled: explaining WHY it is unavailable
   is more useful than whatever the enabled-state tooltip said. *@
<button type="@(Submit ? "submit" : "button")"
        @attributes="Extra"
        class="btn @VariantClass @Class"
        disabled="@Disabled"
        title="@Tooltip"
        @onclick="OnClick" @onclick:stopPropagation="StopPropagation">
    @ChildContent
</button>

@code {
    public enum ButtonVariant { Secondary, Primary, Danger, Warning, Text }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;
    [Parameter] public bool Disabled { get; set; }
    /// <summary>
    /// Shown as the title when disabled. Destructive and gated actions should
    /// always say WHY they are unavailable rather than just going grey.
    /// </summary>
    [Parameter] public string? DisabledReason { get; set; }
    [Parameter] public bool Submit { get; set; }
    /// <summary>Row actions live inside clickable rows; they must not bubble.</summary>
    [Parameter] public bool StopPropagation { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? Extra { get; set; }

    private string? Tooltip =>
        Disabled && !string.IsNullOrWhiteSpace(DisabledReason)
            ? DisabledReason
            : Extra is not null && Extra.TryGetValue("title", out var t) ? t?.ToString() : null;

    private string? VariantClass => Variant switch
    {
        ButtonVariant.Primary => "btn--primary",
        ButtonVariant.Danger  => "btn--danger",
        ButtonVariant.Warning => "btn--warning",
        ButtonVariant.Text    => "btn--text",
        _ => null,
    };
}
