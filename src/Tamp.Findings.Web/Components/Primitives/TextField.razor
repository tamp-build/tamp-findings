@* Text input with helper text BENEATH it, never as a placeholder — helper
   text has to survive typing. *@

<label class="field @Class">
    <span class="field__label">@Label</span>
    @if (Multiline)
    {
        <textarea class="textarea" rows="@Rows" disabled="@Disabled"
                  value="@Value" @oninput="Changed"></textarea>
    }
    else
    {
        <input class="input @(Mono ? "input--mono" : null)" type="@Type" disabled="@Disabled"
               value="@Value" @oninput="Changed" />
    }
    @if (Help is not null)
    {
        <span class="field__help">@Help</span>
    }
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    /// <summary>Shown beneath the field. Not a placeholder — see the header.</summary>
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public bool Mono { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Class { get; set; }

    private Task Changed(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
