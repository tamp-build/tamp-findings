@* Reveal-once panel for ingest tokens and project keys.

   The heading states the consequence in the imperative, because the value is
   genuinely unrecoverable after this render. Every secret in this app reveals
   exactly once, in a panel that says so. *@

<div class="secret @Class">
    <div class="secret__head">@Heading</div>
    <div class="row row--between">
        <code class="mono" style="word-break: break-all">@Value</code>
        @Actions
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string Heading { get; set; } = "Copy it now — this value is not stored and will not be shown again";
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? Class { get; set; }
}
