@* One shell, five spines.

   The selection is a CATCH-ALL because it is usually a source path and the
   slashes have to survive — ".../sast/src/Api/Program.cs" is one selection,
   not three segments. *@
@page "/c/{Client}/p/{Project}/build/{Sha}/{Spine}"
@page "/c/{Client}/p/{Project}/build/{Sha}/{Spine}/{*Selection}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RouteScope Scope
@inject NavigationManager Nav
@inject ProjectHubQuery Hub
@inject CurrentUser Me
@inject FindingsExplorerQuery Findings
@inject DastExplorerQuery Dast
@inject SbomExplorerQuery Sbom
@inject DependencyPathQuery DepPaths
@inject CoverageAndTestsQuery CoverageAndTests
@inject RuleBreakdownQuery Rules

<PageTitle>@Spine — @Project</PageTitle>

@if (!Spines.IsValid(Spine))
{
    @* An unknown spine is a broken link, not an empty screen. Say so, and
       offer a way out, rather than rendering a shell with nothing in it. *@
    <div class="stack">
        <h1>Unknown spine</h1>
        <Card>
            <p><code class="mono">@Spine</code> is not one of @KnownSpines.</p>
            <Button Variant="Button.ButtonVariant.Primary" OnClick="GoToSast">Go to the SAST spine</Button>
        </Card>
    </div>
}
else if (_project is null && _error is null)
{
    <div class="stack">
        <h1>Project not found</h1>
        <Card><p>No project matches <code class="mono">@Client / @Project</code>.</p></Card>
    </div>
}
else
{
    <ExplorerShell Client="@Client" Project="@Project" Sha="@Sha" ActiveSpine="@Spine"
                   Title="@SpineTitle" SubTitle="@SpineSubTitle" HasSelection="@(Selection is not null)">
        <Legend>
            @if (Spine == Spines.Dast && _dast is { Duplicates.Count: > 0 } && _project is not null)
            {
                <div style="width: 100%">
                    <DuplicateHostCallout Suspicions="_dast.Duplicates" Project="_project"
                                          OnMerged="Reload" />
                </div>
            }
            @if (Spine is Spines.Sast or Spines.Dast)
            {
                @* TFND-18. Grouping by path answers "which files are bad";
                   grouping by rule answers "what is wrong with this codebase".
                   With ~470 SonarAnalyzer rules plus ~500 Roslynator ones, a
                   severity count cannot tell eleven S2094s from four S6966s —
                   and those are two completely different pieces of work.

                   In the URL, because everything in this product is
                   addressable: a link to a rule breakdown is a link somebody
                   can send. *@
                <span class="row" style="gap: var(--space-2)">
                    <span class="kicker">Group by</span>
                    <a class="chip @(ByRule ? "chip--outlined" : "chip--solid")"
                       style="color: var(--color-accent)"
                       href="@Routes.Explorer(Client, Project, Sha, Spine)">path</a>
                    <a class="chip @(ByRule ? "chip--solid" : "chip--outlined")"
                       style="color: var(--color-accent)"
                       href="@($"{Routes.Explorer(Client, Project, Sha, Spine)}?group=rule")">rule</a>
                </span>
            }

            @if (Spine is Spines.Sast or Spines.Dast or Spines.Sbom or Spines.Accessibility)
            {
                @foreach (var s in new[] { Severity.Critical, Severity.High, Severity.Medium, Severity.Low, Severity.Info })
                {
                    <SeverityBadge Severity="s" ShowName="true" />
                }
            }
            @if (Spine == Spines.Coverage)
            {
                <span class="mono" style="color: var(--color-pass)">+ covered</span>
                <span class="mono" style="color: var(--color-critical)">− not covered</span>
                <span class="muted" style="font-size: var(--text-secondary)">
                    unmarked lines are not executable
                </span>
            }
            @if (Spine == Spines.Tests)
            {
                <Chip Label="PASSED" Tone="var(--color-pass)" Style="Chip.ChipStyle.Outlined" />
                <Chip Label="SKIPPED" Tone="var(--color-high)" Style="Chip.ChipStyle.Outlined" />
                <Chip Label="FAILED" Tone="var(--color-critical)" Style="Chip.ChipStyle.Outlined" />
                <span class="muted" style="font-size: var(--text-secondary)">
                    a skipped test is not a passing test
                </span>
            }
        </Legend>

        <Tree>
            @if (_error is not null)
            {
                @* Inside the shell rather than instead of it. The reader keeps
                   the spine strip and the grouping toggle — they are navigation,
                   and losing them turns a database blip into a dead end. *@
                <div class="card-body">
                    <div class="row">
                        <Chip Label="Unavailable" Tone="var(--color-high)" Style="Chip.ChipStyle.Solid" Glyph="!" />
                        <span>Could not load this evidence.</span>
                    </div>
                    <p class="field__help">Absent evidence is not clean evidence. @_error</p>
                </div>
            }
            else if (Spine == Spines.Dast)
            {
                @if (_dast is null || _dast.Hosts.Count == 0)
                {
                    <div class="card-body">
                        <p class="muted">No open dynamic-scan findings on this build.</p>
                        <p class="field__help">
                            If no DAST scanner ran, that is not the same as a clean result — check the
                            scan receipts on the project hub.
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var host in _dast.Hosts)
                    {
                        <TreeRow Name="@host.Host" Group="true" />
                        <Virtualize TItem="DastRouteRow" Items="host.Routes" Context="route" ItemSize="26">
                            <TreeRow Name="@route.Route" Depth="1"
                                     Selected="@(route.Route == Selection)"
                                     OnSelect="() => Select(route.Route)">
                                <Badge>
                                    <span class="row" style="gap: var(--space-1)">
                                        <SeverityBadge Severity="route.WorstSeverity" />
                                        <span class="num">@route.Count</span>
                                    </span>
                                </Badge>
                            </TreeRow>
                        </Virtualize>
                    }
                }
            }
            else if (Spine == Spines.Accessibility)
            {
                @if (_a11y is null || _a11y.Hosts.Count == 0)
                {
                    <div class="card-body">
                        <p class="muted">No open accessibility findings on this build.</p>
                        <p class="field__help">
                            If no accessibility scanner ran, that is not the same as a conformant
                            interface — and for federal work an unmeasured interface is not one that
                            can be attested. Check the scan receipts on the project hub.
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var host in _a11y.Hosts)
                    {
                        <TreeRow Name="@host.Host" Group="true" />
                        <Virtualize TItem="DastRouteRow" Items="host.Routes" Context="route" ItemSize="26">
                            <TreeRow Name="@route.Route" Depth="1"
                                     Selected="@(route.Route == Selection)"
                                     OnSelect="() => Select(route.Route)">
                                <Badge>
                                    <span class="row" style="gap: var(--space-1)">
                                        <SeverityBadge Severity="route.WorstSeverity" />
                                        <span class="num">@route.Count</span>
                                    </span>
                                </Badge>
                            </TreeRow>
                        </Virtualize>
                    }
                }
            }
            else if (Spine == Spines.Sbom)
            {
                @if (_sbom.Count == 0)
                {
                    <div class="card-body">
                        <p class="muted">No dependencies recorded on this build.</p>
                        <p class="field__help">
                            No SBOM was ingested for this build. That is not the same as a project with
                            no dependencies — check the scan receipts on the project hub.
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var ecosystem in _sbom)
                    {
                        <TreeRow Name="@ecosystem.Ecosystem" Group="true" />
                        <Virtualize TItem="SbomLeaf" Items="ecosystem.Components" Context="dep" ItemSize="26">
                            <TreeRow Name="@($"{dep.Name} {dep.Version}")" Depth="1"
                                     Selected="@(dep.Purl == Selection)"
                                     OnSelect="() => Select(dep.Purl)">
                                <Badge>
                                    <span class="row" style="gap: var(--space-1)">
                                        @if (dep.PaidVendor is { Length: > 0 } vendor)
                                        {
                                            @* TFND-8 (F7.3). Shown HERE, not
                                               only on the costs view, because
                                               this is the screen somebody is on
                                               when they decide whether to keep a
                                               dependency — and "this one renews"
                                               is part of that decision. *@
                                            <span class="mono" style="color: var(--color-accent)"
                                                  title="@($"{vendor} — a paid subscription covers this package")">$</span>
                                        }
                                        @if (dep.StaleDays is { } behind)
                                        {
                                            @* TFND-22. The registry told us how
                                               far behind this version is, so say
                                               so — the number already feeds the
                                               score, and a reader deciding what
                                               to upgrade should not have to
                                               infer it from a category total. *@
                                            <span class="mono"
                                                  style="@(dep.IsStale ? "color: var(--color-high)" : "color: var(--color-neutral-500)")"
                                                  title="@Behind(dep)">@Age(behind)</span>
                                        }
                                        @if (dep.WorstSeverity is { } worst)
                                        {
                                            <SeverityBadge Severity="worst" />
                                            <span class="num">@dep.VulnerabilityCount</span>
                                        }
                                    </span>
                                </Badge>
                            </TreeRow>
                        </Virtualize>
                    }
                }
            }
            else if (Spine == Spines.Coverage)
            {
                @if (_coverage.Count == 0)
                {
                    <div class="card-body">
                        <p class="muted">No coverage recorded on this build.</p>
                        <p class="field__help">
                            Zero coverage and no coverage report are different states, and this is the
                            second — the scan receipts on the project hub say which ran.
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var module in _coverage)
                    {
                        <TreeRow Name="@($"{module.Module} · {module.Percent:0.#}%")" Group="true" />
                        <Virtualize TItem="CoverageLeaf" Items="module.Files" Context="file" ItemSize="26">
                            <TreeRow Name="@file.Path" Depth="1"
                                     Selected="@(file.Path == Selection)"
                                     OnSelect="() => Select(file.Path)">
                                <Badge>
                                    <span class="num" style="@PercentStyle(file.Percent)">@file.Percent.ToString("0.#")%</span>
                                </Badge>
                            </TreeRow>
                        </Virtualize>
                    }
                }
            }
            else if (Spine == Spines.Tests)
            {
                @if (_tests.Count == 0)
                {
                    <div class="card-body">
                        <p class="muted">No test results recorded on this build.</p>
                        <p class="field__help">
                            A build with no ingested test run has not been shown to pass anything.
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var assembly in _tests)
                    {
                        <TreeRow Name="@assembly.Assembly" Group="true" />
                        <Virtualize TItem="TestLeaf" Items="assembly.Suites" Context="suite" ItemSize="26">
                            <TreeRow Name="@suite.ClassName" Depth="1"
                                     Selected="@(suite.ClassName == Selection)"
                                     OnSelect="() => Select(suite.ClassName)">
                                <Badge>
                                    <span class="row" style="gap: var(--space-1)">
                                        @if (suite.Failed > 0)
                                        {
                                            <span class="num" style="color: var(--color-critical)">@suite.Failed ✕</span>
                                        }
                                        @if (suite.Skipped > 0)
                                        {
                                            <span class="num" style="color: var(--color-high)">@suite.Skipped ⃝</span>
                                        }
                                        <span class="num muted">@suite.Total</span>
                                    </span>
                                </Badge>
                            </TreeRow>
                        </Virtualize>
                    }
                }
            }
            else if (ByRule)
            {
                @if (_rules.Count == 0)
                {
                    <div class="card-body">
                        <p class="muted">No open findings on this build.</p>
                        <p class="field__help">
                            If no @Spine scanner ran, that is not the same as a clean result — check the
                            scan receipts on the project hub.
                        </p>
                    </div>
                }
                else
                {
                    <Virtualize TItem="RuleRow" Items="_rules" Context="rule" ItemSize="26">
                        <TreeRow Name="@rule.RuleId" Depth="0"
                                 Selected="@(rule.RuleId == Selection)"
                                 OnSelect="() => SelectRule(rule.RuleId)">
                            <Badge>
                                <span class="row" style="gap: var(--space-1)">
                                    <SeverityBadge Severity="rule.WorstSeverity" />
                                    <span class="num">@rule.Count</span>
                                    @if (rule.Concentrated && rule.Count > 1)
                                    {
                                        @* One bad pattern rather than a habit —
                                           a different fix, so it is worth
                                           seeing before opening the rule. *@
                                        <span class="muted" title="@($"{rule.TopFileCount} of {rule.Count} in one file")">◉</span>
                                    }
                                </span>
                            </Badge>
                        </TreeRow>
                    </Virtualize>
                }
            }
            else if (_groups.Count == 0)
            {
                <div class="card-body">
                    @* Distinguishing these two is the whole point of the
                       receipts card, and it applies here too: no findings and
                       no scan are not the same state. *@
                    <p class="muted">No open findings on this build.</p>
                    <p class="field__help">
                        If no @Spine scanner ran, that is not the same as a clean result — check the
                        scan receipts on the project hub.
                    </p>
                </div>
            }
            else
            {
                @foreach (var group in _groups)
                {
                    <TreeRow Name="@group.Name" Group="true" />
                    @* Virtualize: a large ingest runs to thousands of leaves,
                       and rendering them all over a SignalR circuit stalls the
                       page (TFND-86). *@
                    <Virtualize TItem="FindingLeaf" Items="group.Files" Context="leaf" ItemSize="26">
                        <TreeRow Name="@leaf.Path" Depth="1"
                                 Selected="@(leaf.Path == Selection)"
                                 OnSelect="() => Select(leaf.Path)">
                            <Badge>
                                <span class="row" style="gap: var(--space-1)">
                                    <SeverityBadge Severity="leaf.WorstSeverity" />
                                    <span class="num">@leaf.Count</span>
                                </span>
                            </Badge>
                        </TreeRow>
                    </Virtualize>
                }
            }
        </Tree>

        <Detail>
            @if (_error is not null)
            {
                <div class="card-body">
                    <p class="field__help">
                        Nothing is shown here rather than an empty result. A screen whose job is to
                        report posture must never imply a clean one it could not measure.
                    </p>
                </div>
            }
            else if (ByRule)
            {
                <div class="card-body">
                    <h2 class="mono">@Selection</h2>
                    @if (_rules.FirstOrDefault(r => r.RuleId == Selection) is { } rule)
                    {
                        <p>@rule.Title</p>
                        <p class="muted">
                            @rule.Count occurrence@(rule.Count == 1 ? "" : "s")
                            across @rule.FileCount file@(rule.FileCount == 1 ? "" : "s") · @rule.Scanner
                        </p>
                        @if (rule.Concentrated && rule.Count > 1 && rule.TopFilePath is { } top)
                        {
                            <p class="field__help">
                                @rule.TopFileCount of @rule.Count are in <code class="mono">@top</code>.
                                A rule concentrated in one file is usually one bad pattern to correct
                                once; the same count spread across the codebase is a habit, and that is
                                a different conversation.
                            </p>
                        }
                    }
                </div>

                <ScrollBox Label="Occurrences">
                    <table class="table">
                        <thead>
                            <tr><th>Severity</th><th>Where</th><th class="align-end">Line</th><th>Finding</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var finding in _ruleDetail)
                            {
                                <tr>
                                    <td><SeverityBadge Severity="finding.Severity" /></td>
                                    <td class="mono">
                                        @if (finding.FilePath is { Length: > 0 } path)
                                        {
                                            @* Straight to the file, at the line —
                                               the drill-through this ticket asked
                                               for, in the direction people
                                               actually travel. *@
                                            <a href="@Routes.Explorer(Client, Project, Sha, Spine, path, finding.Line)">@path</a>
                                        }
                                        else
                                        {
                                            <span class="muted">no file</span>
                                        }
                                    </td>
                                    <td class="num align-end">@(finding.Line?.ToString() ?? "—")</td>
                                    <td>@finding.Title</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </ScrollBox>
            }
            else if (Spine == Spines.Dast)
            {
                <div class="card-body">
                    <h2 class="mono">@Selection</h2>
                    <p class="muted">@_dastDetail.Count finding@(_dastDetail.Count == 1 ? "" : "s") on this route</p>
                </div>
                <DastDetail Findings="_dastDetail" />
            }
            else if (Spine == Spines.Accessibility)
            {
                <div class="card-body">
                    <h2 class="mono">@Selection</h2>
                    <p class="muted">
                        @_a11yDetail.Count violation@(_a11yDetail.Count == 1 ? "" : "s") on this page
                    </p>
                </div>
                <DastDetail Findings="_a11yDetail" />
            }
            else if (Spine == Spines.Sbom)
            {
                <div class="card-body">
                    <h2 class="mono">@Selection</h2>
                    <p class="muted">
                        @_sbomDetail.Count known vulnerabilit@(_sbomDetail.Count == 1 ? "y" : "ies")
                    </p>
                </div>
                <DependencyPathView Paths="_sbomPaths" />
                <SbomDetail Vulnerabilities="_sbomDetail" Client="@Client" Project="@Project"
                            Purl="@(Selection ?? "")" />
            }
            else if (Spine == Spines.Coverage)
            {
                <div class="card-body">
                    <h2 class="mono">@Selection</h2>
                </div>
                @if (_coverageDetail is { } map && _coverageSource is { Count: > 0 })
                {
                    <SourceViewer Lines="_coverageSource" Covered="map.Visited" Uncovered="map.Unvisited" />
                    <div class="card-body">
                        <p class="field__help">
                            @map.Visited.Count of @(map.Visited.Count + map.Unvisited.Count) executable
                            lines were visited. Lines with no mark are not executable — comments, blanks
                            and declarations — and counting them either way would misstate the number.
                        </p>
                    </div>
                }
                else
                {
                    <div class="card-body">
                        <p class="muted">No source stored for this file.</p>
                    </div>
                }
            }
            else if (Spine == Spines.Tests)
            {
                <div class="card-body">
                    <h2 class="mono">@Selection</h2>
                    <p class="muted">@_testsDetail.Count case@(_testsDetail.Count == 1 ? "" : "s")</p>
                </div>
                <TestsDetail Cases="_testsDetail" />
            }
            else
            {
            <div class="card-body">
                <h2 class="mono">@Selection</h2>
                <p class="muted">@_detail.Count finding@(_detail.Count == 1 ? "" : "s") on this build</p>
            </div>

            @if (_source is { Count: > 0 })
            {
                <SourceViewer Lines="_source" Flagged="_flagged" />
                <div class="card-body">
                    <p class="field__help">
                        Source at build @Sha, from the coverage report that measured this file.
                    </p>
                </div>
            }
            else
            {
                <div class="card-body">
                    <p class="field__help">
                        No source is stored for this file. tamp.findings keeps full file content only
                        when a coverage report is ingested over it, so the viewer appears for
                        SAST-flagged files exactly when coverage also ran. The findings themselves are
                        below.
                    </p>
                </div>
            }
            <ScrollBox Label="Findings">
                <table class="table">
                    <thead>
                        <tr><th>Severity</th><th>Rule</th><th>Finding</th><th class="align-end">Line</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var finding in _detail)
                        {
                            <tr>
                                <td><SeverityBadge Severity="finding.Severity" /></td>
                                <td class="mono">@finding.RuleId</td>
                                <td>
                                    <div>@finding.Title</div>
                                    @if (finding.Description is { Length: > 0 } description)
                                    {
                                        <div class="muted" style="font-size: var(--text-secondary)">@description</div>
                                    }
                                </td>
                                <td class="num align-end">@(finding.Line?.ToString() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </ScrollBox>
            }
        </Detail>
    </ExplorerShell>
}

@code {
    [Parameter] public string Client { get; set; } = "";
    [Parameter] public string Project { get; set; } = "";
    [Parameter] public string Sha { get; set; } = "";
    [Parameter] public string Spine { get; set; } = "";
    [Parameter] public string? Selection { get; set; }

    /// <summary>
    /// "rule" groups the tree by rule id instead of by path (TFND-18).
    ///
    /// A query parameter rather than a stored preference: it belongs to the
    /// question being asked, not to the reader, and it has to survive being
    /// pasted into a chat window.
    /// </summary>
    [SupplyParameterFromQuery(Name = "group")] public string? Group { get; set; }

    private static readonly string KnownSpines = string.Join(", ", Spines.All);

    private ProjectRef? _project;
    private IReadOnlyList<FindingGroup> _groups = [];
    private IReadOnlyList<FindingDetail> _detail = [];
    private DastTree? _dast;
    private DastTree? _a11y;
    private IReadOnlyList<DastFinding> _a11yDetail = [];
    private IReadOnlyList<DastFinding> _dastDetail = [];
    private IReadOnlyList<SbomGroup> _sbom = [];
    private IReadOnlyList<SbomVulnerability> _sbomDetail = [];
    private DependencyPaths _sbomPaths = DependencyPaths.None;
    private IReadOnlyList<CoverageGroup> _coverage = [];
    private CoverageLineMap? _coverageDetail;
    private List<SourceLine>? _coverageSource;
    private List<RuleRow> _rules = [];
    private IReadOnlyList<RuleFinding> _ruleDetail = [];
    private IReadOnlyList<TestGroup> _tests = [];
    private IReadOnlyList<TestCase> _testsDetail = [];
    private List<SourceLine>? _source;
    private IReadOnlyDictionary<int, Severity> _flagged = new Dictionary<int, Severity>();
    private string? _error;

    private string SpineTitle => Spine switch
    {
        Spines.Sast => "Findings",
        Spines.Dast => "Dynamic scan",
        Spines.Sbom => "SBOM",
        Spines.Coverage => "Coverage",
        Spines.Tests => "Tests",
        Spines.Accessibility => "Accessibility",
        _ => Spine,
    };

    private string SpineSubTitle => Spine switch
    {
        Spines.Sast => "Static analysis findings, grouped by path.",
        Spines.Dast => "What a scanner found against a running deployment.",
        Spines.Sbom => "Dependencies and their known vulnerabilities.",
        Spines.Coverage => "What the tests actually executed.",
        Spines.Tests => "Cases, outcomes and skip reasons.",
        Spines.Accessibility => "Section 508 / WCAG 2.1 AA conformance, by page.",
        _ => "",
    };

    /// <summary>
    /// The sha as the QUERIES want it: null for "whatever is newest".
    ///
    /// The sentinel must never reach a query — it would be treated as a commit
    /// prefix and match nothing, which renders as a clean screen rather than as
    /// the bug it is.
    /// </summary>
    private string? BuildSha =>
        string.Equals(Sha, Routes.LatestBuild, StringComparison.OrdinalIgnoreCase) ? null : Sha;

    // A coverage number is a fact, but a reader still wants to know at a glance
    // whether it is a good one. The thresholds match the coverage gate's own
    // defaults so the colour never disagrees with the gate.
    /// <summary>
    /// How far behind, in the coarsest unit that is still true. "14mo behind"
    /// reads; "426d behind" makes the reader do arithmetic.
    /// </summary>
    private static string Age(int days) => days switch
    {
        >= 365 => $"{days / 365}y behind",
        >= 60 => $"{days / 30}mo behind",
        _ => $"{days}d behind",
    };

    private static string Behind(SbomLeaf dep) =>
        dep.LatestVersion is { Length: > 0 } latest
            ? $"{dep.Version} shipped; {latest} is current, released {dep.StaleDays} days later"
            : $"{dep.StaleDays} days behind the newest release";

    private static string PercentStyle(double percent) => percent switch
    {
        >= 80 => "color: var(--color-pass)",
        >= 50 => "color: var(--color-high)",
        _ => "color: var(--color-critical)",
    };

    /// <summary>Only the finding spines have rules to group by.</summary>
    private bool ByRule =>
        string.Equals(Group, "rule", StringComparison.OrdinalIgnoreCase)
        && Spine is Spines.Sast or Spines.Dast;

    private void SelectRule(string ruleId) =>
        Nav.NavigateTo($"{Routes.Explorer(Client, Project, Sha, Spine, ruleId)}?group=rule");

    private void GoToSast() => Nav.NavigateTo(Routes.Explorer(Client, Project, Sha, Spines.Sast));

    private void Select(string path) =>
        Nav.NavigateTo(Routes.Explorer(Client, Project, Sha, Spine, path));

    private async Task Reload() => await OnParametersSetAsync();

    protected override async Task OnParametersSetAsync()
    {
        Scope.SetProject(Client, Project, Sha);
        Scope.SetExplorer(Spine, Selection);

        if (!Spines.IsValid(Spine)) return;

        _error = null;
        try
        {
            _project = await Hub.ResolveAsync(Client, Project, await Me.VisibleAsync());
            if (_project is null) return;

            if (ByRule)
            {
                // Static, not Sast: TFND-33 … TFND-37 wired five design-analysis
                // scanners that belonged to no set and were therefore ingested
                // and then invisible. A reader asking "what did the analysis
                // find in this file" wants both kinds, and splitting them
                // across two screens would mean checking two screens.
                var scanners = Spine == Spines.Dast ? ScannerKinds.Dast : ScannerKinds.Static;

                _rules = (await Rules.ByRuleAsync(_project.ProjectId, BuildSha, scanners)).ToList();
                _ruleDetail = Selection is null
                    ? []
                    : await Findings.ByRuleDetailAsync(_project.ProjectId, BuildSha, scanners, Selection);
            }
            else if (Spine == Spines.Sast)
            {
                _groups = await Findings.TreeAsync(_project.ProjectId, BuildSha, ScannerKinds.Static);
                _detail = Selection is null
                    ? []
                    : await Findings.DetailAsync(_project.ProjectId, BuildSha, ScannerKinds.Static, Selection);

                _source = null;
                _flagged = new Dictionary<int, Severity>();

                if (Selection is not null)
                {
                    var text = await Findings.SourceAsync(_project.ProjectId, Selection);
                    if (text is { Length: > 0 })
                    {
                        _source = SourceTokenizer.Tokenize(text, Selection);

                        // Worst severity wins when several findings land on one
                        // line: the mark has to say how bad the line is, not
                        // which finding was loaded first.
                        _flagged = _detail
                            .Where(f => f.Line is > 0)
                            .GroupBy(f => f.Line!.Value)
                            .ToDictionary(g => g.Key, g => g.Max(f => f.Severity));
                    }
                }
            }
            else if (Spine == Spines.Dast)
            {
                _dast = await Dast.TreeAsync(_project.ProjectId, BuildSha);
                _dastDetail = Selection is null
                    ? []
                    : await Dast.DetailAsync(_project.ProjectId, BuildSha, Selection);
            }
            else if (Spine == Spines.Accessibility)
            {
                // The DAST query, pointed at the accessibility scanners. Both
                // report against a URL, so the grouping and the evidence panels
                // are already right — what differs is the audience, which is
                // why this is its own spine rather than a filter on that one.
                _a11y = await Dast.TreeAsync(_project.ProjectId, BuildSha, ScannerKinds.Accessibility);
                _a11yDetail = Selection is null
                    ? []
                    : await Dast.DetailAsync(
                        _project.ProjectId, BuildSha, Selection, ScannerKinds.Accessibility);
            }
            else if (Spine == Spines.Sbom)
            {
                _sbom = await Sbom.TreeAsync(_project.ProjectId, BuildSha);
                _sbomDetail = Selection is null
                    ? []
                    : await Sbom.DetailAsync(_project.ProjectId, BuildSha, Selection);
                // TFND-7 (F6.2). Loaded alongside the vulnerabilities rather
                // than on demand: a reader who has opened a transitive package
                // is about to ask what pulled it in, and making them click
                // again to find out is making them ask twice.
                _sbomPaths = Selection is null
                    ? DependencyPaths.None
                    : await DepPaths.ForAsync(_project.ProjectId, BuildSha, Selection);
            }
            else if (Spine == Spines.Coverage)
            {
                _coverage = await CoverageAndTests.CoverageTreeAsync(_project.ProjectId, BuildSha);
                _coverageDetail = Selection is null
                    ? null
                    : await CoverageAndTests.CoverageDetailAsync(_project.ProjectId, BuildSha, Selection);
                _coverageSource = _coverageDetail is { SourceText.Length: > 0 }
                    ? SourceTokenizer.Tokenize(_coverageDetail.SourceText, Selection!)
                    : null;
            }
            else if (Spine == Spines.Tests)
            {
                _tests = await CoverageAndTests.TestTreeAsync(_project.ProjectId, BuildSha);
                _testsDetail = Selection is null
                    ? []
                    : await CoverageAndTests.TestDetailAsync(_project.ProjectId, BuildSha, Selection);
            }
            else
            {
                _groups = [];
                _detail = [];
            }
        }
        catch (Exception ex)
        {
            _error = ex.GetType().Name;
        }
    }
}
