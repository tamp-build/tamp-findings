@* Portfolio does NOT claim "/" while the React SPA still serves the root — an
   explicit Blazor route would shadow index.html. At cutover (TFND-128) add
   `@page "/"` here and update Routes.Portfolio. *@
@* TFND-128: the root belongs to Blazor now. Both routes are kept — /portfolio
   is in links, bookmarks and this repo's own docs, and breaking them to save a
   line would be a gratuitous 404. *@
@page "/"
@page "/portfolio"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RouteScope Scope
@* Named Query, not Portfolio: an injected member cannot share the
   component's own type name. *@
@inject PortfolioQuery Query
@inject NavigationManager Nav
@inject HierarchyService Hierarchy
@inject CurrentUser Me

<PageTitle>Portfolio — tamp.findings</PageTitle>

<div class="stack">
    <div class="row row--between">
        <div>
            <h1>Portfolio</h1>
            <p class="muted">Which project is worst right now.</p>
        </div>
        <div class="row">
            @* The hand-off renders these but lists the create-hierarchy flow
               as not covered. Buttons with no destination read as broken, so
               they are wired here (TFND-85). *@
            <Button Disabled="@(!_canCreateClient.Allowed)" DisabledReason="@_canCreateClient.Reason"
                    OnClick="() => _newClient = true">New client</Button>
            <Button Variant="Button.ButtonVariant.Primary"
                    Disabled="@(!_canCreateProject.Allowed)" DisabledReason="@_canCreateProject.Reason"
                    OnClick="OpenNewProject">New project</Button>
        </div>
    </div>

    @if (_loading)
    {
        <p class="muted">Loading…</p>
    }
    else if (_error is not null)
    {
        <Card>
            <div class="row">
                <Chip Label="Unavailable" Tone="var(--color-high)" Style="Chip.ChipStyle.Solid" Glyph="!" />
                <span>Could not load the portfolio.</span>
            </div>
            <p class="field__help">Posture is unknown, not clean. @_error</p>
        </Card>
    }
    else if (_rows.Count == 0)
    {
        <Card>
            <p class="muted">No projects yet.</p>
        </Card>
    }
    else
    {
        <Card Padded="false">
            <ScrollBox Label="Portfolio">
                <table class="table table--rows">
                    <thead>
                        <tr>
                            <th>Project</th><th>Client</th><th class="align-end">Score</th>
                            <th>Band</th><th>Ship</th><th>Blocking</th><th>Last build</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr @onclick="() => Open(row)">
                                <td style="font-family: var(--font-heading); font-weight: 600; font-size: var(--text-emphasis)">
                                    @row.ProjectName
                                </td>
                                <td>
                                    @* The client tier is navigable from here,
                                       which is what stops it being a gap in a
                                       hierarchy the product calls load-bearing.
                                       stopPropagation: the row itself opens the
                                       project. *@
                                    <a href="@Routes.Client(row.ClientName)"
                                       @onclick:stopPropagation="true">@row.ClientName</a>
                                </td>
                                <td class="num align-end">@(row.Score?.ToString("F1") ?? "—")</td>
                                <td>
                                    @if (row.Band is { } band)
                                    {
                                        @* The band name is always written out — never
                                           colour alone. *@
                                        <Chip Label="@band" Tone="@BandTone(band)" />
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>
                                    @switch (row.Ship)
                                    {
                                        case ShipState.Blocked:
                                            <Chip Label="Blocked" Tone="var(--color-critical)"
                                                  Style="Chip.ChipStyle.Solid" Glyph="✕" />
                                            break;
                                        case ShipState.NoScan:
                                            <Chip Label="No scan" Tone="var(--color-medium)"
                                                  Style="Chip.ChipStyle.Dashed" Glyph="?" />
                                            break;
                                        default:
                                            <Chip Label="Clear" Tone="var(--color-pass)" Glyph="✓" />
                                            break;
                                    }
                                </td>
                                <td class="portfolio__blocking">
                                    @* Named in prose. "3 blocking" tells a security lead
                                       nothing they can act on. *@
                                    @(row.Blocking.Count == 0 ? "—" : string.Join("; ", row.Blocking))
                                </td>
                                <td class="mono">
                                    @if (row.LastBuild is { } at)
                                    {
                                        <span style="@(row.IsStale ? "color: var(--color-high)" : null)">
                                            @at.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="muted">never</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </ScrollBox>
        </Card>

        <p class="field__help">
            Ordered worst-posture-first. A project with a green score and no recent scan is not
            healthy, so staleness blocks alongside a failing gate.
        </p>
    }
</div>

<Dialog Open="_newClient" OpenChanged="v => _newClient = v" Title="New client" Width="560">
    <ChildContent>
        <TextField Label="Name" @bind-Value="_clientName"
                   Help="An organisation or customer. The top of the hierarchy — every project and component sits beneath one." />
        @if (_formError is not null)
        {
            <p style="color: var(--color-critical)">@_formError</p>
        }
    </ChildContent>
    <Footer>
        <Button Variant="Button.ButtonVariant.Primary" OnClick="CreateClient">Create client</Button>
        <Button OnClick="() => _newClient = false">Cancel</Button>
    </Footer>
</Dialog>

<Dialog Open="_newProject" OpenChanged="v => _newProject = v" Title="New project" Width="560">
    <ChildContent>
        @if (_clients.Count == 0)
        {
            <p>There are no clients yet. A project has to sit beneath one.</p>
        }
        else
        {
            <label class="field">
                <span class="field__label">Client</span>
                <select class="select" @bind="_selectedClientId">
                    @foreach (var c in _clients)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <span class="field__help">Project names are unique per client, not globally.</span>
            </label>
            <TextField Label="Name" @bind-Value="_projectName"
                       Help="A product. Owns its risk policy and acceptance gates." />
            <TextField Label="Description" @bind-Value="_projectDescription" Help="Optional." />
        }
        @if (_formError is not null)
        {
            <p style="color: var(--color-critical)">@_formError</p>
        }
    </ChildContent>
    <Footer>
        <Button Variant="Button.ButtonVariant.Primary" Disabled="@(_clients.Count == 0)"
                DisabledReason="Create a client first." OnClick="CreateProject">Create project</Button>
        <Button OnClick="() => _newProject = false">Cancel</Button>
    </Footer>
</Dialog>

@code {
    private IReadOnlyList<PortfolioRow> _rows = [];
    private IReadOnlyList<ClientRow> _clients = [];
    private AuthorizationDecision _canCreateClient = AuthorizationDecision.Deny("Checking…");
    private AuthorizationDecision _canCreateProject = AuthorizationDecision.Deny("Checking…");
    private bool _newClient, _newProject;
    private string? _clientName, _projectName, _projectDescription, _formError;
    private Guid _selectedClientId;
    private bool _loading = true;
    private string? _error;

    private static string BandTone(string band) => band switch
    {
        "green" => "var(--color-band-green)",
        "yellow" => "var(--color-band-yellow)",
        "orange" => "var(--color-band-orange)",
        _ => "var(--color-band-red)",
    };

    private void Open(PortfolioRow row) =>
        Nav.NavigateTo(Routes.ProjectHub(row.ClientName, row.ProjectName));

    protected override async Task OnInitializedAsync()
    {
        Scope.Clear();
        try
        {
            _rows = await Query.LoadAsync(await Me.VisibleAsync());
        }
        catch (Exception ex)
        {
            // Same rule as the hub: a screen that reports posture must never
            // imply a clean one it could not measure.
            _error = ex.GetType().Name;
        }
        // Instance scope: a client sits above every project, so nothing
        // narrower can grant the right to create one.
        _canCreateClient = await Me.CanAsync(Capability.CreateProject, ScopeTarget.Instance);
        _canCreateProject = _canCreateClient;
        _loading = false;
    }

    private async Task OpenNewProject()
    {
        _formError = null;
        _clients = await Hierarchy.ClientsAsync();
        if (_clients.Count > 0 && _selectedClientId == Guid.Empty) _selectedClientId = _clients[0].Id;
        _newProject = true;
    }

    private async Task CreateClient()
    {
        _formError = null;
        var actor = await Me.AtAsync(ScopeTarget.Instance);
        if (actor is null) { _formError = "You are not signed in."; return; }

        var result = await Hierarchy.CreateClientAsync(actor, _clientName ?? "");
        if (!result.Success) { _formError = result.Error; return; }

        _newClient = false;
        _clientName = null;
        await Reload();
    }

    private async Task CreateProject()
    {
        _formError = null;
        var actor = await Me.AtAsync(ScopeTarget.Client(_selectedClientId));
        if (actor is null) { _formError = "You are not signed in."; return; }

        var result = await Hierarchy.CreateProjectAsync(
            actor, _selectedClientId, _projectName ?? "", _projectDescription);
        if (!result.Success) { _formError = result.Error; return; }

        _newProject = false;
        _projectName = _projectDescription = null;
        await Reload();
    }

    private async Task Reload()
    {
        try { _rows = await Query.LoadAsync(await Me.VisibleAsync()); }
        catch (Exception ex) { _error = ex.GetType().Name; }
    }
}
