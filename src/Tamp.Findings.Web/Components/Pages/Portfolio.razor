@page "/"
@page "/portfolio"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RouteScope Scope
@* Named Query, not Portfolio: an injected member cannot share the
   component's own type name. *@
@inject PortfolioQuery Query
@inject NavigationManager Nav
@inject HierarchyService Hierarchy
@using Tamp.Findings.Web.Services
@inject CurrentUser Me

<PageTitle>Portfolio — tamp.findings</PageTitle>

<div class="stack">
    <div class="row row--between">
        <div>
            <h1>Portfolio</h1>
            <p class="muted">Which project is worst right now.</p>
        </div>
        <div class="row">
            @* TFND-257: "New client" is back. The v3 design dropped it on the
               grounds that clients are managed under Manage — but no Manage
               screen ever grew the affordance, so a fresh instance had NO path
               to its first client: the New-project dialog said "create a client
               first" and offered no way to do it, and an operator was left
               POSTing /clients from a devtools console.

               Admin-only, because HierarchyService.CreateClientAsync requires
               Actor.Admin: a client sits above every project and nothing
               narrower can grant the right to make one. *@
            @if (_isAdmin)
            {
                <Button OnClick="OpenNewClient">New client</Button>
            }
            <Button Variant="Button.ButtonVariant.Primary"
                    Disabled="@(!_canCreateProject.Allowed)" DisabledReason="@_canCreateProject.Reason"
                    OnClick="OpenNewProject">New project</Button>
        </div>
    </div>

    @if (_loading)
    {
        <p class="muted">Loading…</p>
    }
    else if (_error is not null)
    {
        <Card>
            <div class="row">
                <Chip Label="Unavailable" Tone="var(--color-high)" Style="Chip.ChipStyle.Solid" Glyph="!" />
                <span>Could not load the portfolio.</span>
            </div>
            <p class="field__help">Posture is unknown, not clean. @_error</p>
        </Card>
    }
    else if (_rows.Count == 0)
    {
        <Card>
            <p class="muted">No projects yet.</p>
        </Card>
    }
    else
    {
        <div class="row row--between portfolio__filter">
            <label class="field field--inline">
                <span class="field__label">Client</span>
                <select class="select" @bind="_clientFilter" @bind:after="StateHasChanged">
                    <option value="">All clients (@_clientCounts.Count)</option>
                    @foreach (var c in _clientCounts.OrderBy(c => c.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@c.Key">@c.Key (@c.Value)</option>
                    }
                </select>
            </label>
            <span class="field__help mono">
                @Filtered.Count of @_rows.Count projects · click a column to sort
            </span>
        </div>

        <Card Padded="false">
            <ScrollBox Label="Portfolio">
                <table class="table table--rows portfolio__table">
                    <thead>
                        <tr>
                            @SortHead(SortCol.Project, "Project")
                            @SortHead(SortCol.Client, "Client")
                            @SortHead(SortCol.Score, "Score", end: true)
                            <th>30-day trend</th>
                            @SortHead(SortCol.Band, "Band")
                            @SortHead(SortCol.Ship, "Ship")
                            <th>Blocking</th>
                            @SortHead(SortCol.LastBuild, "Last build")
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Sorted)
                        {
                            <tr @onclick="() => Open(row)">
                                <td class="portfolio__project">@row.ProjectName</td>
                                <td>
                                    @* The client tier is navigable from here — it
                                       stops being a gap in a hierarchy the product
                                       calls load-bearing. stopPropagation: the row
                                       itself opens the project. *@
                                    <a href="@Routes.Client(row.ClientName)"
                                       @onclick:stopPropagation="true">@row.ClientName</a>
                                </td>
                                <td class="align-end">
                                    @if (row.Score is { } s)
                                    {
                                        <span class="portfolio__score" style="color: @BandColor(row.Band)">@s.ToString("F1")</span>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>
                                    @{ var t = TrendOf(row); }
                                    <div class="portfolio__trend" title="@t.Title">
                                        <Sparkline Points="row.Trend" Color="@t.Color" AriaLabel="@t.Title" />
                                        <span class="mono portfolio__delta" style="color: @t.Color">@t.Text</span>
                                    </div>
                                </td>
                                <td>
                                    @if (row.Band is { } band)
                                    {
                                        @* The band name is always written — never colour alone. *@
                                        <Chip Label="@band" Tone="@BandColor(band)" />
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>
                                    @switch (row.Ship)
                                    {
                                        case ShipState.Blocked:
                                            <Chip Label="Blocked" Tone="var(--color-critical)"
                                                  Style="Chip.ChipStyle.Solid" Glyph="✕" />
                                            break;
                                        case ShipState.NoScan:
                                            <Chip Label="No scan" Tone="var(--color-medium)"
                                                  Style="Chip.ChipStyle.Dashed" Glyph="?" />
                                            break;
                                        default:
                                            <Chip Label="Clear" Tone="var(--color-pass)" Glyph="✓" />
                                            break;
                                    }
                                </td>
                                <td class="portfolio__blocking">
                                    @* One blocker per line, named in prose. "3 blocking"
                                       tells a security lead nothing they can act on. *@
                                    @if (row.Blocking.Count == 0)
                                    {
                                        <span class="muted">—</span>
                                    }
                                    else
                                    {
                                        @foreach (var b in row.Blocking)
                                        {
                                            <div class="portfolio__blocker">@b</div>
                                        }
                                    }
                                </td>
                                <td class="mono">
                                    @if (row.LastBuild is { } at)
                                    {
                                        <span style="@(row.IsStale ? "color: var(--color-high)" : null)">
                                            @at.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="muted">never</span>
                                    }
                                </td>
                                <td class="align-end portfolio__actions">
                                    <span class="portfolio__open" aria-hidden="true">→</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </ScrollBox>
        </Card>

        <p class="field__help">
            Lower is better. A project with a green score and no recent scan is not healthy, so
            staleness blocks alongside a failing gate.
        </p>
    }
</div>

<Dialog Open="_newProject" OpenChanged="v => _newProject = v" Title="New project" Width="560">
    <ChildContent>
        @if (_clients.Count == 0)
        {
            <p>There are no clients yet. A project has to sit beneath one.</p>
            @if (_isAdmin)
            {
                @* The fix for TFND-257 at the exact point the wall was hit: name
                   the prerequisite AND offer the route to it, rather than naming
                   it and disabling the only button. *@
                <TextField Label="Client name" @bind-Value="_clientName"
                           Help="A customer or a tenant. Projects sit beneath it." />
                <Button Variant="Button.ButtonVariant.Primary" OnClick="CreateClientInline">
                    Create client
                </Button>
            }
            else
            {
                <p class="muted">
                    Creating a client needs an administrator. Ask one to add it, then this
                    dialog will let you create the project.
                </p>
            }
        }
        else
        {
            <label class="field">
                <span class="field__label">Client</span>
                <select class="select" @bind="_selectedClientId">
                    @foreach (var c in _clients)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <span class="field__help">Project names are unique per client, not globally.</span>
            </label>
            <TextField Label="Name" @bind-Value="_projectName"
                       Help="A product. Owns its risk policy and acceptance gates." />
            <TextField Label="Description" @bind-Value="_projectDescription" Help="Optional." />
        }
        @if (_formError is not null)
        {
            <p style="color: var(--color-critical)">@_formError</p>
        }
    </ChildContent>
    <Footer>
        <Button Variant="Button.ButtonVariant.Primary" Disabled="@(_clients.Count == 0)"
                DisabledReason="Create a client first." OnClick="CreateProject">Create project</Button>
        <Button OnClick="() => _newProject = false">Cancel</Button>
    </Footer>
</Dialog>

<Dialog Open="_newClient" OpenChanged="v => _newClient = v" Title="New client" Width="480">
    <ChildContent>
        <TextField Label="Name" @bind-Value="_clientName"
                   Help="A customer or a tenant. Unique across the instance; projects sit beneath it." />
        @if (_clientError is not null)
        {
            <p style="color: var(--color-critical)">@_clientError</p>
        }
    </ChildContent>
    <Footer>
        <Button Variant="Button.ButtonVariant.Primary" OnClick="CreateClient">Create client</Button>
        <Button OnClick="() => _newClient = false">Cancel</Button>
    </Footer>
</Dialog>

@code {
    private enum SortCol { Project, Client, Score, Band, Ship, LastBuild }

    private IReadOnlyList<PortfolioRow> _rows = [];
    private IReadOnlyList<ClientRow> _clients = [];
    private Dictionary<string, int> _clientCounts = new(StringComparer.OrdinalIgnoreCase);
    private AuthorizationDecision _canCreateProject = AuthorizationDecision.Deny("Checking…");
    private bool _newProject;
    private string? _projectName, _projectDescription, _formError;
    private string? _clientName, _clientError;
    private bool _newClient;

    // Creating a client is an Actor.Admin check in HierarchyService rather than
    // a capability, so it is asked as one — CanAsync would be answering a
    // different question.
    private bool _isAdmin;
    private Guid _selectedClientId;
    private bool _loading = true;
    private string? _error;

    // v3 default sort: Client ascending, ties by name.
    private string _clientFilter = "";
    private SortCol _sortCol = SortCol.Client;
    private bool _sortAsc = true;

    private IReadOnlyList<PortfolioRow> Filtered =>
        string.IsNullOrEmpty(_clientFilter)
            ? _rows
            : _rows.Where(r => string.Equals(r.ClientName, _clientFilter, StringComparison.OrdinalIgnoreCase)).ToArray();

    private IReadOnlyList<PortfolioRow> Sorted
    {
        get
        {
            var rows = Filtered;
            IOrderedEnumerable<PortfolioRow> ordered = _sortCol switch
            {
                SortCol.Project    => By(rows, r => r.ProjectName, StringComparer.OrdinalIgnoreCase),
                SortCol.Client     => By(rows, r => r.ClientName, StringComparer.OrdinalIgnoreCase),
                SortCol.Score      => By(rows, r => r.Score ?? double.NegativeInfinity),
                SortCol.Band       => By(rows, r => BandRank(r.Band)),
                SortCol.Ship       => By(rows, r => ShipRank(r.Ship)),
                SortCol.LastBuild  => By(rows, r => r.LastBuild ?? DateTimeOffset.MinValue),
                _                  => By(rows, r => r.ClientName, StringComparer.OrdinalIgnoreCase),
            };
            // Deterministic tie-break (v3: ties by name), always ascending.
            return ordered.ThenBy(r => r.ProjectName, StringComparer.OrdinalIgnoreCase).ToArray();
        }
    }

    private IOrderedEnumerable<PortfolioRow> By<TKey>(
        IEnumerable<PortfolioRow> rows, Func<PortfolioRow, TKey> key, IComparer<TKey>? cmp = null) =>
        _sortAsc ? rows.OrderBy(key, cmp) : rows.OrderByDescending(key, cmp);

    private RenderFragment SortHead(SortCol col, string label, bool end = false) => builder =>
    {
        var active = _sortCol == col;
        builder.OpenElement(0, "th");
        builder.AddAttribute(1, "class", $"sortable{(end ? " align-end" : "")}{(active ? " sortable--active" : "")}");
        builder.AddAttribute(2, "role", "button");
        builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => Sort(col)));
        builder.AddContent(4, label);
        if (active)
        {
            builder.OpenElement(5, "span");
            builder.AddAttribute(6, "class", "sortable__caret");
            builder.AddContent(7, _sortAsc ? " ▲" : " ▼");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private void Sort(SortCol col)
    {
        if (_sortCol == col) { _sortAsc = !_sortAsc; }
        else { _sortCol = col; _sortAsc = true; }
    }

    private static int BandRank(string? band) => band switch
    {
        "green" => 0, "yellow" => 1, "orange" => 2, "red" => 3, _ => 4,
    };

    // Worst-first ranking: a project nobody has scanned outranks a merely bad one.
    private static int ShipRank(ShipState s) => s switch
    {
        ShipState.Clear => 0, ShipState.Blocked => 1, ShipState.NoScan => 2, _ => 3,
    };

    private static string BandColor(string? band) => band switch
    {
        "green" => "var(--color-band-green)",
        "yellow" => "var(--color-band-yellow)",
        "orange" => "var(--color-band-orange)",
        "red" => "var(--color-band-red)",
        _ => "var(--color-neutral-600)",
    };

    private readonly record struct Trend(string Color, string Text, string Title);

    // Lower is better: a negative delta is an improvement (▼ green); positive is
    // worsening (▲ red); no delta or fewer than two builds is flat (— grey).
    private static Trend TrendOf(PortfolioRow row)
    {
        if (row.TrendDelta is not { } d || Math.Abs(d) < 0.05)
        {
            var flat = row.Trend.Count < 2 ? "— no scans" : "— flat";
            return new Trend("var(--color-neutral-600)", flat, "30 days: flat");
        }

        var improving = d < 0;
        var color = improving ? "var(--color-band-green)" : "var(--color-band-red)";
        var arrow = improving ? "▼" : "▲";
        var text = $"{arrow} {(d > 0 ? "+" : "−")}{Math.Abs(d):F1}";
        var title = $"30 days: {row.Trend[0]:F1} → {row.Trend[^1]:F1} ({(improving ? "improving" : "worsening")})";
        return new Trend(color, text, title);
    }

    private void Open(PortfolioRow row) =>
        Nav.NavigateTo(Routes.ProjectHub(row.ClientName, row.ProjectName));

    protected override async Task OnInitializedAsync()
    {
        Scope.Clear();

        // Authorisation FIRST, then the roll-up (TFND-261).
        //
        // The header's actions are rendered outside the _loading block, as though they
        // do not depend on the table — but _isAdmin used to be resolved after the
        // roll-up, so they did. On an instance admin the roll-up loads every project
        // there is, and the buttons were hostage to it: a slow table meant no "New
        // client" button, which is the one thing a new instance needs most.
        //
        // These two calls are a single row read each. Doing them before the await on
        // the roll-up means Blazor's render after that await already knows whether to
        // offer the actions, so the header fills immediately and the table says
        // "Loading…" under it.
        //
        // Instance scope: a client sits above every project, so nothing narrower can
        // grant the right to create one.
        _canCreateProject = await Me.CanAsync(Capability.CreateProject, ScopeTarget.Instance);
        _isAdmin = ClientCreation.MayCreate(await Me.AtAsync(ScopeTarget.Instance));
        StateHasChanged();

        try
        {
            _rows = await Query.LoadAsync(await Me.VisibleAsync());
            _clientCounts = _rows
                .GroupBy(r => r.ClientName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.Count(), StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            // Same rule as the hub: a screen that reports posture must never
            // imply a clean one it could not measure.
            _error = ex.GetType().Name;
        }
        _loading = false;
    }

    private void OpenNewClient()
    {
        (_clientError, _clientName, _newClient) = (null, null, true);
    }

    // Both entry points run the same orchestration (ClientCreation), then do
    // the one thing that differs: the dialog closes and reloads, the inline one
    // stays put and selects what was just made.
    private async Task<Guid?> CreateClientCoreAsync()
    {
        var (id, error) = await ClientCreation.CreateAsync(
            await Me.AtAsync(ScopeTarget.Instance), Hierarchy, _clientName);

        _clientError = error;
        if (id is null) return null;

        _clients = await Hierarchy.ClientsAsync();
        _clientName = null;
        return id;
    }

    private async Task CreateClient()
    {
        if (await CreateClientCoreAsync() is null) return;
        _newClient = false;
        await Reload();
    }

    private async Task CreateClientInline()
    {
        if (await CreateClientCoreAsync() is not { } id) { _formError = _clientError; return; }
        (_selectedClientId, _formError) = (id, null);
    }

    private async Task OpenNewProject()
    {
        _formError = null;
        _clients = await Hierarchy.ClientsAsync();
        if (_clients.Count > 0 && _selectedClientId == Guid.Empty) _selectedClientId = _clients[0].Id;
        _newProject = true;
    }

    private async Task CreateProject()
    {
        _formError = null;
        var actor = await Me.AtAsync(ScopeTarget.Client(_selectedClientId));
        if (actor is null) { _formError = "You are not signed in."; return; }

        var result = await Hierarchy.CreateProjectAsync(
            actor, _selectedClientId, _projectName ?? "", _projectDescription);
        if (!result.Success) { _formError = result.Error; return; }

        _newProject = false;
        _projectName = _projectDescription = null;
        await Reload();
    }

    private async Task Reload()
    {
        try
        {
            _rows = await Query.LoadAsync(await Me.VisibleAsync());
            _clientCounts = _rows
                .GroupBy(r => r.ClientName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.Count(), StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex) { _error = ex.GetType().Name; }
    }
}
