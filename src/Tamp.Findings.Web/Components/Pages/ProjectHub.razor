@page "/c/{Client}/p/{Project}/build/{Sha}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RouteScope Scope
@inject ProjectHubQuery Hub
@inject Tamp.Findings.Application.Poam.PoamQuery Poam
@inject Tamp.Findings.Application.Attestation.SsdfAttestationBuilder Ssdf
@inject CurrentUser Me
@inject IServiceScopeFactory Scopes
@inject Tamp.Findings.Application.Projects.BuildUpdateNotifier Updates
@implements IDisposable
@using Tamp.Findings.Domain.Risk
@using Microsoft.Extensions.DependencyInjection

<PageTitle>@Project — tamp.findings</PageTitle>

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_error is not null)
{
    @* The database is unreachable. Say so LOUDLY rather than rendering an
       empty hub — a screen whose job is to report posture must never imply a
       clean one it could not measure. This is the same principle as "a missing
       scan is not a clean scan", applied to the reader's own connection. *@
    <div class="stack">
        <h1>@Project</h1>
        <Card>
            <div class="row">
                <Chip Label="Unavailable" Tone="var(--color-high)" Style="Chip.ChipStyle.Solid" Glyph="!" />
                <span>Could not load this project's posture.</span>
            </div>
            <p class="field__help">
                The score and gates are unknown, not clean. @_error
            </p>
        </Card>
    </div>
}
else if (_project is null)
{
    <div class="stack">
        <h1>Project not found</h1>
        <Card>
            <p>No project matches <code class="mono">@Client / @Project</code>.</p>
        </Card>
    </div>
}
else if (_data is null)
{
    @* A registered-but-never-scanned project is a real and common state, and
       it must NOT render as a zero score. "A project with a green score and no
       recent scan is not healthy" — and a zero score would be worse still,
       implying something was measured. *@
    <div class="stack">
        <div>
            <h1>@_project.ProjectName</h1>
            <p class="muted">@_project.ClientName</p>
        </div>
        <Card>
            <div class="row">
                <Chip Label="No scan" Tone="var(--color-medium)" Style="Chip.ChipStyle.Dashed" Glyph="?" />
                <span>This project has no canonical build yet.</span>
            </div>
            <p class="field__help">
                Nothing has been ingested, so there is no score and no gate to evaluate.
                A missing scan is not a clean scan.
            </p>
        </Card>
    </div>
}
else
{
    <div class="stack">
        <div class="hubhead" style="border-left: 4px solid @BandColour">
            <div class="hubhead__id">
                <a class="hubhead__back" href="@Routes.Portfolio">← Portfolio</a>
                <h1>@_data.Project.ProjectName</h1>
                <p class="muted">
                    @_data.Project.ClientName@(_data.ComplianceBaseline is { Length: > 0 } bl ? $" · {bl}" : "") · policy @_data.PolicyName
                </p>
                @if (_newerSha is not null)
                {
                    <p class="muted"><a href="@Routes.ProjectHub(_data.Project.ClientName, _data.Project.ProjectName)">A newer build (<span class="mono">@(_newerSha.Length > 7 ? _newerSha[..7] : _newerSha)</span>) has landed — view latest</a></p>
                }
                <p class="muted hubhead__build">@(IsLatest ? "Latest build" : "Build"): <span class="mono">@ShortSha</span> · @_data.BuiltAt.ToString("yyyy-MM-dd HH:mm")</p>
            </div>
            <div class="hubhead__stats">
                <div class="statcard" style="--band: @BandColour">
                    <div class="statcard__label">Risk · @_data.Risk.Band</div>
                    <div class="statcard__value">@_data.Risk.Score.ToString("F1")%</div>
                </div>
                <div class="statcard" style="--band: @CoverageColour">
                    <div class="statcard__label">Coverage</div>
                    <div class="statcard__value">@CoverageValue</div>
                </div>
                <div class="statcard" style="--band: @TestsColour">
                    <div class="statcard__label">Tests passing</div>
                    <div class="statcard__value">
                        @if (_data.Inputs.TestsMeasured)
                        {
                            <text>@TestsPassed.ToString("N0")<span class="statcard__den"> / @TestsTotal.ToString("N0")</span></text>
                        }
                        else { <text>✕ No data</text> }
                    </div>
                </div>
                <div class="statcard statcard--wide" style="--band: @ShipColour">
                    <div class="statcard__label">Ship gate</div>
                    <div class="statcard__value">@(_data.Gates.ClearToShip ? "✓ Clear" : "✕ Blocked")</div>
                    @foreach (var reason in ShipReasons)
                    {
                        <div class="statcard__sub">@reason</div>
                    }
                </div>
            </div>
        </div>

        <div class="hubrow">
            <ScoreCard Data="_data" Sha="@Sha" />
            <GateRail Gates="_data.Gates" />
        </div>

        <div class="hubrow">
            <ProjectKeyCard Project="_data.Project" />
        </div>

        <EvidenceTiles Data="_data" PoamPastDue="_poamPastDue" Sha="@ShortSha" RouteSha="@Sha" />

        @if (_ssdf is not null)
        {
            <AttestationTiles Doc="_ssdf" />
        }

        <ScanReceipts Inputs="_data.Inputs" Sha="@ShortSha" />

        @* TFND-134. Below the receipts on purpose: it answers the same
           question they do — what do we actually know about this build — and
           "no image inspected" belongs next to the other never-ran states. *@
        <BaseImageCard Images="_data.Images" />

        @if (_data.History.Count > 0)
        {
            <BuildHistory Rows="_data.History" />
        }
    </div>
}

@code {
    [Parameter] public string Client { get; set; } = "";
    [Parameter] public string Project { get; set; } = "";
    [Parameter] public string Sha { get; set; } = "";

    private ProjectRef? _project;
    private ProjectHubData? _data;
    private int _poamPastDue;
    private Tamp.Findings.Application.Attestation.SsdfAttestationDoc? _ssdf;
    private bool _loading = true;
    private string? _error;

    // Seven characters is what the design's build stamp shows, and what a
    // reader can actually match against a git log.
    private string? ShortSha => _data?.CommitSha is { Length: > 7 } full ? full[..7] : _data?.CommitSha;

    // The four-metric summary — the SAME one the public badge renders (ProjectStatus.From), so the
    // header strip and the badge can never disagree on a value or a colour. The header just maps its
    // band slugs to CSS tokens; the "unmeasured is red / every blocking gate named" logic lives once.
    private Tamp.Findings.Application.Projects.ProjectStatus? _status;
    private static string Colour(string slug) => $"var(--color-band-{slug})";

    private string BandColour => Colour(_status?.RiskBand ?? "red");
    private string CoverageColour => Colour(_status!.CoverageBand);
    private string CoverageValue => _status!.CoverageMeasured
        ? _status.CoveragePercent.ToString("F1") + "%"
        : "✕ No data";
    private int TestsTotal => _status!.TestsTotal;
    private int TestsPassed => _status!.TestsPassed;
    private string TestsColour => Colour(_status!.TestsBand);
    private string ShipColour => Colour(_status!.ShipBand);
    private IReadOnlyList<string> ShipReasons => _status!.ShipReasons;

    private bool IsLatest => string.Equals(Sha, Routes.LatestBuild, StringComparison.OrdinalIgnoreCase);
    private string? _newerSha;
    private IDisposable? _sub;
    private Guid _subProject;

    public void Dispose() => _sub?.Dispose();

    private sealed record Loaded(ProjectHubData? Data, Tamp.Findings.Application.Projects.ProjectStatus? Status, int PoamPastDue,
        Tamp.Findings.Application.Attestation.SsdfAttestationDoc? Ssdf);

    // "latest" is a sentinel, not a commit prefix. Passing it through would filter for builds whose
    // sha starts with "latest", match nothing, and render a scanned project as never-scanned.
    private static async Task<Loaded> LoadAsync(ProjectHubQuery hub, Tamp.Findings.Application.Poam.PoamQuery poam,
        Tamp.Findings.Application.Attestation.SsdfAttestationBuilder ssdf, ProjectRef project, string? sha)
    {
        var data = await hub.LoadAsync(project, sha);
        if (data is null) return new Loaded(null, null, 0, null);
        var past = (await poam.BoardAsync(project.ProjectId, DateTimeOffset.UtcNow)).Stats.PastDue;
        var doc = await ssdf.BuildAsync(project.ProjectId, data.CommitSha);
        return new Loaded(data, Tamp.Findings.Application.Projects.ProjectStatus.From(data), past, doc);
    }

    // Ingest landed for this project: an unpinned view re-loads in place; a pinned one only learns
    // that a newer build exists. Own DI scope — the circuit's DbContext may be mid-query.
    private async Task OnBuildUpdated()
    {
        if (_project is null) return;
        await InvokeAsync(async () =>
        {
            try
            {
                using var scope = Scopes.CreateScope();
                var sp = scope.ServiceProvider;
                var hub = sp.GetRequiredService<ProjectHubQuery>();
                if (IsLatest)
                {
                    var l = await LoadAsync(hub, sp.GetRequiredService<Tamp.Findings.Application.Poam.PoamQuery>(),
                        sp.GetRequiredService<Tamp.Findings.Application.Attestation.SsdfAttestationBuilder>(), _project, null);
                    if (l.Data is null) return;
                    (_data, _status, _poamPastDue, _ssdf) = (l.Data, l.Status, l.PoamPastDue, l.Ssdf);
                }
                else
                {
                    var latest = await hub.LoadAsync(_project, null);
                    _newerSha = latest is not null && latest.CommitSha != _data?.CommitSha ? latest.CommitSha : null;
                }
                StateHasChanged();
            }
            catch { /* keep showing what we have; the next ingest or a refresh recovers */ }
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        Scope.SetProject(Client, Project, Sha);

        _loading = true;
        _error = null;
        _newerSha = null;
        try
        {
            _project = await Hub.ResolveAsync(Client, Project, await Me.VisibleAsync());
            if (_project is not null)
            {
                var l = await LoadAsync(Hub, Poam, Ssdf, _project, IsLatest ? null : Sha);
                (_data, _status, _poamPastDue, _ssdf) = (l.Data, l.Status, l.PoamPastDue, l.Ssdf);
                if (_subProject != _project.ProjectId)
                {
                    _sub?.Dispose();
                    _subProject = _project.ProjectId;
                    _sub = Updates.Subscribe(_subProject, OnBuildUpdated);
                }
            }
            else { _data = null; _status = null; _poamPastDue = 0; _ssdf = null; }
        }
        catch (Exception ex)
        {
            // Deliberately broad: any failure to reach the data — connection refused, timeout, a
            // migration mid-flight — reads the same to the user, and an unhandled one would 500 the
            // whole shell including the navigation they need to get somewhere else.
            _project = null;
            _data = null;
            _error = ex.GetType().Name;
        }
        _loading = false;
    }
}
