@page "/c/{Client}/p/{Project}/build/{Sha}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RouteScope Scope
@inject ProjectHubQuery Hub
@inject Tamp.Findings.Application.Poam.PoamQuery Poam
@inject Tamp.Findings.Application.Attestation.SsdfAttestationBuilder Ssdf
@inject CurrentUser Me
@using Tamp.Findings.Domain.Risk

<PageTitle>@Project — tamp.findings</PageTitle>

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_error is not null)
{
    @* The database is unreachable. Say so LOUDLY rather than rendering an
       empty hub — a screen whose job is to report posture must never imply a
       clean one it could not measure. This is the same principle as "a missing
       scan is not a clean scan", applied to the reader's own connection. *@
    <div class="stack">
        <h1>@Project</h1>
        <Card>
            <div class="row">
                <Chip Label="Unavailable" Tone="var(--color-high)" Style="Chip.ChipStyle.Solid" Glyph="!" />
                <span>Could not load this project's posture.</span>
            </div>
            <p class="field__help">
                The score and gates are unknown, not clean. @_error
            </p>
        </Card>
    </div>
}
else if (_project is null)
{
    <div class="stack">
        <h1>Project not found</h1>
        <Card>
            <p>No project matches <code class="mono">@Client / @Project</code>.</p>
        </Card>
    </div>
}
else if (_data is null)
{
    @* A registered-but-never-scanned project is a real and common state, and
       it must NOT render as a zero score. "A project with a green score and no
       recent scan is not healthy" — and a zero score would be worse still,
       implying something was measured. *@
    <div class="stack">
        <div>
            <h1>@_project.ProjectName</h1>
            <p class="muted">@_project.ClientName</p>
        </div>
        <Card>
            <div class="row">
                <Chip Label="No scan" Tone="var(--color-medium)" Style="Chip.ChipStyle.Dashed" Glyph="?" />
                <span>This project has no canonical build yet.</span>
            </div>
            <p class="field__help">
                Nothing has been ingested, so there is no score and no gate to evaluate.
                A missing scan is not a clean scan.
            </p>
        </Card>
    </div>
}
else
{
    <div class="stack">
        <div class="hubhead" style="border-left: 4px solid @BandColour">
            <div class="hubhead__id">
                <a class="hubhead__back" href="@Routes.Portfolio">← Portfolio</a>
                <h1>@_data.Project.ProjectName</h1>
                <p class="muted">
                    @_data.Project.ClientName@(_data.ComplianceBaseline is { Length: > 0 } bl ? $" · {bl}" : "") · policy @_data.PolicyName
                </p>
                <p class="muted hubhead__build">Latest build: <span class="mono">@ShortSha</span> · @_data.BuiltAt.ToString("yyyy-MM-dd HH:mm")</p>
            </div>
            <div class="hubhead__stats">
                <div class="statcard" style="--band: @BandColour">
                    <div class="statcard__label">Risk · @_data.Risk.Band</div>
                    <div class="statcard__value">@_data.Risk.Score.ToString("F1")%</div>
                </div>
                <div class="statcard" style="--band: @CoverageColour">
                    <div class="statcard__label">Coverage</div>
                    <div class="statcard__value">@CoverageValue</div>
                </div>
                <div class="statcard" style="--band: @TestsColour">
                    <div class="statcard__label">Tests passing</div>
                    <div class="statcard__value">
                        @if (_data.Inputs.TestsMeasured)
                        {
                            <text>@TestsPassed.ToString("N0")<span class="statcard__den"> / @TestsTotal.ToString("N0")</span></text>
                        }
                        else { <text>✕ No data</text> }
                    </div>
                </div>
                <div class="statcard statcard--wide" style="--band: @ShipColour">
                    <div class="statcard__label">Ship gate</div>
                    <div class="statcard__value">@(_data.Gates.ClearToShip ? "✓ Clear" : "✕ Blocked")</div>
                    @if (ShipReason is { } reason)
                    {
                        <div class="statcard__sub">@reason</div>
                    }
                </div>
            </div>
        </div>

        <div class="hubrow">
            <ScoreCard Data="_data" />
            <GateRail Gates="_data.Gates" />
        </div>

        <div class="hubrow">
            <ProjectKeyCard Project="_data.Project" />
        </div>

        <EvidenceTiles Data="_data" PoamPastDue="_poamPastDue" Sha="@ShortSha" />

        @if (_ssdf is not null)
        {
            <AttestationTiles Doc="_ssdf" />
        }

        <ScanReceipts Inputs="_data.Inputs" Sha="@ShortSha" />

        @* TFND-134. Below the receipts on purpose: it answers the same
           question they do — what do we actually know about this build — and
           "no image inspected" belongs next to the other never-ran states. *@
        <BaseImageCard Images="_data.Images" />

        @if (_data.History.Count > 0)
        {
            <BuildHistory Rows="_data.History" />
        }
    </div>
}

@code {
    [Parameter] public string Client { get; set; } = "";
    [Parameter] public string Project { get; set; } = "";
    [Parameter] public string Sha { get; set; } = "";

    private ProjectRef? _project;
    private ProjectHubData? _data;
    private int _poamPastDue;
    private Tamp.Findings.Application.Attestation.SsdfAttestationDoc? _ssdf;
    private bool _loading = true;
    private string? _error;

    // Seven characters is what the design's build stamp shows, and what a
    // reader can actually match against a git log.
    private string? ShortSha => _data?.CommitSha is { Length: > 7 } full ? full[..7] : _data?.CommitSha;

    private string BandColour => _data?.Risk.Band switch
    {
        "green" => "var(--color-band-green)",
        "yellow" => "var(--color-band-yellow)",
        "orange" => "var(--color-band-orange)",
        _ => "var(--color-band-red)",
    };

    private static string Colour(string slug) => $"var(--color-band-{slug})";

    // Coverage: banded off the project's own target/floor (higher is better). No report ingested
    // is a FAILURE, not a benign blank — a missing measurement is the "unscanned gate passes"
    // defect this product exists to kill, so it reads red, not grey.
    private string CoverageColour => _data!.Inputs.CoverageMeasured
        ? Colour(BandScale.Coverage(_data.CoverageTarget, _data.CoverageFloor).SlugFor(_data.Inputs.SequenceCoveragePercent))
        : Colour("red");
    private string CoverageValue => _data!.Inputs.CoverageMeasured
        ? _data.Inputs.SequenceCoveragePercent.ToString("F1") + "%"
        : "✕ No data";

    // Tests: green only when every test passes; banded on the pass rate when some fail; and RED
    // when nothing was ingested — no test evidence is a failing state, never a pass.
    private int TestsTotal => _data!.Inputs.TestsTotal;
    private int TestsPassed => _data!.Inputs.TestsTotal - _data.Inputs.TestsFailed;
    private string TestsColour => !_data!.Inputs.TestsMeasured ? Colour("red")
        : _data.Inputs.TestsFailed == 0 ? Colour("green")
        : Colour(BandScale.Percent(100, 90, 75).SlugFor(TestsTotal > 0 ? 100.0 * TestsPassed / TestsTotal : 0));

    // Ship gate: green when clear, red with the first blocking gate's reason otherwise.
    private string ShipColour => Colour(_data!.Gates.ClearToShip ? "green" : "red");
    private string? ShipReason
    {
        get
        {
            if (_data!.Gates.ClearToShip) return null;
            var g = _data.Gates.Results.FirstOrDefault(r => r.Blocks);
            return g is null ? null : $"{GateEvaluator.Label(g.Key)} · {g.Observed}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        Scope.SetProject(Client, Project, Sha);

        _loading = true;
        _error = null;
        try
        {
            _project = await Hub.ResolveAsync(Client, Project, await Me.VisibleAsync());
            // "latest" is a sentinel, not a commit prefix. Passing it through
            // would filter for builds whose sha starts with "latest", match
            // nothing, and render a scanned project as never-scanned.
            var sha = string.Equals(Sha, Routes.LatestBuild, StringComparison.OrdinalIgnoreCase) ? null : Sha;
            _data = _project is null ? null : await Hub.LoadAsync(_project, sha);
            // POA&M past-due count feeds the evidence tile; a cheap board read
            // reusing the same past-due rule the gate uses.
            _poamPastDue = _data is null || _project is null
                ? 0
                : (await Poam.BoardAsync(_project.ProjectId, DateTimeOffset.UtcNow)).Stats.PastDue;
            // SSDF practice answers feed the attestation-evidence tiles (PS.2.1,
            // RV.3.1, RV.3.2). Built for the build being shown.
            _ssdf = _data is null || _project is null
                ? null
                : await Ssdf.BuildAsync(_project.ProjectId, _data.CommitSha);
        }
        catch (Exception ex)
        {
            // Deliberately broad: any failure to reach the data — connection
            // refused, timeout, a migration mid-flight — has the same meaning
            // for the reader, and an unhandled one would 500 the whole shell
            // including the navigation they need to get somewhere else.
            _project = null;
            _data = null;
            _error = ex.GetType().Name;
        }
        _loading = false;
    }
}
