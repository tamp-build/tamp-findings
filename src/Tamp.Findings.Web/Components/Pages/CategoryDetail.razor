@page "/c/{Client}/p/{Project}/build/{Sha}/score/{Key}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RouteScope Scope
@inject ProjectHubQuery Hub
@inject Tamp.Findings.Application.Risk.CategoryFindingsQuery CategoryFindings
@inject Tamp.Findings.Application.Licensing.LicenseResolutionService Licenses
@inject CurrentUser Me

<PageTitle>@Label(Key) — tamp.findings</PageTitle>

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_project is null || _row is null)
{
    <div class="stack">
        <h1>@Label(Key)</h1>
        <Card>
            <p>No scored category <code class="mono">@Key</code> for <code class="mono">@Client / @Project</code>.</p>
            <p class="field__help"><a href="@HubHref">← Back to the project</a></p>
        </Card>
    </div>
}
else
{
    <div class="stack">
        <nav class="crumbs">
            <a href="@Routes.Portfolio">Portfolio</a>
            <span class="crumbs__sep">/</span>
            <a href="@HubHref">@_project.ProjectName</a>
            <span class="crumbs__sep">/</span>
            <span>@Label(Key)</span>
        </nav>

        <div class="cathero">
            <div>
                <h1>@Label(Key) <span class="cathero__key mono">@Key</span></h1>
            </div>
            <div class="cathero__points" style="color: @PointsColor">
                @_row.Contribution.ToString("F1")<span class="cathero__max">/ @_row.EffectiveMax.ToString("F0")</span>
                @if (_row.Saturated)
                {
                    <span class="cathero__sat mono">SAT</span>
                }
            </div>
        </div>

        @* Current evidence first, then (for categories without their own history panel) the compact
           points trend below — one combined page, no tabs. *@
        <div>
            @if (!Tamp.Findings.Application.Risk.CategoryFindingsQuery.IsFindingsCategory(Key))
            {
                @if (Key == "cve")
                {
                    @if (_cves.Count == 0)
                    {
                        @if (ScaReceipt is { } sca)
                        {
                            @* Scanned + clean — SHOW THE EVIDENCE: what scanned it, when, and (from the
                               receipt notes) which advisory DB + snapshot date. "0 CVEs" only means clean
                               when we can point at the scan that produced it. *@
                            <Card>
                                <div class="row">
                                    <Chip Label="Scanned · clean" Tone="var(--color-pass)" Glyph="✓" />
                                    <span>
                                        No known CVEs. <strong>@_sbomComponents.ToString("N0")</strong> component@(_sbomComponents == 1 ? "" : "s")
                                        scanned by <span class="mono">@(sca.ToolName ?? "SCA")@(string.IsNullOrWhiteSpace(sca.ToolVersion) ? "" : " " + sca.ToolVersion)</span>@(sca.CompletedAt is { } t ? $" · {t.ToUniversalTime():yyyy-MM-dd HH:mm} UTC" : "").
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(sca.Notes))
                                {
                                    <p class="field__help mono">@sca.Notes</p>
                                }
                            </Card>
                        }
                        else
                        {
                            @* No SCA scan ran — a "0" here is UNASSESSED, not clean. Say so loudly; the
                               CVE gates read Unknown until an OSV/Grype scan is ingested (TFND-216). *@
                            <Card>
                                <div class="row">
                                    <Chip Label="No vuln scan" Tone="var(--color-medium)" Style="Chip.ChipStyle.Dashed" Glyph="?" />
                                    <span>
                                        No vulnerability scan ran on this build. The SBOM lists <strong>@_sbomComponents.ToString("N0")</strong>
                                        component@(_sbomComponents == 1 ? "" : "s"), but nothing checked them against an advisory database —
                                        a “0” here is <strong>unassessed, not clean</strong>.
                                    </span>
                                </div>
                                <p class="field__help">The CVE gates read Unknown, not Pass, until an SCA scan (OSV / Grype) is ingested.</p>
                            </Card>
                        }
                    }
                    else
                    {
                        <Card Padded="false">
                            <ScrollBox Label="Known CVEs">
                                <table class="table table--rows">
                                    <thead>
                                        <tr><th>Severity</th><th>Advisory</th><th>Package</th><th class="align-end">CVSS</th><th>Fixed in</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in _cves)
                                        {
                                            <tr>
                                                <td><SeverityBadge Severity="v.Severity" /></td>
                                                <td class="mono">
                                                    @if (v.ReferenceUrl is { } u)
                                                    {
                                                        <a href="@u" target="_blank" rel="noopener">@v.AdvisoryId</a>
                                                    }
                                                    else
                                                    {
                                                        @v.AdvisoryId
                                                    }
                                                </td>
                                                <td class="mono">@v.Package <span class="muted">@v.Version</span></td>
                                                <td class="mono align-end">@(v.Cvss?.ToString("F1") ?? "—")</td>
                                                <td class="mono">@(v.FixedIn ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </ScrollBox>
                        </Card>
                        <p class="field__help">@_cves.Count known CVE@(_cves.Count == 1 ? "" : "s") across this build's SBOM components.</p>
                    }

                    @* Scan history — the real per-build evidence: commit, when, the scanner + advisory DB
                       it checked against, and the CVE count. A build with no SCA scan is flagged, so a
                       zero can't read as clean. *@
                    @if (_cveHistory.Count > 0)
                    {
                        <Card Padded="false">
                            <div class="card-body">
                                <h2 style="font-size: 14px; margin: 0 0 var(--space-2)">Scan history</h2>
                                <table class="table table--rows">
                                    <thead>
                                        <tr>
                                            <th>Build</th><th>Scanned</th><th>Scanner</th><th>Advisory DB</th><th class="align-end">CVEs</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var h in _cveHistory)
                                        {
                                            <tr>
                                                <td><span class="mono">@Short(h.CommitSha)</span> <span class="muted">@h.BuiltAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm")</span></td>
                                                <td>
                                                    @if (h.Scanned)
                                                    {
                                                        <span style="color: var(--color-pass)">✓</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: var(--color-high)">no scan</span>
                                                    }
                                                </td>
                                                <td class="mono">@(h.Scanned ? $"{h.ScannerTool} {h.ScannerVersion}".Trim() : "—")</td>
                                                <td class="mono muted">@(DbSummary(h.Notes) ?? "—")</td>
                                                <td class="align-end mono">@(h.Scanned ? h.CveCount.ToString() : "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <p class="field__help">Each row is the SCA scan behind that build's CVE result — provenance (scanner + advisory DB + build), not just that a scan happened.</p>
                            </div>
                        </Card>
                    }
                }
                else if (Key == "coverage")
                {
                    @if (_coverage is null)
                    {
                        <Card>
                            <div class="row">
                                <Chip Label="Not measured" Tone="var(--color-high)" Style="Chip.ChipStyle.Dashed" Glyph="—" />
                                <span>No coverage was ingested for this build.</span>
                            </div>
                            <p class="field__help">A missing measurement is not full coverage.</p>
                        </Card>
                    }
                    else
                    {
                        <Card>
                            <div class="covgrid">
                                <div class="covstat">
                                    <div class="covstat__value">@_coverage.SequencePercent.ToString("F1")%</div>
                                    <div class="covstat__label">Sequence coverage</div>
                                    <div class="covstat__sub mono">@_coverage.CoveredSequences.ToString("N0") / @_coverage.TotalSequences.ToString("N0") points</div>
                                </div>
                                <div class="covstat">
                                    <div class="covstat__value">@_coverage.BranchPercent.ToString("F1")%</div>
                                    <div class="covstat__label">Branch coverage</div>
                                    <div class="covstat__sub mono">@_coverage.CoveredBranches.ToString("N0") / @_coverage.TotalBranches.ToString("N0") branches</div>
                                </div>
                            </div>
                        </Card>
                        @if (_coverage.ToolName is not null)
                        {
                            <p class="field__help mono">@($"{_coverage.ToolName} {_coverage.ToolVersion}".Trim())@(_coverage.IngestedAt is { } ing ? " · ingested " + ing.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") + " UTC" : "")</p>
                        }
                        @if (_coverage.Modules is { Count: > 0 } mods)
                        {
                            <Card Padded="false">
                                <div class="card-body">
                                    <h2 style="font-size: 14px; margin: 0 0 var(--space-2)">By assembly · namespace · file <span class="muted">(lowest coverage first)</span></h2>
                                    <table class="table table--rows">
                                        <thead><tr><th>Name</th><th class="align-end">Line %</th><th class="align-end">Lines</th><th class="align-end">Branch %</th></tr></thead>
                                        <tbody>
                                            @foreach (var m in mods)
                                            {
                                                <tr>
                                                    <td class="mono"><strong>@m.Name</strong> <span class="muted">assembly</span></td>
                                                    <td class="mono align-end" style="color: @CovColor(m.SeqPercent)">@m.SeqPercent.ToString("F1")%</td>
                                                    <td class="mono align-end muted">@m.CoveredSeq.ToString("N0") / @m.TotalSeq.ToString("N0")</td>
                                                    <td class="mono align-end">@(m.TotalBranch == 0 ? "—" : m.BranchPercent.ToString("F1") + "%")</td>
                                                </tr>
                                                @foreach (var n in m.Namespaces)
                                                {
                                                    <tr>
                                                        <td class="mono" style="padding-left: 24px">@n.Name <span class="muted">namespace</span></td>
                                                        <td class="mono align-end" style="color: @CovColor(n.SeqPercent)">@n.SeqPercent.ToString("F1")%</td>
                                                        <td class="mono align-end muted">@n.CoveredSeq.ToString("N0") / @n.TotalSeq.ToString("N0")</td>
                                                        <td class="mono align-end">@(n.TotalBranch == 0 ? "—" : n.BranchPercent.ToString("F1") + "%")</td>
                                                    </tr>
                                                    @foreach (var f in n.Files)
                                                    {
                                                        <tr>
                                                            <td class="mono muted" style="padding-left: 48px" title="@f.Path">@CovShorten(f.Path)</td>
                                                            <td class="mono align-end" style="color: @CovColor(f.SeqPercent)">@f.SeqPercent.ToString("F1")%</td>
                                                            <td class="mono align-end muted">@f.CoveredSeq.ToString("N0") / @f.TotalSeq.ToString("N0")</td>
                                                            <td class="mono align-end">@(f.TotalBranch == 0 ? "—" : f.BranchPercent.ToString("F1") + "%")</td>
                                                        </tr>
                                                    }
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </Card>
                        }
                    }
                }
                else if (Key == "tests")
                {
                    @if (_tests is null)
                    {
                        <Card>
                            <div class="row">
                                <Chip Label="Not measured" Tone="var(--color-high)" Style="Chip.ChipStyle.Dashed" Glyph="—" />
                                <span>No test run was ingested for this build.</span>
                            </div>
                            <p class="field__help">A missing test run is not a passing one.</p>
                        </Card>
                    }
                    else
                    {
                        <Card>
                            <div class="covgrid">
                                <div class="covstat">
                                    <div class="covstat__value" style="color: var(--color-pass)">@_tests.Passed.ToString("N0")</div>
                                    <div class="covstat__label">Passed</div>
                                    <div class="covstat__sub mono">of @_tests.Total.ToString("N0") tests</div>
                                </div>
                                <div class="covstat">
                                    <div class="covstat__value" style="color: @(_tests.Failed > 0 ? "var(--color-critical)" : "var(--color-neutral-500)")">@_tests.Failed.ToString("N0")</div>
                                    <div class="covstat__label">Failed</div>
                                    <div class="covstat__sub mono">@_tests.Skipped.ToString("N0") skipped</div>
                                </div>
                            </div>
                            @* Provenance line — the run this evidence came from: what produced it, when, how
                               long, and how much it covered. A count with no provenance is not evidence. *@
                            <p class="field__help mono" style="margin-top: var(--space-3)">
                                @(_tests.ToolName ?? "test run")@(string.IsNullOrWhiteSpace(_tests.ToolVersion) ? "" : " " + _tests.ToolVersion)
                                · @_tests.SuiteCount.ToString("N0") suite@(_tests.SuiteCount == 1 ? "" : "s") across @_tests.AssemblyCount assembl@(_tests.AssemblyCount == 1 ? "y" : "ies")
                                @if (_tests.DurationMs > 0) { <text> · @FormatDuration(_tests.DurationMs)</text> }
                                @if (_tests.CompletedAt is { } tc) { <text> · @tc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</text> }
                            </p>
                        </Card>

                        @* Per-assembly breakdown — the full "what actually ran" surface, failing-first. This is
                           the real test-module evidence, not just a grand total. *@
                        @if (_tests.Assemblies is { Count: > 0 } asms)
                        {
                            <Card Padded="false">
                                <ScrollBox Label="Test assemblies">
                                    <table class="table table--rows">
                                        <thead>
                                            <tr><th>Assembly</th><th class="align-end">Total</th><th class="align-end">Passed</th><th class="align-end">Failed</th><th class="align-end">Skipped</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var a in asms)
                                            {
                                                <tr>
                                                    <td class="mono">@a.Assembly</td>
                                                    <td class="mono align-end">@a.Total.ToString("N0")</td>
                                                    <td class="mono align-end" style="color: var(--color-pass)">@a.Passed.ToString("N0")</td>
                                                    <td class="mono align-end" style="color: @(a.Failed > 0 ? "var(--color-critical)" : "inherit")">@a.Failed</td>
                                                    <td class="mono align-end muted">@a.Skipped</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </ScrollBox>
                            </Card>
                        }

                        @* Failure detail — the actual proof of what broke: message + stack, per failed case. *@
                        @if (_testFailures.Count > 0)
                        {
                            <Card Padded="false">
                                <ScrollBox Label="@($"Failures ({_testFailures.Count})")">
                                    <div class="card-body">
                                        @foreach (var f in _testFailures)
                                        {
                                            <div style="padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border)">
                                                <div class="mono" style="color: var(--color-critical)">@f.ClassName.@f.Name</div>
                                                <div class="mono muted" style="font-size: 11px">@f.Assembly</div>
                                                @if (!string.IsNullOrWhiteSpace(f.ErrorMessage))
                                                {
                                                    <pre class="mono" style="white-space: pre-wrap; margin: var(--space-1) 0 0; font-size: 12px">@f.ErrorMessage</pre>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(f.ErrorStackTrace))
                                                {
                                                    <details>
                                                        <summary class="muted" style="font-size: 12px; cursor: pointer">Stack trace</summary>
                                                        <pre class="mono muted" style="white-space: pre-wrap; margin: var(--space-1) 0 0; font-size: 11px">@f.ErrorStackTrace</pre>
                                                    </details>
                                                }
                                            </div>
                                        }
                                    </div>
                                </ScrollBox>
                            </Card>
                        }
                        else if (_tests.Failed == 0)
                        {
                            <p class="field__help">Every test passed — no failures to show.</p>
                        }

                        @* Raw report download — the original .trx/junit files, stored verbatim (ADR 0014,
                           TFND-209). The evidence of record: an auditor can re-parse the exact bytes we did. *@
                        @if (_testArtifacts is { Artifacts.Count: > 0 } raw)
                        {
                            <Card>
                                <h2 style="font-size: 14px; margin: 0 0 var(--space-2)">
                                    Raw test reports <span class="muted mono" style="font-size: 12px">· @raw.Artifacts.Count file@(raw.Artifacts.Count == 1 ? "" : "s") · @FormatBytes(raw.Artifacts.Sum(a => a.SizeBytes)) total</span>
                                </h2>
                                @{ var rawList = raw.Artifacts; var rn = 0; }
                                @* No nested scrollbox — a long inner scroll region traps the mouse wheel and
                                   makes the page feel un-scrollable. Show a few inline; the rest live behind a
                                   plain expander so the page stays one continuous scroll. *@
                                <ul style="list-style: none; padding: 0; margin: 0">
                                    @foreach (var art in rawList.Take(8))
                                    {
                                        rn++;
                                        <li style="padding: var(--space-1) 0">
                                            <a class="mono" href="@RawHref(art.Id, raw.ComponentVersionId)" download>⭳ @(art.FileName ?? $"{art.Format}-report-{rn:D3}.xml")</a>
                                            <span class="muted mono" style="font-size: 11px"> · @art.Format · @FormatBytes(art.SizeBytes) · @art.IngestedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</span>
                                        </li>
                                    }
                                </ul>
                                @if (rawList.Count > 8)
                                {
                                    <details>
                                        <summary class="muted" style="cursor: pointer; padding: var(--space-1) 0">Show all @rawList.Count files</summary>
                                        <ul style="list-style: none; padding: 0; margin: 0">
                                            @foreach (var art in rawList.Skip(8))
                                            {
                                                rn++;
                                                <li style="padding: var(--space-1) 0">
                                                    <a class="mono" href="@RawHref(art.Id, raw.ComponentVersionId)" download>⭳ @(art.FileName ?? $"{art.Format}-report-{rn:D3}.xml")</a>
                                                    <span class="muted mono" style="font-size: 11px"> · @art.Format · @FormatBytes(art.SizeBytes) · @art.IngestedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</span>
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                }
                                <p class="field__help">Stored verbatim at ingest — the same bytes the server parsed. Re-parse them to reproduce every count above.</p>
                            </Card>
                        }

                        @* Scan history — per-build test evidence: commit, when, tool, pass/fail, coverage.
                           A build with no test run is flagged, so a silent zero can't read as green. *@
                        @if (_testHistory.Count > 0)
                        {
                            <Card Padded="false">
                                <div class="card-body">
                                    <h2 style="font-size: 14px; margin: 0 0 var(--space-2)">Test history</h2>
                                    <table class="table table--rows">
                                        <thead>
                                            <tr><th>Build</th><th>Ran</th><th>Tool</th><th class="align-end">Passed</th><th class="align-end">Failed</th><th class="align-end">Skipped</th><th class="align-end">Coverage</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var h in _testHistory)
                                            {
                                                <tr>
                                                    <td><span class="mono">@Short(h.CommitSha)</span> <span class="muted">@h.BuiltAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm")</span></td>
                                                    <td>
                                                        @if (h.Measured)
                                                        {
                                                            <span style="color: var(--color-pass)">✓</span>
                                                        }
                                                        else
                                                        {
                                                            <span style="color: var(--color-high)">no run</span>
                                                        }
                                                    </td>
                                                    <td class="mono muted">@(h.Measured ? (h.ToolName ?? "—") : "—")</td>
                                                    <td class="align-end mono" style="color: var(--color-pass)">@(h.Measured ? h.Passed.ToString("N0") : "—")</td>
                                                    <td class="align-end mono" style="color: @(h.Failed > 0 ? "var(--color-critical)" : "inherit")">@(h.Measured ? h.Failed.ToString() : "—")</td>
                                                    <td class="align-end mono muted">@(h.Measured ? h.Skipped.ToString() : "—")</td>
                                                    <td class="align-end mono">@(h.CoveragePercent is { } cp ? cp.ToString("F1") + "%" : "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    <p class="field__help">Each row is the test run behind that build — provenance and result, not just that tests ran.</p>
                                </div>
                            </Card>
                        }
                    }
                }
                else if (Key == "license")
                {
                    @if (_licenseOverview is null)
                    {
                        <Card>
                            <div class="row">
                                <Chip Label="No SBOM" Tone="var(--color-high)" Style="Chip.ChipStyle.Dashed" Glyph="—" />
                                <span>No SBOM components were ingested for this build.</span>
                            </div>
                        </Card>
                    }
                    else
                    {
                        var lo = _licenseOverview;

                        @* 1 — Why the score is what it is. The formula, with THIS build's numbers filled in. *@
                        <Card>
                            <h2 style="font-size: 14px; margin: 0 0 var(--space-2)">Why this score is @lo.DisplayedScore.ToString("0.0") / @lo.CategoryMax.ToString("0")</h2>
                            <div class="covgrid">
                                <div class="covstat">
                                    <div class="covstat__value" style="color: @(lo.DeniedCount > 0 ? "var(--color-critical)" : "var(--color-neutral-500)")">@lo.DeniedCount</div>
                                    <div class="covstat__label">Denied</div>
                                    <div class="covstat__sub mono">× @lo.WeightDenied.ToString("0.##") each</div>
                                </div>
                                <div class="covstat">
                                    <div class="covstat__value" style="color: @(lo.StrongCopyleftCount > 0 ? "var(--color-band-orange)" : "var(--color-neutral-500)")">@lo.StrongCopyleftCount</div>
                                    <div class="covstat__label">Strong copyleft</div>
                                    <div class="covstat__sub mono">× @lo.WeightStrongCopyleft.ToString("0.##") each</div>
                                </div>
                                <div class="covstat">
                                    <div class="covstat__value" style="color: @(lo.UnknownCount > 0 ? "var(--color-medium)" : "var(--color-neutral-500)")">@lo.UnknownCount</div>
                                    <div class="covstat__label">Unknown</div>
                                    <div class="covstat__sub mono">@((lo.UnknownCount * 100.0 / Math.Max(1, lo.TotalComponents)).ToString("0.#"))% of @lo.TotalComponents · × @lo.WeightUnknownPctMul.ToString("0.##")</div>
                                </div>
                            </div>
                            <p class="field__help mono" style="margin-top: var(--space-3)">
                                @lo.DeniedCount×@lo.WeightDenied.ToString("0.##") + @lo.StrongCopyleftCount×@lo.WeightStrongCopyleft.ToString("0.##")
                                + (@lo.UnknownCount/@lo.TotalComponents)×@lo.WeightUnknownPctMul.ToString("0.##")
                                → @lo.DisplayedScore.ToString("0.00") points of @lo.CategoryMax.ToString("0")
                            </p>
                            @if (lo.ResolvedApplied > 0)
                            {
                                <p class="field__help" style="color: var(--color-pass)">✓ @lo.ResolvedApplied component@(lo.ResolvedApplied == 1 ? "" : "s") classified from the license knowledge base.</p>
                            }
                        </Card>

                        @* 2 — The policy in force: what counts as denied, and any project overrides. *@
                        <Card>
                            <h2 style="font-size: 14px; margin: 0 0 var(--space-2)">Licence policy in force</h2>
                            <p class="field__help" style="margin-top: 0">
                                Built-in denied tiers: <span class="mono">GPL-3.0, AGPL-3.0, SSPL-1.0, Commons-Clause</span> (network-copyleft / source-disclosure that breaks commercial SaaS). Strong copyleft (<span class="mono">GPL-2.0, LGPL-3.0</span>) is flagged but not denied.
                            </p>
                            <div class="row" style="gap: var(--space-2); flex-wrap: wrap; margin-top: var(--space-2)">
                                @if (lo.PolicyDeny.Count > 0)
                                {
                                    <span>Policy also denies: @foreach (var d in lo.PolicyDeny) { <span class="mono" style="color: var(--color-critical)">@d </span>}</span>
                                }
                                @if (lo.PolicyAllow.Count > 0)
                                {
                                    <span>Policy allows (override): @foreach (var a in lo.PolicyAllow) { <span class="mono" style="color: var(--color-pass)">@a </span>}</span>
                                }
                                @if (lo.PolicyDeny.Count == 0 && lo.PolicyAllow.Count == 0)
                                {
                                    <span class="muted">No project-specific allow/deny overrides — the built-in tiers apply as-is.</span>
                                }
                            </div>
                            <p class="field__help">Unknown licences are @(lo.DenyUnknown ? "treated as DENIED" : "counted as risk but not denied") by this policy.</p>
                        </Card>

                        @* 3 — The mix, each row tagged with its permissiveness tier. *@
                        <Card Padded="false">
                            <ScrollBox Label="Licence mix">
                                <table class="table table--rows">
                                    <thead>
                                        <tr><th>Licence</th><th>Tier</th><th class="align-end">Components</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var g in lo.Groups)
                                        {
                                            <tr>
                                                <td class="mono">@g.License</td>
                                                <td><Chip Label="@TierLabel(g.Tier)" Tone="@TierTone(g.Tier)" /></td>
                                                <td class="mono align-end">@g.Count.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </ScrollBox>
                        </Card>
                        <p class="field__help">@lo.TotalComponents.ToString("N0") components across @lo.Groups.Count distinct licence@(lo.Groups.Count == 1 ? "" : "s").</p>

                        @* 4 — The worklist: packages whose licence nobody could classify, with a way to resolve + persist. *@
                        @if (lo.Unknowns.Count > 0)
                        {
                            <Card Padded="false">
                                <div class="card-body">
                                    <h2 style="font-size: 14px; margin: 0 0 var(--space-1)">Unresolved licences <span class="muted mono" style="font-size: 12px">· @lo.Unknowns.Count</span></h2>
                                    <p class="field__help" style="margin-top: 0">
                                        These packages carry no SPDX licence the classifier recognises — usually an old-style NuGet <span class="mono">.nuspec</span> with a <span class="mono">licenseUrl</span> instead of an expression. Confirm the real licence and record it; the resolution is <strong>global</strong> — every project pulling that package inherits it, and the score updates.
                                    </p>
                                    @if (_resolveError is { } err)
                                    {
                                        <p class="field__help" style="color: var(--color-critical)">@err</p>
                                    }
                                    <table class="table table--rows">
                                        <thead>
                                            <tr><th>Package</th><th>Version</th><th>Declared</th>@if (_canResolveLicense) { <th>Resolve to</th> }</tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var u in lo.Unknowns)
                                            {
                                                <tr>
                                                    <td class="mono">@u.Name</td>
                                                    <td class="mono muted">@u.Version</td>
                                                    <td class="mono muted" style="font-size: 11px">@(u.DeclaredLicense ?? "—")</td>
                                                    @if (_canResolveLicense)
                                                    {
                                                        <td>
                                                            <div class="row" style="gap: var(--space-1); flex-wrap: nowrap">
                                                                <input class="input mono" list="spdx-common" placeholder="SPDX e.g. MIT" style="width: 110px"
                                                                       value="@_resolveSpdx.GetValueOrDefault(u.Purl, "")"
                                                                       @oninput="e => _resolveSpdx[u.Purl] = e.Value?.ToString() ?? string.Empty" />
                                                                <input class="input" placeholder="evidence (optional)" style="width: 150px"
                                                                       value="@_resolveNote.GetValueOrDefault(u.Purl, "")"
                                                                       @oninput="e => _resolveNote[u.Purl] = e.Value?.ToString() ?? string.Empty" />
                                                                <button class="btn" disabled="@(_resolveBusyPurl == u.Purl)" @onclick="() => ResolveLicenseAsync(u.Purl)">
                                                                    @(_resolveBusyPurl == u.Purl ? "Saving…" : "Resolve")
                                                                </button>
                                                            </div>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    @if (!_canResolveLicense)
                                    {
                                        <p class="field__help">You don't have permission to resolve licences (needs policy-edit rights).</p>
                                    }
                                </div>
                            </Card>
                            <datalist id="spdx-common">
                                <option value="MIT"></option>
                                <option value="Apache-2.0"></option>
                                <option value="BSD-2-Clause"></option>
                                <option value="BSD-3-Clause"></option>
                                <option value="ISC"></option>
                                <option value="MPL-2.0"></option>
                                <option value="LGPL-2.1"></option>
                                <option value="GPL-2.0"></option>
                                <option value="GPL-3.0"></option>
                                <option value="AGPL-3.0"></option>
                            </datalist>
                        }
                        else
                        {
                            <p class="field__help" style="color: var(--color-pass)">✓ Every licence in this build is identified — no unknowns to resolve.</p>
                        }
                    }
                }
                else if (Key == "quality")
                {
                    <QualityPanel Overview="_quality" />
                }
                else if (Key == "sbomStaleness")
                {
                @if (_sbom is { } sb)
                {
                    <Card Padded="false">
                        <div class="card-body">
                            <h2 style="font-size: 14px; margin: 0 0 var(--space-2)">SBOM provenance</h2>
                            <table class="table table--rows">
                                <thead><tr><th>Tool</th><th>Spec</th><th class="align-end">Components</th><th class="align-end">Version-checked</th><th class="align-end">Outdated</th><th class="align-end">Vulnerable</th><th>Ingested</th></tr></thead>
                                <tbody><tr>
                                    <td class="mono">@($"{sb.ToolName} {sb.ToolVersion}".Trim())</td>
                                    <td class="mono muted">@(sb.SpecVersion ?? "—")</td>
                                    <td class="mono align-end">@sb.Components.ToString("N0")</td>
                                    <td class="mono align-end" style="@(sb.Checked < sb.Components ? "color: var(--color-high)" : null)">@sb.Checked.ToString("N0")</td>
                                    <td class="mono align-end">@sb.Outdated.ToString("N0")</td>
                                    <td class="mono align-end">@sb.Vulnerable.ToString("N0")</td>
                                    <td class="mono muted">@sb.IngestedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                </tr></tbody>
                            </table>
                        </div>
                    </Card>
                }
                    @if (_sbom is null)
                    {
                        <Card>
                            <div class="row">
                                <Chip Label="No SBOM" Tone="var(--color-high)" Style="Chip.ChipStyle.Dashed" Glyph="—" />
                                <span>No SBOM was ingested for this build — freshness is unassessed, not fresh.</span>
                            </div>
                        </Card>
                    }
                    else if (_stale.Count == 0)
                    {
                        <Card>
                            <div class="row">
                                <Chip Label="Fresh" Tone="var(--color-pass)" Glyph="✓" />
                                <span>Every non-vulnerable component is on its newest version.</span>
                            </div>
                        </Card>
                    }
                    else
                    {
                        <Card Padded="false">
                            <ScrollBox Label="Outdated components">
                                <table class="table table--rows">
                                    <thead>
                                        <tr><th>Component</th><th>In build</th><th>Latest</th><th class="align-end">Update age</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in _stale)
                                        {
                                            <tr>
                                                <td class="mono">@c.Name</td>
                                                <td class="mono muted">@c.Version</td>
                                                <td class="mono">@(c.LatestVersion ?? "—")</td>
                                                <td class="mono align-end">@(c.DaysBehind is { } d ? $"{d:N0}d" : "—")</td>
                                                <td>
                                                    @if (c.Stale)
                                                    {
                                                        <span class="contrib__sat mono" style="color: var(--color-band-orange)">STALE</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </ScrollBox>
                        </Card>
                        <p class="field__help">
                            @_stale.Count component@(_stale.Count == 1 ? "" : "s") behind their newest release; @_stale.Count(c => c.Stale) marked
                            <strong>STALE</strong> (that newer release itself shipped over 180 days ago). Vulnerable components score under Known CVEs, not here.
                        </p>
                    }
                }
                else if (Key == "missingScanners")
                {
                    @if (_receipts.Count == 0)
                    {
                        <Card>
                            <div class="row">
                                <Chip Label="No receipts" Tone="var(--color-high)" Style="Chip.ChipStyle.Dashed" Glyph="—" />
                                <span>No scan-run receipts were recorded for this build.</span>
                            </div>
                            <p class="field__help">Without receipts, coverage of the scanner set cannot be proven.</p>
                        </Card>
                    }
                    else
                    {
                        <Card Padded="false">
                            <ScrollBox Label="Scan-run receipts">
                                <table class="table table--rows">
                                    <thead>
                                        <tr><th>Scanner</th><th>Tool</th><th>Status</th><th class="align-end">Findings</th><th>Completed</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _receipts)
                                        {
                                            <tr>
                                                <td class="mono">@r.Scanner</td>
                                                <td class="mono muted">@(r.ToolName ?? "—")</td>
                                                <td class="mono">@ReceiptStatus(r.Status)</td>
                                                <td class="mono align-end">@r.FindingsCount.ToString("N0")</td>
                                                <td class="mono muted">@(r.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </ScrollBox>
                        </Card>
                        <p class="field__help">@_receipts.Count scanner@(_receipts.Count == 1 ? "" : "s") ran for this build. A scanner that never ran leaves no row — a gap here is the signal.</p>
                    }
                }
                else
                {
                    <Card>
                        <p class="muted">The detailed view for <strong>@Label(Key)</strong> lands with its own phase-3 pass.</p>
                        <p class="field__help">
                            This category is scored from @SourceHint(Key), so its table is built separately. The score above is live.
                        </p>
                    </Card>
                }
            }
            else if (_findings.Count == 0)
            {
                <Card>
                    <div class="row">
                        @if (!_row.Enabled)
                        {
                            <Chip Label="Disabled" Tone="var(--color-neutral-500)" Style="Chip.ChipStyle.Dashed" />
                            <span>This category is disabled in policy.</span>
                        }
                        else
                        {
                            var ran = CategoryReceipts(Key);
                            @if (ran.Count == 0)
                            {
                                <Chip Label="@("No " + ScanKindLabel(Key) + " scan")" Tone="var(--color-medium)" Style="Chip.ChipStyle.Dashed" Glyph="?" />
                                <span>No @ScanKindLabel(Key) scan was recorded for this build — a “0” here is <strong>unassessed, not clean</strong>.</span>
                            }
                            else
                            {
                                <Chip Label="Scanned · clean" Tone="var(--color-pass)" Glyph="✓" />
                                <span>No findings in this category for this build — @ran.Count scan@(ran.Count == 1 ? "" : "s") ran (below).</span>
                            }
                        }
                    </div>
                    <p class="field__help">A missing scan is not a clean scan — check the Missing scanners category.</p>
                </Card>
            }
            else
            {
                <Card Padded="false">
                    <ScrollBox Label="@Label(Key)">
                        <table class="table table--rows">
                            <thead>
                                <tr>
                                    <th>Severity</th><th>Finding</th><th>Location</th>
                                    <th>First seen</th><th>Status</th><th>Gate</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in _findings)
                                {
                                    <tr>
                                        <td><SeverityBadge Severity="f.Severity" /></td>
                                        <td>
                                            <div>@f.Title</div>
                                            <div class="mono muted cat__rule">@f.Scanner · @f.RuleId</div>
                                        </td>
                                        <td class="mono">
                                            @if (f.FilePath is { } path)
                                            {
                                                <span title="@path">@Shorten(path)@(f.Line is { } ln ? $":{ln}" : "")</span>
                                            }
                                            else
                                            {
                                                <span class="muted">—</span>
                                            }
                                        </td>
                                        <td class="mono">@f.FirstSeen.ToString("yyyy-MM-dd")</td>
                                        <td class="mono muted">@f.Status</td>
                                        <td class="mono">@GateMark(f.Severity)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </ScrollBox>
                </Card>
                <p class="field__help">@_findings.Count finding@(_findings.Count == 1 ? "" : "s") contributing to this category.</p>
            }

            @if (CategoryReceipts(Key) is { Count: > 0 } prov)
            {
                <Card Padded="false">
                    <div class="card-body">
                        <h2 style="font-size: 14px; margin: 0 0 var(--space-2)">Scan provenance</h2>
                        <table class="table table--rows">
                            <thead><tr><th>Scanner</th><th>Tool</th><th>Status</th><th class="align-end">Findings</th><th>Completed</th></tr></thead>
                            <tbody>
                                @foreach (var r in prov)
                                {
                                    <tr>
                                        <td class="mono">@r.Scanner</td>
                                        <td class="mono muted">@($"{r.ToolName} {r.ToolVersion}".Trim())</td>
                                        <td class="mono">@ReceiptStatus(r.Status)</td>
                                        <td class="mono align-end">@_findings.Count(f => f.Scanner.ToString() == r.Scanner.ToString()).ToString("N0")</td>
                                        <td class="mono muted">@(r.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                    </tr>
                                    @if (!string.IsNullOrWhiteSpace(r.Notes))
                                    {
                                        <tr><td colspan="5" class="mono muted">@r.Notes</td></tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </Card>
            }
        </div>

        @if (Key != "cve" && Key != "tests" && Key != "license" && Key != "quality")
        {
            var hist = _history
                .Select(h => (h.CommitSha, h.VersionString, h.IngestedAt, Row: h.Breakdown.FirstOrDefault(b => b.Key == Key)))
                .Where(x => x.Row is not null)
                .ToList();   // newest-first, as the hub returns it

            @if (hist.Count < 2)
            {
                <Card>
                    <div class="row">
                        <Chip Label="Not enough history" Tone="var(--color-neutral-500)" Style="Chip.ChipStyle.Dashed" Glyph="—" />
                        <span>At least two scored builds are needed to trend this category — @hist.Count so far.</span>
                    </div>
                </Card>
            }
            else
            {
                var points = Enumerable.Reverse(hist).Select(x => x.Row!.Contribution).ToList();   // oldest→newest for the plot
                var current = hist[0].Row!.Contribution;
                var windowDelta = current - hist[^1].Row!.Contribution;   // vs the oldest build in view (lower is better)
                <Card>
                    <div class="row row--between">
                        <div>
                            <div class="kicker">points cost · last @hist.Count builds</div>
                            <div class="cathero__points" style="color: @TrendColor(windowDelta)">
                                @current.ToString("F1")<span class="cathero__max">/ @hist[0].Row!.EffectiveMax.ToString("F0")</span>
                            </div>
                        </div>
                        <div class="row" style="gap: var(--space-3); align-items: center">
                            <span class="mono" style="color: @TrendColor(windowDelta)">@TrendArrow(windowDelta) @(windowDelta == 0 ? "flat" : (windowDelta > 0 ? "+" : "") + windowDelta.ToString("F1"))</span>
                            <Sparkline Points="points" Color="@TrendColor(windowDelta)" AriaLabel="@($"{Label(Key)} points over the last {hist.Count} builds")" />
                        </div>
                    </div>
                    <p class="field__help">Lower is better — this is the points this category cost the score. A fall since the oldest build in view is an improvement; a rise is a regression.</p>
                </Card>
                <Card Padded="false">
                    <ScrollBox Label="Per-build">
                        <table class="table table--rows">
                            <thead><tr><th>Build</th><th>When</th><th class="align-end">Points</th><th class="align-end">Δ vs prior</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < hist.Count; i++)
                                {
                                    var x = hist[i];
                                    double? d = i + 1 < hist.Count ? x.Row!.Contribution - hist[i + 1].Row!.Contribution : null;
                                    <tr>
                                        <td class="mono">@x.VersionString <span class="muted">@(x.CommitSha.Length >= 7 ? x.CommitSha[..7] : x.CommitSha)</span></td>
                                        <td class="mono muted">@x.IngestedAt.ToString("yyyy-MM-dd")</td>
                                        <td class="mono align-end">@x.Row!.Contribution.ToString("F1")@(x.Row!.Saturated ? " SAT" : "")</td>
                                        <td class="mono align-end" style="color: @(d is null ? "inherit" : TrendColor(d.Value))">@(d is null ? "—" : (d > 0 ? "+" : "") + d.Value.ToString("F1"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </ScrollBox>
                </Card>
            }
        }
    </div>
}

@code {
    [Parameter] public string Client { get; set; } = "";
    [Parameter] public string Project { get; set; } = "";
    [Parameter] public string Sha { get; set; } = "";
    [Parameter] public string Key { get; set; } = "";

    private ProjectRef? _project;
    private Tamp.Findings.Domain.Risk.RiskCategoryBreakdown? _row;
    private IReadOnlyList<Tamp.Findings.Application.Risk.CategoryFinding> _findings = [];
    private IReadOnlyList<Tamp.Findings.Application.Risk.CveRow> _cves = [];
    private IReadOnlyList<Tamp.Findings.Application.Risk.CveScanHistoryRow> _cveHistory = [];
    private Tamp.Findings.Application.Risk.CoverageSummary? _coverage;
    private static string CovColor(double pct) => pct >= 80 ? "var(--color-pass)" : pct >= 50 ? "var(--color-high)" : "var(--color-critical)";
    private static string CovShorten(string p) => p.Length <= 70 ? p : "…" + p[^69..];
    private Tamp.Findings.Application.Risk.TestsSummary? _tests;
    private IReadOnlyList<Tamp.Findings.Application.Risk.TestFailureRow> _testFailures = [];
    private IReadOnlyList<Tamp.Findings.Application.Risk.TestScanHistoryRow> _testHistory = [];
    private Tamp.Findings.Application.Risk.BuildRawArtifacts? _testArtifacts;
    private IReadOnlyList<Tamp.Findings.Application.Risk.LicenseGroup> _licenses = [];
    private Tamp.Findings.Application.Risk.LicenseOverview? _licenseOverview;
    private Tamp.Findings.Application.Risk.QualityOverview? _quality;
    private bool _canResolveLicense;
    private readonly Dictionary<string, string> _resolveSpdx = new();
    private readonly Dictionary<string, string> _resolveNote = new();
    private string? _resolveError;
    private string? _resolveBusyPurl;
    private IReadOnlyList<Tamp.Findings.Application.Risk.StaleComponent> _stale = [];
    private Tamp.Findings.Application.Risk.SbomSummary? _sbom;
    private IReadOnlyList<Tamp.Findings.Application.Risk.ReceiptRow> _receipts = [];
    private int _sbomComponents;
    // The dependency-vuln (SCA) scan receipt, if one ran — the evidence behind "0 CVEs" (TFND-217).
    private Tamp.Findings.Application.Risk.ReceiptRow? ScaReceipt => _receipts.FirstOrDefault(r =>
        (r.Scanner == Tamp.Findings.Domain.Values.ScannerKind.OsvScanner || r.Scanner == Tamp.Findings.Domain.Values.ScannerKind.Grype)
        && r.Status == "Succeeded");
    private IReadOnlyList<BuildHistoryRow> _history = [];
    private bool _loading = true;
    private string? _commitSha;

    private string HubHref => Routes.ProjectHub(Client, Project, Sha);

    private string PointsColor =>
        _row is null ? "var(--color-neutral-600)"
        : _row.Saturated ? "var(--color-critical)"
        : _row.Contribution > 0 ? "var(--color-band-orange)"
        : "var(--color-neutral-600)";

    protected override async Task OnParametersSetAsync()
    {
        Scope.SetProject(Client, Project, Sha);
        _loading = true;
        try
        {
            _project = await Hub.ResolveAsync(Client, Project, await Me.VisibleAsync());
            var sha = string.Equals(Sha, Routes.LatestBuild, StringComparison.OrdinalIgnoreCase) ? null : Sha;
            var data = _project is null ? null : await Hub.LoadAsync(_project, sha);
            _row = data?.Risk.Breakdown.FirstOrDefault(b => b.Key == Key);
            _commitSha = data?.CommitSha;
            _history = data?.History ?? [];
            _sbomComponents = data?.Inputs.SbomComponents ?? 0;

            if (_project is not null && _row is not null)
            {
                if (Tamp.Findings.Application.Risk.CategoryFindingsQuery.IsFindingsCategory(Key))
                {
                    _findings = await CategoryFindings.LoadAsync(_project.ProjectId, _commitSha, Key);
                    _receipts = await CategoryFindings.ReceiptsAsync(_project.ProjectId, _commitSha);
                }
                else if (Key == "cve")
                {
                    _cves = await CategoryFindings.CvesAsync(_project.ProjectId, _commitSha);
                    _receipts = await CategoryFindings.ReceiptsAsync(_project.ProjectId, _commitSha);   // for the SCA scan-evidence panel
                    _cveHistory = await CategoryFindings.CveScanHistoryAsync(_project.ProjectId);       // per-build scan provenance
                }
                else if (Key == "coverage")
                    _coverage = await CategoryFindings.CoverageAsync(_project.ProjectId, _commitSha);
                else if (Key == "tests")
                {
                    _tests = await CategoryFindings.TestsAsync(_project.ProjectId, _commitSha);
                    _testFailures = await CategoryFindings.TestFailuresAsync(_project.ProjectId, _commitSha);
                    _testHistory = await CategoryFindings.TestScanHistoryAsync(_project.ProjectId);        // per-build run provenance
                    _testArtifacts = await CategoryFindings.RawArtifactsAsync(_project.ProjectId, _commitSha, Tamp.Findings.Domain.Values.RawArtifactKind.TestResults);
                }
                else if (Key == "license")
                {
                    _licenseOverview = await CategoryFindings.LicenseOverviewAsync(_project.ProjectId, _commitSha);
                    _canResolveLicense = (await Me.CanAsync(
                        Capability.EditPolicyWeights, new ScopeTarget(_project.ClientId, _project.ProjectId))).Allowed;
                }
                else if (Key == "quality")
                    _quality = await CategoryFindings.QualityOverviewAsync(_project.ProjectId, _commitSha);
                else if (Key == "sbomStaleness")
                {
                    _stale = await CategoryFindings.SbomStalenessAsync(_project.ProjectId, _commitSha);
                    _sbom = await CategoryFindings.SbomSummaryAsync(_project.ProjectId, _commitSha);
                }
                else if (Key == "missingScanners")
                    _receipts = await CategoryFindings.ReceiptsAsync(_project.ProjectId, _commitSha);
            }
        }
        catch
        {
            _project = null;
            _row = null;
            _findings = [];
            _cves = [];
            _cveHistory = [];
            _coverage = null;
            _tests = null;
            _testFailures = [];
            _testHistory = [];
            _testArtifacts = null;
            _licenses = [];
            _licenseOverview = null;
            _quality = null;
            _stale = [];
            _sbom = null;
            _receipts = [];
            _history = [];
        }
        _loading = false;
    }

    // Only enabled gates block; the severe categories map to blocking gates when
    // the finding is critical/high, so mark those.
    private static string GateMark(Domain.Values.Severity sev) =>
        sev is Domain.Values.Severity.Critical or Domain.Values.Severity.High ? "gated" : "—";

    // A receipt's status, glyphed. Succeeded is clean; Failed/Skipped are the gaps.
    private List<Tamp.Findings.Application.Risk.ReceiptRow> CategoryReceipts(string key)
    {
        var kinds = key switch
        {
            "sastSevere" or "sastLow" => Tamp.Findings.Domain.Values.ScannerKinds.Sast
                .Append(Tamp.Findings.Domain.Values.ScannerKind.SonarQube).ToHashSet(),
            "secrets" => new HashSet<Tamp.Findings.Domain.Values.ScannerKind> { Tamp.Findings.Domain.Values.ScannerKind.TruffleHog },
            "iacSevere" => new HashSet<Tamp.Findings.Domain.Values.ScannerKind> { Tamp.Findings.Domain.Values.ScannerKind.Trivy },
            _ => new HashSet<Tamp.Findings.Domain.Values.ScannerKind>(),
        };
        return _receipts.Where(r => kinds.Contains(r.Scanner)).ToList();
    }

    private static string ScanKindLabel(string key) => key switch
    {
        "secrets" => "secret-detection",
        "iacSevere" => "IaC",
        _ => "static-analysis",
    };

    private static string ReceiptStatus(string status) => status switch
    {
        "Succeeded" => "✓ ran",
        "Failed" => "✕ failed",
        "Skipped" => "— skipped",
        _ => status,
    };

    // Contribution is points COST, so a fall (negative delta) is an improvement → green.
    private static string TrendColor(double delta) =>
        delta < -0.05 ? "var(--color-pass)" : delta > 0.05 ? "var(--color-critical)" : "var(--color-neutral-600)";

    private static string TrendArrow(double delta) =>
        delta < -0.05 ? "↓" : delta > 0.05 ? "↑" : "—";

    private static string Shorten(string path)
    {
        var parts = path.Replace('\\', '/').Split('/');
        return parts.Length <= 3 ? path : ".../" + string.Join('/', parts[^2..]);
    }

    private static string Short(string? sha) => sha is { Length: > 7 } ? sha[..7] : (sha ?? "—");

    // Download URL for a stored raw report — the read endpoint keys on componentVersionId for the
    // visibility boundary (TFND-209). The browser fetches the original .trx/junit bytes directly.
    private static string RawHref(Guid id, Guid cvId) => $"/raw-artifacts/{id}?componentVersionId={cvId}";

    private static string FormatDuration(double ms) =>
        ms >= 60_000 ? $"{ms / 60_000:F1} min" : ms >= 1_000 ? $"{ms / 1_000:F1} s" : $"{ms:F0} ms";

    private static string FormatBytes(long bytes) =>
        bytes >= 1_048_576 ? $"{bytes / 1_048_576.0:F1} MB" : bytes >= 1_024 ? $"{bytes / 1_024.0:F0} KB" : $"{bytes} B";

    private static string TierLabel(Tamp.Findings.Application.Risk.LicensePolicy.Tier t) => t switch
    {
        Tamp.Findings.Application.Risk.LicensePolicy.Tier.Permissive => "Permissive",
        Tamp.Findings.Application.Risk.LicensePolicy.Tier.WeakCopyleft => "Weak copyleft",
        Tamp.Findings.Application.Risk.LicensePolicy.Tier.StrongCopyleft => "Strong copyleft",
        Tamp.Findings.Application.Risk.LicensePolicy.Tier.Denied => "Denied",
        _ => "Unknown",
    };

    private static string TierTone(Tamp.Findings.Application.Risk.LicensePolicy.Tier t) => t switch
    {
        Tamp.Findings.Application.Risk.LicensePolicy.Tier.Permissive => "var(--color-pass)",
        Tamp.Findings.Application.Risk.LicensePolicy.Tier.WeakCopyleft => "var(--color-band-yellow)",
        Tamp.Findings.Application.Risk.LicensePolicy.Tier.StrongCopyleft => "var(--color-band-orange)",
        Tamp.Findings.Application.Risk.LicensePolicy.Tier.Denied => "var(--color-critical)",
        _ => "var(--color-medium)",
    };

    // Attest a license for an unresolved package. The write is global (TFND-222); it
    // changes the score, so we reload both the overview and the header afterward.
    private async Task ResolveLicenseAsync(string purl)
    {
        _resolveError = null;
        if (_project is null) return;
        var spdx = _resolveSpdx.GetValueOrDefault(purl, "").Trim();
        if (spdx.Length == 0) { _resolveError = $"Enter an SPDX id for {purl}."; return; }

        _resolveBusyPurl = purl;
        try
        {
            var actor = await Me.AtAsync(new ScopeTarget(_project.ClientId, _project.ProjectId));
            if (actor is null) { _resolveError = "You are not authorized to resolve licences."; return; }

            var res = await Licenses.ResolveAsync(actor, purl, spdx, _resolveNote.GetValueOrDefault(purl));
            if (!res.Success) { _resolveError = res.Error; return; }

            _resolveSpdx.Remove(purl);
            _resolveNote.Remove(purl);

            _licenseOverview = await CategoryFindings.LicenseOverviewAsync(_project.ProjectId, _commitSha);
            var sha = string.Equals(Sha, Routes.LatestBuild, StringComparison.OrdinalIgnoreCase) ? null : Sha;
            var data = await Hub.LoadAsync(_project, sha);
            _row = data?.Risk.Breakdown.FirstOrDefault(b => b.Key == Key);
        }
        finally
        {
            _resolveBusyPurl = null;
        }
    }

    // Pull the advisory-DB provenance out of the receipt notes ("db=grype-db/v6.1.9; db_built=…") into
    // a compact "grype-db/v6.1.9 · 2026-09-29". Falls back to the raw notes when it's not that shape.
    private static string? DbSummary(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes)) return null;
        string? Tok(string k) => notes.Split(';')
            .Select(s => s.Trim())
            .FirstOrDefault(s => s.StartsWith(k + "=", StringComparison.OrdinalIgnoreCase))?.Split('=', 2)[1];
        var db = Tok("db");
        var built = Tok("db_built");
        if (db is null && built is null)
            return notes.Length > 44 ? notes[..44] + "…" : notes;
        var when = built is not null && DateTimeOffset.TryParse(built, out var dt)
            ? dt.ToUniversalTime().ToString("yyyy-MM-dd") : built;
        return string.Join(" · ", new[] { db, when }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

