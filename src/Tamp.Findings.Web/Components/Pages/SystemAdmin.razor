@* Instance-level administration (TFND-110 … TFND-114).

   Outside any client or project scope, which is why the nav separates it and
   the tab strip marks it differently. Everything here affects every tenant on
   this deployment, and the heading says so on every panel.

   Named SystemAdmin, not System: a component's class name is its file name, and
   a class called System shadows the System NAMESPACE for every other file in
   the assembly — "@using System.Net.Http" then fails to resolve. *@
@page "/system"
@page "/system/{Panel}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RouteScope Scope
@inject NavigationManager Nav
@inject SystemAdminService Admin
@inject IdentityProviderService Providers
@inject ProviderSecretProtector Protector
@inject CurrentUser Me

<PageTitle>System — tamp.findings</PageTitle>

@if (Panel is not null && !SystemPanels.IsValid(Panel))
{
    <div class="stack">
        <h1>Unknown panel</h1>
        <Card>
            <p><code class="mono">@Panel</code> is not one of @KnownPanels.</p>
            <Button Variant="Button.ButtonVariant.Primary" OnClick="GoToUsers">
                Go to Users &amp; RBAC
            </Button>
        </Card>
    </div>
}
else
{
    <div class="stack">
        <div>
            <div class="kicker">Instance-wide · outside any client or project scope</div>
            <h1>System</h1>
            <p class="field__help">Changes here affect every tenant on this deployment.</p>
        </div>

        <div class="tabs settings-tabs">
            @foreach (var panel in SystemPanels.All)
            {
                <a class="tab tab--system @(panel == Current ? "tab--active" : null)"
                   href="@Routes.System(panel)">@PanelLabel(panel)</a>
            }
        </div>

        @if (_error is not null)
        {
            <Card>
                <div class="row">
                    <Chip Label="Unavailable" Tone="var(--color-high)" Style="Chip.ChipStyle.Solid" Glyph="!" />
                    <span>Could not load instance administration.</span>
                </div>
                <p class="field__help">
                    An empty user list would read as "nobody has access here", which is a claim this
                    screen cannot currently make. @_error
                </p>
            </Card>
        }
        else if (!_canAdminister.Allowed)
        {
            @* Read-only rather than hidden. Someone who cannot administer the
               instance can still legitimately need to see who has access. *@
            <Card>
                <div class="row" style="gap: var(--space-3)">
                    <Chip Label="READ ONLY" Tone="var(--color-neutral-500)" Style="Chip.ChipStyle.Outlined" />
                    <span>@_canAdminister.Reason</span>
                </div>
            </Card>
        }

        @if (_error is null)
        {
        @switch (Current)
        {
            case SystemPanels.Users:
                <Card Padded="false">
                    <div class="card-body">
                        <h2>Users &amp; RBAC</h2>
                        <p class="field__help">
                            Roles are ADDITIVE — a user holds any number and effective access is the
                            union. Assignments resolve at the NARROWEST tier holding anything, so a
                            project-level grant hides a client-level one entirely rather than adding
                            to it.
                        </p>
                    </div>

                    @if (_users.Count == 0)
                    {
                        <div class="card-body"><p class="muted">No users yet.</p></div>
                    }
                    else
                    {
                        <ScrollBox Label="Users">
                            <table class="table table--rows">
                                <thead>
                                    <tr>
                                        <th>User</th><th>State</th><th class="align-end">Roles</th>
                                        <th>Last seen</th><th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in _users)
                                    {
                                        <tr class="@(user.Id == _selectedUser ? "is-selected" : null)"
                                            @onclick="() => SelectUser(user.Id)">
                                            <td>
                                                <div>@user.DisplayName</div>
                                                <div class="mono muted" style="font-size: var(--text-secondary)">
                                                    @user.Login@(user.Email is { Length: > 0 } e ? $" · {e}" : "")
                                                </div>
                                            </td>
                                            <td>
                                                <span class="row" style="gap: var(--space-1)">
                                                    @if (!user.IsApproved)
                                                    {
                                                        <Chip Label="PENDING" Tone="var(--color-high)"
                                                              Style="Chip.ChipStyle.Solid" />
                                                    }
                                                    else if (user.IsAdmin)
                                                    {
                                                        <Chip Label="ADMIN" Tone="var(--color-accent)"
                                                              Style="Chip.ChipStyle.Solid" />
                                                    }
                                                    else if (user.AssignmentCount == 0)
                                                    {
                                                        @* A real state, not a gap: read access is
                                                           often exactly what someone should have. *@
                                                        <Chip Label="VIEWER" Tone="var(--color-neutral-500)"
                                                              Style="Chip.ChipStyle.Outlined" />
                                                    }
                                                    @if (user.HasSodConflict)
                                                    {
                                                        <Chip Label="SoD" Tone="var(--color-high)"
                                                              Style="Chip.ChipStyle.Outlined" />
                                                    }
                                                </span>
                                            </td>
                                            <td class="num align-end">@user.AssignmentCount</td>
                                            <td class="mono">
                                                @(user.LastLoginAt?.ToString("yyyy-MM-dd") ?? "never")
                                            </td>
                                            <td>
                                                @if (!user.IsApproved)
                                                {
                                                    <Button Variant="Button.ButtonVariant.Text" StopPropagation="true"
                                                            Disabled="@(!_canAdminister.Allowed)"
                                                            DisabledReason="@_canAdminister.Reason"
                                                            OnClick="() => Approve(user, true)">approve</Button>
                                                }
                                                else
                                                {
                                                    <Button Variant="Button.ButtonVariant.Text" StopPropagation="true"
                                                            Class="btn--danger"
                                                            Disabled="@(!_canAdminister.Allowed)"
                                                            DisabledReason="@_canAdminister.Reason"
                                                            OnClick="() => Approve(user, false)">suspend</Button>
                                                }
                                                <Button Variant="Button.ButtonVariant.Text" StopPropagation="true"
                                                        Disabled="@(!_canAdminister.Allowed)"
                                                        DisabledReason="@_canAdminister.Reason"
                                                        OnClick="() => SetAdmin(user, !user.IsAdmin)">
                                                    @(user.IsAdmin ? "remove admin" : "make admin")
                                                </Button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </ScrollBox>
                    }

                    @if (_actionError is not null)
                    {
                        <div class="card-body"><p style="color: var(--color-critical)">@_actionError</p></div>
                    }
                </Card>

                @if (_selectedUser is not null)
                {
                    <Card Padded="false">
                        <div class="card-body">
                            <h3>Role assignments</h3>
                            <p class="field__help">
                                Narrowest first — that is the tier that wins.
                            </p>
                        </div>
                        @if (_assignments.Count == 0)
                        {
                            <div class="card-body">
                                <p class="muted">No role assignments. This user is a Viewer everywhere.</p>
                            </div>
                        }
                        else
                        {
                            <ScrollBox Label="Role assignments">
                                <table class="table">
                                    <thead>
                                        <tr><th>Role</th><th>Tier</th><th>Scope</th><th>Granted</th><th>SoD</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var assignment in _assignments)
                                        {
                                            <tr>
                                                <td>@assignment.Role</td>
                                                <td>@assignment.Tier</td>
                                                <td>@assignment.ScopeName</td>
                                                <td class="mono">@assignment.CreatedAt.ToString("yyyy-MM-dd")</td>
                                                <td>
                                                    @if (assignment.SodConflict is { Length: > 0 } conflict)
                                                    {
                                                        @* Recorded at grant time so an assessor can
                                                           see it was a deliberate choice rather than
                                                           an oversight. *@
                                                        <span style="color: var(--color-high)">@conflict</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="muted">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    <Button Variant="Button.ButtonVariant.Text" Class="btn--danger"
                                                            Disabled="@(!_canAdminister.Allowed)"
                                                            DisabledReason="@_canAdminister.Reason"
                                                            OnClick="() => Revoke(assignment.Id)">revoke</Button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </ScrollBox>
                        }
                    </Card>
                }
                break;

            case SystemPanels.Authentication:
                <Card Padded="false">
                    <div class="card-body row row--between">
                        <div>
                            <h2>Identity providers</h2>
                            <p class="field__help">
                                Adding or disabling one takes effect immediately — the rows are the
                                source of truth and the running schemes are rebuilt from them, so
                                turning a provider off at 2am does not need a redeploy.
                            </p>
                        </div>
                        <Button Variant="Button.ButtonVariant.Primary"
                                Disabled="@(!_canAdminister.Allowed)" DisabledReason="@_canAdminister.Reason"
                                OnClick="StartNewProvider">Add provider</Button>
                    </div>

                    @if (_providers.Count == 0)
                    {
                        <div class="card-body">
                            <p style="color: var(--color-high)">No identity provider is configured.</p>
                            <p class="field__help">
                                Nobody can sign in through the registry. If this instance is still
                                running on the startup GitHub OAuth credentials, that path keeps
                                working — but it cannot be changed without a redeploy, which is what
                                this registry exists to fix.
                            </p>
                        </div>
                    }
                    else
                    {
                        <ScrollBox Label="Identity providers">
                            <table class="table table--rows">
                                <thead>
                                    <tr>
                                        <th>Provider</th><th>Kind</th><th>Scheme</th><th>State</th>
                                        <th class="align-end">Users</th><th>Last sign-in</th><th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var provider in _providers)
                                    {
                                        <tr>
                                            <td>
                                                <div>@provider.DisplayName</div>
                                                <div class="mono muted" style="font-size: var(--text-secondary)">
                                                    @provider.ClientId
                                                </div>
                                            </td>
                                            <td>@KindLabel(provider.Kind)</td>
                                            <td class="mono">@provider.Scheme</td>
                                            <td>
                                                <span class="row" style="gap: var(--space-1)">
                                                    @if (provider.Incomplete)
                                                    {
                                                        @* Worse than being off: the sign-in button is
                                                           there and the round-trip fails at the far
                                                           end, where the error is somebody else's. *@
                                                        <Chip Label="INCOMPLETE" Tone="var(--color-critical)"
                                                              Style="Chip.ChipStyle.Solid" />
                                                    }
                                                    else if (provider.Enabled)
                                                    {
                                                        <Chip Label="ENABLED" Tone="var(--color-pass)"
                                                              Style="Chip.ChipStyle.Outlined" />
                                                    }
                                                    else
                                                    {
                                                        <Chip Label="DISABLED" Tone="var(--color-neutral-500)"
                                                              Style="Chip.ChipStyle.Outlined" />
                                                    }
                                                    @if (provider.RequireMfa)
                                                    {
                                                        <Chip Label="MFA" Tone="var(--color-accent)"
                                                              Style="Chip.ChipStyle.Outlined" />
                                                    }
                                                </span>
                                            </td>
                                            <td class="num align-end">@provider.UserCount</td>
                                            <td class="mono">
                                                @if (provider.LastSignInAt is { } used)
                                                {
                                                    @used.ToString("yyyy-MM-dd")
                                                }
                                                else
                                                {
                                                    @* Redundant or broken, and both are worth seeing
                                                       before deciding it is safe to remove. *@
                                                    <span style="color: var(--color-high)">never</span>
                                                }
                                            </td>
                                            <td>
                                                <Button Variant="Button.ButtonVariant.Text"
                                                        Disabled="@(!_canAdminister.Allowed)"
                                                        DisabledReason="@_canAdminister.Reason"
                                                        OnClick="() => StartEditProvider(provider)">edit</Button>
                                                <Button Variant="Button.ButtonVariant.Text" Class="btn--danger"
                                                        Disabled="@(!_canAdminister.Allowed)"
                                                        DisabledReason="@_canAdminister.Reason"
                                                        OnClick="() => _deletingProvider = provider">remove</Button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </ScrollBox>
                    }

                    @if (_actionError is not null)
                    {
                        <div class="card-body"><p style="color: var(--color-critical)">@_actionError</p></div>
                    }
                </Card>

                <Card>
                    <h2>Sign-in policy</h2>

                    <TextField Label="Allowed email domains" Mono="true" @bind-Value="_allowedDomains"
                               Disabled="@(!_canAdminister.Allowed)"
                               Help="Space-separated bare domains. BLANK MEANS NO RESTRICTION, which is the honest default for a self-hosted instance behind a VPN. This gates REGISTRATION only — removing a domain never locks out someone who already has an account and roles." />

                    <div class="field">
                        <span class="field__label">Require MFA for</span>
                        <div class="row" style="gap: var(--space-2); flex-wrap: wrap">
                            @foreach (var role in MfaRoles)
                            {
                                <span @onclick="() => ToggleMfaRole(role)" style="cursor: pointer">
                                    <Chip Label="@role" Tone="var(--color-accent)"
                                          Style="@(_mfaRoles.Contains(role) ? Chip.ChipStyle.Solid : Chip.ChipStyle.Outlined)" />
                                </span>
                            }
                        </div>
                        <span class="field__help">
                            Enforced only where the provider can actually assert it — an OIDC issuer
                            returns <code class="mono">amr</code>, GitHub OAuth returns nothing of the
                            sort. A requirement a provider cannot satisfy would be a control that
                            silently does nothing, so the registry refuses to mark such a provider as
                            requiring MFA.
                        </span>
                    </div>

                    <div class="row" style="gap: var(--space-2); margin-top: var(--space-3)">
                        <Button Variant="Button.ButtonVariant.Primary"
                                Disabled="@(!_canAdminister.Allowed)" DisabledReason="@_canAdminister.Reason"
                                OnClick="SaveSignInPolicy">Save sign-in policy</Button>
                    </div>

                    @if (_policySaved)
                    {
                        <p style="color: var(--color-pass)">Saved.</p>
                    }

                    <dl class="stamp" style="margin-top: var(--space-4)">
                        <dt>New users default to</dt>
                        <dd>Viewer — read access, no role, pending approval</dd>
                        <dt>Session lifetime</dt>
                        <dd class="mono">@_settings.SessionLifetimeHours h — set on Instance settings</dd>
                        <dt>First-run admin</dt>
                        <dd>Claimed once, against the setup token printed at container start</dd>
                    </dl>
                </Card>
                break;

            case SystemPanels.Scanners:
                <Card Padded="false">
                    <div class="card-body row row--between">
                        <div>
                            <h2>Scanners &amp; ingest</h2>
                            <p class="field__help">
                                Marking a scanner EXPECTED is what makes "no scan" distinguishable from
                                "clean". Without it, a scanner that silently stopped reporting looks
                                exactly like one that was never in the pipeline.
                            </p>
                        </div>
                        <Button Variant="Button.ButtonVariant.Primary"
                                Disabled="@(!_canAdminister.Allowed || !_scannersDirty)"
                                DisabledReason="@(_canAdminister.Allowed ? "Nothing has changed." : _canAdminister.Reason)"
                                OnClick="SaveScanners">Save expectations</Button>
                    </div>
                    <ScrollBox Label="Scanners">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Expected</th><th>Scanner</th><th>Class</th>
                                    <th class="align-end">Runs</th><th>Last received</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var scanner in _scanners)
                                {
                                    var kind = scanner.Kind;
                                    <tr>
                                        <td>
                                            <input type="checkbox" checked="@_expected.Contains(kind)"
                                                   disabled="@(!_canAdminister.Allowed)"
                                                   @onchange="e => ToggleExpected(kind, e)" />
                                        </td>
                                        <td class="mono">@kind</td>
                                        <td>@scanner.Class</td>
                                        <td class="num align-end">@scanner.Runs</td>
                                        <td class="mono">
                                            @(scanner.LastReceived?.ToString("yyyy-MM-dd") ?? "never")
                                        </td>
                                        <td>
                                            @if (scanner.Silent)
                                            {
                                                <Chip Label="SILENT" Tone="var(--color-critical)"
                                                      Style="Chip.ChipStyle.Solid" />
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </ScrollBox>
                    @if (_actionError is not null)
                    {
                        <div class="card-body"><p style="color: var(--color-critical)">@_actionError</p></div>
                    }
                </Card>
                break;

            case SystemPanels.Settings:
                <Card>
                    <h2>Instance settings</h2>

                    <TextField Label="Instance URL" Mono="true" @bind-Value="_instanceUrl"
                               Disabled="@(!_canAdminister.Allowed)"
                               Help="How this deployment refers to itself in anything that leaves it. Inferred from the request when blank, which is wrong the moment a reverse proxy is involved." />

                    <TextField Label="Session lifetime (hours)" Type="number" Mono="true"
                               Disabled="@(!_canAdminister.Allowed)"
                               Value="@_sessionHours" ValueChanged="v => _sessionHours = v"
                               Help="How long a sign-in lasts." />

                    <TextField Label="Finding retention (days)" Type="number" Mono="true"
                               Disabled="@(!_canAdminister.Allowed)"
                               Value="@_findingRetention" ValueChanged="v => _findingRetention = v"
                               Help="Blank keeps findings forever — the honest default. An attestation signed three years ago cites findings from three years ago, and deleting them makes the signature unverifiable." />

                    <TextField Label="Build retention (days)" Type="number" Mono="true"
                               Disabled="@(!_canAdminister.Allowed)"
                               Value="@_buildRetention" ValueChanged="v => _buildRetention = v"
                               Help="Blank keeps builds forever." />

                    <TextField Label="Outbound SMTP host" Mono="true" @bind-Value="_smtpHost"
                               Disabled="@(!_canAdminister.Allowed)"
                               Help="Blank means no mail is sent at all — notifications are dropped rather than queued, and the product would rather say so than pretend." />

                    <div class="field">
                        <span class="field__label">GitHub App</span>
                        <span class="field__help">
                            Writes a check run back to the commit each ingest scans, so branch
                            protection can block a merge on a failing gate. The dashboard acts as
                            ITSELF here — a different identity from the OIDC providers above, with a
                            different credential and a different lifecycle.
                        </span>
                    </div>

                    <TextField Label="App id" Mono="true" @bind-Value="_githubAppId"
                               Disabled="@(!_canAdminister.Allowed)"
                               Help="The numeric id from the App's settings page. Public information — it is in the App's own URL." />

                    <TextField Label="App private key (PEM)" Multiline="true" Rows="3" Mono="true"
                               Disabled="@(!_canAdminister.Allowed)"
                               @bind-Value="_githubAppKey"
                               Help="@GitHubKeyHelp" />

                    <TextField Label="Check name" Mono="true" @bind-Value="_githubCheckName"
                               Disabled="@(!_canAdminister.Allowed)"
                               Help="What the check is called on the commit. Branch protection rules are written against this name, so an operator who has already written one should not have to rewrite it." />

                    <CheckField Label="Publish check runs" @bind-Checked="_githubEnabled"
                                Disabled="@(!_canAdminister.Allowed)" />
                    <p class="field__help">
                        Separate from having credentials, so an operator rotating a key or chasing a
                        noisy check can stop publishing without destroying the configuration. A
                        project only gets checks once its GitHub repository is set on its own
                        settings.
                    </p>

                    <CheckField Label="Serve the MCP endpoint" @bind-Checked="_mcpEnabled"
                                Disabled="@(!_canAdminister.Allowed)" />
                    <p class="field__help">
                        Off by default. On, agents holding a token can READ findings in their scope
                        at <code class="mono">/mcp</code> — they can never write. This is the kill
                        switch: turning it off closes the door in one action without revoking
                        anything, so the instance comes back the way it was rather than forcing a
                        re-issue to every agent. Tokens are minted per project under
                        <strong>Agent access</strong> on that project's settings.
                    </p>

                    <CheckField Label="Enforce separation of duties"
                                Disabled="@(!_canAdminister.Allowed)"
                                @bind-Checked="_enforceSod" />
                    <p class="field__help">
                        Off by default, deliberately: a three-person team genuinely needs one person to
                        hold two conflicting roles, and refusing by default would make the product
                        unusable for exactly the organisation it is aimed at. On, the advisory becomes
                        a refusal.
                    </p>

                    <div class="row" style="gap: var(--space-2); margin-top: var(--space-3)">
                        <Button Variant="Button.ButtonVariant.Primary"
                                Disabled="@(!_canAdminister.Allowed)" DisabledReason="@_canAdminister.Reason"
                                OnClick="SaveSettings">Save settings</Button>
                    </div>

                    @if (_actionError is not null)
                    {
                        <p style="color: var(--color-critical)">@_actionError</p>
                    }
                    @if (_settingsSaved)
                    {
                        <p style="color: var(--color-pass)">Saved.</p>
                    }

                    <dl class="stamp" style="margin-top: var(--space-4)">
                        <dt>Telemetry</dt>
                        @* Not a preference. A compliance tool that phoned home
                           would be reporting its customers' security posture to
                           a third party. *@
                        <dd>Off. Self-hosted means self-hosted — there is no switch.</dd>
                        <dt>Version</dt>
                        <dd class="mono">@_version</dd>
                    </dl>
                </Card>
                break;

            case SystemPanels.Audit:
                <Card Padded="false">
                    <div class="card-body row row--between">
                        <div>
                            <h2>Audit log</h2>
                            <p class="field__help">
                                Append-only. Risk acceptance, role grants and key changes are what an
                                assessor reads first, which is why they are classes rather than search
                                terms.
                            </p>
                        </div>
                        <div class="row" style="gap: var(--space-2)">
                            @foreach (var filter in AuditFilters)
                            {
                                <span @onclick="() => SetAuditFilter(filter.Key)" style="cursor: pointer">
                                    <Chip Label="@filter.Value" Tone="@AuditTone(filter.Key)"
                                          Style="@(_auditFilter == filter.Key ? Chip.ChipStyle.Solid : Chip.ChipStyle.Outlined)" />
                                </span>
                            }
                        </div>
                    </div>

                    @if (_audit.Count == 0)
                    {
                        <div class="card-body">
                            <p class="muted">Nothing recorded@(_auditFilter is null ? "" : " in this class").</p>
                        </div>
                    }
                    else
                    {
                        <ScrollBox Label="Audit log">
                            <table class="table">
                                <thead>
                                    <tr><th>When</th><th>Actor</th><th>Action</th><th>Scope</th><th>Class</th><th>Detail</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in _audit)
                                    {
                                        <tr>
                                            <td class="mono">@entry.At.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>
                                                @entry.ActorLogin
                                                @if (entry.ActorWasAdmin)
                                                {
                                                    <span class="muted"> (admin)</span>
                                                }
                                                else if (entry.ActorRole is { } role)
                                                {
                                                    <span class="muted"> (@role)</span>
                                                }
                                            </td>
                                            <td class="mono">@entry.Action</td>
                                            <td>@entry.Scope</td>
                                            <td>
                                                <Chip Label="@entry.Class.ToString().ToLowerInvariant()"
                                                      Tone="@AuditTone(entry.Class)"
                                                      Style="Chip.ChipStyle.Outlined" />
                                            </td>
                                            <td class="muted" style="font-size: var(--text-secondary)">@entry.Detail</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </ScrollBox>
                    }
                </Card>
                break;
        }
        }
    </div>
}

<Dialog Open="_editingProvider" OpenChanged="v => _editingProvider = v"
        Title="@(_providerId is null ? "Add identity provider" : "Edit identity provider")" Width="720">
    <ChildContent>
        <div class="field">
            <span class="field__label">Kind</span>
            <div class="row" style="gap: var(--space-2)">
                @foreach (var kind in Enum.GetValues<IdentityProviderKind>())
                {
                    <span @onclick="() => SetKind(kind)" style="cursor: pointer">
                        <Chip Label="@KindLabel(kind)" Tone="var(--color-accent)"
                              Style="@(_draftKind == kind ? Chip.ChipStyle.Solid : Chip.ChipStyle.Outlined)" />
                    </span>
                }
            </div>
            <span class="field__help">
                Anything that is not GitHub should be OIDC — discovery means one handler covers Entra,
                Okta, Keycloak and Auth0. OAuth 2.0 on its own says nothing about identity, so every
                non-OIDC provider would need its own hand-written profile mapping.
            </span>
        </div>

        <TextField Label="Display name" @bind-Value="_draftName"
                   Help="What the sign-in button says." />

        <TextField Label="Scheme" Mono="true" @bind-Value="_draftScheme"
                   Disabled="@(_providerId is not null)"
                   Help="URL-safe, and IMMUTABLE once saved — it is in the callback URL registered with the provider at the far end and in every bookmark." />

        @if (_draftScheme is { Length: > 0 })
        {
            <p class="field__help mono">
                Callback URL: @($"{_instanceOrigin}/auth/{_draftScheme}/callback")
            </p>
        }

        @if (_draftKind == IdentityProviderKind.Oidc)
        {
            <TextField Label="Authority" Mono="true" @bind-Value="_draftAuthority"
                       Help="The issuer URL. Discovery reads the endpoints from {authority}/.well-known/openid-configuration, and it must be https — discovery over http would expose the token endpoint to whoever is in between." />
        }

        <TextField Label="Client id" Mono="true" @bind-Value="_draftClientId" />

        <TextField Label="Client secret" Type="password" Mono="true" @bind-Value="_draftSecret"
                   Help="@SecretHelp" />

        <TextField Label="Extra scopes" Mono="true" @bind-Value="_draftScopes"
                   Help="Space-separated, on top of the defaults. OIDC always requests openid, profile and email." />

        <CheckField Label="Enabled" @bind-Checked="_draftEnabled" />
        <CheckField Label="Require an MFA assertion" @bind-Checked="_draftRequireMfa"
                    Disabled="@(!IdentityProviderService.CanAssertMfa(_draftKind))" />
        @if (!IdentityProviderService.CanAssertMfa(_draftKind))
        {
            <p class="field__help">
                @KindLabel(_draftKind) cannot assert MFA, so requiring it here would be a control that
                does nothing. Enforce it at the provider instead.
            </p>
        }

        @if (_providerError is not null)
        {
            <p style="color: var(--color-critical)">@_providerError</p>
        }
    </ChildContent>
    <Footer>
        <Button Variant="Button.ButtonVariant.Primary" OnClick="SaveProvider">Save provider</Button>
        <Button OnClick="() => _editingProvider = false">Cancel</Button>
        <span class="field__help">Writes an access-class audit entry.</span>
    </Footer>
</Dialog>

<Dialog Open="_deletingProvider is not null" OpenChanged="v => { if (!v) _deletingProvider = null; }"
        Title="Remove identity provider" Width="620">
    <ChildContent>
        @if (_deletingProvider is { } target)
        {
            <p>Remove <strong>@target.DisplayName</strong>?</p>
            <p class="field__help">
                Anyone who signs in through it loses their way in immediately. If the goal is a pause
                rather than a removal, DISABLE it instead — a disabled provider keeps its
                configuration, so turning it back on does not mean re-entering a client secret.
            </p>
            @if (target.UserCount > 0)
            {
                <p style="color: var(--color-high)">
                    @target.UserCount user@(target.UserCount == 1 ? "" : "s") currently sign in through
                    this provider. Their accounts and roles survive; their ability to authenticate does
                    not.
                </p>
            }
            @if (_actionError is not null)
            {
                <p style="color: var(--color-critical)">@_actionError</p>
            }
        }
    </ChildContent>
    <Footer>
        <Button Variant="Button.ButtonVariant.Danger" OnClick="DeleteProvider">Remove permanently</Button>
        <Button OnClick="() => _deletingProvider = null">Cancel</Button>
    </Footer>
</Dialog>

@code {
    [Parameter] public string? Panel { get; set; }

    private static readonly string KnownPanels = string.Join(", ", SystemPanels.All);

    private static readonly KeyValuePair<AuditClass?, string>[] AuditFilters =
    [
        new(null, "all"),
        new(AuditClass.Risk, "risk"),
        new(AuditClass.Access, "access"),
        new(AuditClass.Other, "other"),
    ];

    private string Current => Panel ?? SystemPanels.Users;

    private AuthorizationDecision _canAdminister = AuthorizationDecision.Deny("Checking…");
    private string? _error, _actionError;

    private IReadOnlyList<UserRow> _users = [];
    private IReadOnlyList<AssignmentRow> _assignments = [];
    private Guid? _selectedUser;

    private IReadOnlyList<ScannerRow> _scanners = [];
    private HashSet<ScannerKind> _expected = [];
    private bool _scannersDirty;

    private InstanceSettings _settings = new();
    private string? _instanceUrl, _sessionHours, _findingRetention, _buildRetention, _smtpHost;
    private string? _githubAppId, _githubAppKey, _githubCheckName;
    private bool _githubEnabled;
    private bool _mcpEnabled;
    private bool _enforceSod, _settingsSaved;

    private IReadOnlyList<ProviderRow> _providers = [];
    private ProviderRow? _deletingProvider;
    private bool _editingProvider, _policySaved;
    private Guid? _providerId;
    private string? _draftName, _draftScheme, _draftClientId, _draftSecret, _draftAuthority,
                    _draftScopes, _providerError;
    private IdentityProviderKind _draftKind = IdentityProviderKind.Oidc;
    private bool _draftEnabled = true, _draftRequireMfa;
    private string _instanceOrigin = "";

    private string? _allowedDomains;
    private readonly HashSet<string> _mfaRoles = new(StringComparer.OrdinalIgnoreCase);

    // "Admin" is the instance flag, not a ProjectRole — the same distinction
    // the RBAC panel makes, and the reason it is a literal here.
    private static readonly string[] MfaRoles =
        ["Admin", .. Enum.GetNames<ProjectRole>()];

    private IReadOnlyList<AuditRow> _audit = [];
    private AuditClass? _auditFilter;

    private static readonly string _version =
        typeof(SystemAdminService).Assembly.GetName().Version?.ToString() ?? "unknown";

    protected override async Task OnParametersSetAsync()
    {
        Scope.Clear();
        _error = null;

        if (Panel is not null && !SystemPanels.IsValid(Panel)) return;

        try
        {
            // Instance scope: only the admin flag grants anything here, because
            // every ProjectRoleAssignment is scoped to at least a client.
            _canAdminister = await Me.CanAsync(Capability.AssignRoles, ScopeTarget.Instance);
            _settings = await Admin.SettingsAsync();

            switch (Current)
            {
                case SystemPanels.Users:
                    _users = await Admin.UsersAsync();
                    if (_selectedUser is { } id) _assignments = await Admin.AssignmentsAsync(id);
                    break;

                case SystemPanels.Scanners:
                    _scanners = await Admin.ScannersAsync(DateTimeOffset.UtcNow);
                    if (!_scannersDirty)
                    {
                        _expected = _scanners.Where(s => s.Expected).Select(s => s.Kind).ToHashSet();
                    }
                    break;

                case SystemPanels.Settings:
                    _instanceUrl = _settings.InstanceUrl;
                    _sessionHours = _settings.SessionLifetimeHours.ToString();
                    _findingRetention = _settings.FindingRetentionDays?.ToString();
                    _buildRetention = _settings.BuildRetentionDays?.ToString();
                    _smtpHost = _settings.SmtpHost;
                    _enforceSod = _settings.EnforceSeparationOfDuties;
                    _githubAppId = _settings.GitHubAppId;
                    _githubCheckName = _settings.GitHubCheckName;
                    _githubEnabled = _settings.GitHubChecksEnabled;
                    _mcpEnabled = _settings.McpEnabled;
                    // Never populated. A field that is sometimes the real key
                    // and sometimes a placeholder is how one gets logged.
                    _githubAppKey = null;
                    break;

                case SystemPanels.Authentication:
                    _providers = await Providers.ListAsync();
                    _instanceOrigin = _settings.InstanceUrl?.TrimEnd('/')
                        ?? new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
                    _allowedDomains = string.Join(' ', _settings.AllowedEmailDomains);
                    _mfaRoles.Clear();
                    foreach (var role in _settings.MfaRequiredRoles) _mfaRoles.Add(role);
                    break;

                case SystemPanels.Audit:
                    _audit = await Admin.AuditAsync(_auditFilter);
                    break;
            }
        }
        catch (Exception ex)
        {
            _error = ex.GetType().Name;
        }
    }

    private void GoToUsers() => Nav.NavigateTo(Routes.System());

    private static string PanelLabel(string panel) => panel switch
    {
        SystemPanels.Users => "Users & RBAC",
        SystemPanels.Authentication => "Authentication",
        SystemPanels.Scanners => "Scanners & ingest",
        SystemPanels.Settings => "Instance settings",
        _ => "Audit log",
    };

    private async Task SelectUser(Guid id)
    {
        _selectedUser = _selectedUser == id ? null : id;
        _assignments = _selectedUser is { } selected
            ? await Admin.AssignmentsAsync(selected)
            : [];
    }

    private async Task Approve(UserRow user, bool approved)
    {
        _actionError = null;
        var actor = await Me.AtAsync(ScopeTarget.Instance);
        if (actor is null) { _actionError = "You are not signed in."; return; }

        var result = await Admin.ApproveAsync(actor, user.Id, approved);
        if (!result.Success) { _actionError = result.Error; return; }

        _users = await Admin.UsersAsync();
    }

    private async Task SetAdmin(UserRow user, bool isAdmin)
    {
        _actionError = null;
        var actor = await Me.AtAsync(ScopeTarget.Instance);
        if (actor is null) { _actionError = "You are not signed in."; return; }

        var result = await Admin.SetAdminAsync(actor, user.Id, isAdmin);
        if (!result.Success) { _actionError = result.Error; return; }

        _users = await Admin.UsersAsync();
    }

    private async Task Revoke(Guid assignmentId)
    {
        _actionError = null;
        var actor = await Me.AtAsync(ScopeTarget.Instance);
        if (actor is null) { _actionError = "You are not signed in."; return; }

        var result = await Admin.RevokeAsync(actor, assignmentId);
        if (!result.Success) { _actionError = result.Error; return; }

        _users = await Admin.UsersAsync();
        if (_selectedUser is { } id) _assignments = await Admin.AssignmentsAsync(id);
    }

    private void ToggleExpected(ScannerKind kind, ChangeEventArgs e)
    {
        if (e.Value is true) _expected.Add(kind); else _expected.Remove(kind);
        _scannersDirty = true;
    }

    private async Task SaveScanners()
    {
        _actionError = null;
        var actor = await Me.AtAsync(ScopeTarget.Instance);
        if (actor is null) { _actionError = "You are not signed in."; return; }

        var result = await Admin.SetExpectedScannersAsync(actor, _expected.ToArray());
        if (!result.Success) { _actionError = result.Error; return; }

        _scannersDirty = false;
        _scanners = await Admin.ScannersAsync(DateTimeOffset.UtcNow);
    }

    private async Task SaveSettings()
    {
        _actionError = null;
        _settingsSaved = false;

        var actor = await Me.AtAsync(ScopeTarget.Instance);
        if (actor is null) { _actionError = "You are not signed in."; return; }

        var proposed = new InstanceSettings
        {
            InstanceUrl = _instanceUrl,
            SessionLifetimeHours = int.TryParse(_sessionHours, out var hours) ? hours : 0,
            FindingRetentionDays = int.TryParse(_findingRetention, out var findings) ? findings : null,
            BuildRetentionDays = int.TryParse(_buildRetention, out var builds) ? builds : null,
            SmtpHost = _smtpHost,
            SmtpPort = _settings.SmtpPort,
            SmtpFrom = _settings.SmtpFrom,
            EnforceSeparationOfDuties = _enforceSod,
            GitHubAppId = _githubAppId,
            // Non-nullable on the entity: an empty check name would make branch
            // protection rules match nothing.
            GitHubCheckName = string.IsNullOrWhiteSpace(_githubCheckName)
                ? "tamp.findings"
                : _githubCheckName.Trim(),
            GitHubChecksEnabled = _githubEnabled,
            McpEnabled = _mcpEnabled,
            // Protected here rather than in the service, so the plaintext never
            // travels further than the form that collected it. A blank field
            // keeps whatever is stored.
            GitHubAppPrivateKeyProtected = string.IsNullOrWhiteSpace(_githubAppKey)
                ? _settings.GitHubAppPrivateKeyProtected
                : Protector.Protect(ProviderSecretProtector.GitHubAppPurpose, _githubAppKey.Trim()),
        };

        var result = await Admin.SaveSettingsAsync(actor, proposed);
        if (!result.Success) { _actionError = result.Error; return; }

        _settingsSaved = true;
        _settings = await Admin.SettingsAsync();
    }

    private async Task SetAuditFilter(AuditClass? @class)
    {
        _auditFilter = @class;
        _audit = await Admin.AuditAsync(@class);
    }

    private string GitHubKeyHelp => _settings.GitHubAppPrivateKeyProtected is { Length: > 0 }
        ? "A key is stored. Leave blank to keep it; paste a new one to rotate."
        : "The .pem GitHub generated when the App was created. Encrypted at rest and never shown again.";

    private static string KindLabel(IdentityProviderKind kind) =>
        kind == IdentityProviderKind.GitHubOAuth ? "GitHub OAuth" : "OIDC";

    private string SecretHelp => _providerId is null
        ? "Encrypted at rest and never shown again — not even back to this form."
        : "Leave blank to keep the stored secret. Renaming a provider should not require re-typing a secret you may no longer have.";

    private void SetKind(IdentityProviderKind kind)
    {
        _draftKind = kind;
        // A kind that cannot assert MFA cannot carry the requirement, so clear
        // it rather than leaving a checked box the save would refuse.
        if (!IdentityProviderService.CanAssertMfa(kind)) _draftRequireMfa = false;
    }

    private void StartNewProvider()
    {
        _providerId = null;
        _draftKind = IdentityProviderKind.Oidc;
        _draftName = _draftScheme = _draftClientId = _draftSecret = _draftAuthority = _draftScopes = null;
        _draftEnabled = true;
        _draftRequireMfa = false;
        _providerError = null;
        _editingProvider = true;
    }

    private void StartEditProvider(ProviderRow provider)
    {
        _providerId = provider.Id;
        _draftKind = provider.Kind;
        _draftName = provider.DisplayName;
        _draftScheme = provider.Scheme;
        _draftClientId = provider.ClientId;
        _draftAuthority = provider.Authority;
        _draftScopes = provider.Scopes;
        _draftEnabled = provider.Enabled;
        _draftRequireMfa = provider.RequireMfa;
        // Never populated, in any form. A field that is sometimes the real
        // secret and sometimes a placeholder is how one gets logged.
        _draftSecret = null;
        _providerError = null;
        _editingProvider = true;
    }

    private async Task SaveProvider()
    {
        _providerError = null;

        var actor = await Me.AtAsync(ScopeTarget.Instance);
        if (actor is null) { _providerError = "You are not signed in."; return; }

        var draft = new ProviderDraft(
            _draftKind, _draftScheme ?? "", _draftName ?? "", _draftClientId ?? "",
            _draftSecret, _draftAuthority, _draftScopes, _draftEnabled, _draftRequireMfa);

        var result = await Providers.SaveAsync(actor, _providerId, draft);
        if (!result.Success) { _providerError = result.Error; return; }

        _editingProvider = false;
        _draftSecret = null;
        _providers = await Providers.ListAsync();
    }

    private async Task DeleteProvider()
    {
        if (_deletingProvider is not { } target) return;
        _actionError = null;

        var actor = await Me.AtAsync(ScopeTarget.Instance);
        if (actor is null) { _actionError = "You are not signed in."; return; }

        var result = await Providers.DeleteAsync(actor, target.Id);
        if (!result.Success) { _actionError = result.Error; return; }

        _deletingProvider = null;
        _providers = await Providers.ListAsync();
    }

    private void ToggleMfaRole(string role)
    {
        if (!_mfaRoles.Add(role)) _mfaRoles.Remove(role);
    }

    private async Task SaveSignInPolicy()
    {
        _actionError = null;
        _policySaved = false;

        var actor = await Me.AtAsync(ScopeTarget.Instance);
        if (actor is null) { _actionError = "You are not signed in."; return; }

        var settings = await Admin.SettingsAsync();
        settings.AllowedEmailDomains = (_allowedDomains ?? "")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(d => d.TrimStart('@').ToLowerInvariant())
            .Distinct()
            .ToList();
        settings.MfaRequiredRoles = _mfaRoles.OrderBy(r => r, StringComparer.Ordinal).ToList();

        var result = await Admin.SaveSettingsAsync(actor, settings);
        if (!result.Success) { _actionError = result.Error; return; }

        _policySaved = true;
        _settings = await Admin.SettingsAsync();
    }

    private static string AuditTone(AuditClass? @class) => @class switch
    {
        AuditClass.Risk => "var(--color-high)",
        AuditClass.Access => "var(--color-accent)",
        AuditClass.Other => "var(--color-neutral-500)",
        _ => "var(--color-neutral-600)",
    };
}
