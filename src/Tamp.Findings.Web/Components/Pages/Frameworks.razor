@page "/system/frameworks"
@attribute [Authorize]
@rendermode InteractiveServer
@inject Tamp.Findings.Application.Compliance.ControlCatalogQuery Catalog
@inject Tamp.Findings.Application.Compliance.Oscal.ControlCatalogImportService Importer
@inject CurrentUser Me
@using Tamp.Findings.Domain.Compliance
@using Tamp.Findings.Domain.Entities
@using Tamp.Findings.Application.Compliance
@using Tamp.Findings.Web.Components.Compliance
@using Tamp.Findings.Application.Compliance.Oscal
@using Microsoft.AspNetCore.Components.Forms

@* System → Control frameworks (v3 §6): the imported control catalog, the
   frameworks built from it, and a browser into any control's statement. *@

<PageTitle>Control frameworks — tamp.findings</PageTitle>

<div class="stack">
    <nav class="crumbs">
        <a href="@Routes.Portfolio">Portfolio</a>
        <span class="crumbs__sep">/</span>
        <span>Control frameworks</span>
    </nav>
    <div class="cathero">
        <div>
            <h1>Control frameworks</h1>
            <div class="muted">The control catalog and the frameworks projects are held to (ADR — v3 §6).</div>
        </div>
    </div>

    @if (_loading)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        @if (_summary is { } s)
        {
            <Card>
                <div class="kicker">Control catalog</div>
                <div class="row" style="justify-content: space-between; flex-wrap: wrap; gap: 12px">
                    <div>
                        <div><strong>@s.Name</strong></div>
                        <div class="field__help mono">@s.Source · @s.ControlCount controls@(s.OscalVersion is { } v ? $" · OSCAL {v}" : "")</div>
                        <div class="field__help">Imported @s.ImportedAt.ToString("yyyy-MM-dd")@(s.PriorVersions > 0 ? $" · {s.PriorVersions} prior version{(s.PriorVersions == 1 ? "" : "s")} retained" : "")</div>
                    </div>
                    <div class="row">
                        @* Fetching from usnistgov would need outbound network access, and the
                           instance this is built for is explicitly allowed to be air-gapped
                           (v3 §6). Honest disabled reason rather than the stale one this
                           carried, which promised the ticket that has now shipped. *@
                        <button class="btn" disabled
                                title="Needs outbound access to usnistgov/oscal-content. Download the catalog and use Import file instead.">
                            Check for update
                        </button>
                        <Button Disabled="@(!_canImport.Allowed)" DisabledReason="@_canImport.Reason"
                                OnClick="() => { _importError = null; _importResult = null; _importing = true; }">
                            Import file…
                        </Button>
                    </div>
                </div>
            </Card>
        }
        else
        {
            <NotScanned Message="No control catalog has been imported." />
        }

        <Card Padded="false">
            <ScrollBox Label="Frameworks">
                <table class="table table--rows">
                    <thead><tr><th>Framework</th><th>Provenance</th><th class="align-end">Controls</th><th>Parameters</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var f in _frameworks)
                        {
                            <tr>
                                <td><div>@f.Name</div><div class="mono muted cat__rule">@f.Version</div></td>
                                <td>
                                    <span class="ctlpanel__base @KindClass(f.Kind)">@KindLabel(f.Kind)</span>
                                    <span class="field__help">@f.Source</span>
                                </td>
                                <td class="mono align-end">@f.ControlCountLabel</td>
                                <td class="mono muted">@f.ParamsLabel</td>
                                <td class="mono">@(f.Status == FrameworkStatus.Current ? "current" : "draft")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </ScrollBox>
        </Card>

        <Card>
            <div class="kicker">Controls</div>
            <p class="field__help">@_controls.Count controls across @Families.Count families. Pick a family or search, then click a control to read its statement.</p>
            <div class="row" style="gap: 10px; flex-wrap: wrap; margin-bottom: 8px">
                <select class="mono" @bind="_family" @bind:after="() => _selected = null">
                    @foreach (var fam in Families)
                    {
                        <option value="@fam">@fam</option>
                    }
                </select>
                <input class="mono" style="min-width: 12rem" placeholder="filter id or title…" @bind="_search" @bind:event="oninput" />
            </div>
            <div class="row" style="flex-wrap: wrap; gap: 6px">
                @foreach (var c in ShownControls)
                {
                    <button class="ctlchip mono @(_selected?.Id == c.Id ? "ctlchip--sel" : null)" @onclick="() => _selected = c" title="@c.Title">@c.Id</button>
                }
                @if (ShownControls.Count == 0)
                {
                    <span class="muted">No control matches.</span>
                }
            </div>
        </Card>

        @if (_selected is { } sel)
        {
            <ControlStatementPanel Control="sel" />
        }
    }
</div>


<Dialog Open="_importing" OpenChanged="v => _importing = v" Title="Import control catalog" Width="680">
    <ChildContent>
        <p class="field__help">
            An OSCAL catalog (JSON) becomes the new current catalog. The one it replaces is
            kept, because an attestation cites the catalog version it was signed against.
            Re-importing the same file changes nothing.
        </p>

        <label class="field">
            <span class="field__label">Catalog · OSCAL JSON (required)</span>
            <InputFile class="field__input" accept=".json,application/json"
                       OnChange="e => _catalogFile = e.File" />
        </label>

        <p class="field__help" style="margin-top: var(--space-3)">
            Baseline profiles are optional and each one is a separate OSCAL profile. Without
            them the catalog still carries every control and parameter, but <strong>no control
            claims membership of Low, Moderate or High</strong> — membership is read from the
            profiles rather than guessed.
        </p>

        @foreach (var level in new[] { BaselineLevel.Low, BaselineLevel.Moderate, BaselineLevel.High })
        {
            <label class="field">
                <span class="field__label">@level baseline profile (optional)</span>
                <InputFile class="field__input" accept=".json,application/json"
                           OnChange="e => Pick(level, e.File)" />
            </label>
        }

        @if (_importError is not null)
        {
            <p style="color: var(--color-critical)">@_importError</p>
        }
        @if (_importResult is { } r)
        {
            <Card>
                @if (r.Unchanged)
                {
                    <p><strong>Nothing changed.</strong> That file is identical to the current catalog.</p>
                }
                else
                {
                    <p><strong>@r.Name</strong> imported.</p>
                    <dl class="stamp">
                        <dt>Controls</dt><dd class="num">@r.Controls</dd>
                        <dt>Parameters</dt><dd class="num">@r.Parameters</dd>
                        <dt>Low / Moderate / High</dt><dd class="num">@r.Low / @r.Moderate / @r.High</dd>
                        <dt>OSCAL</dt><dd class="mono">@(r.OscalVersion ?? "—")</dd>
                        <dt>sha256</dt><dd class="mono">@r.Sha[..12]</dd>
                    </dl>
                }
            </Card>
        }
    </ChildContent>
    <Footer>
        <Button Variant="Button.ButtonVariant.Primary"
                Disabled="@(_busy || _catalogFile is null)"
                DisabledReason="Choose a catalog file first."
                OnClick="Import">
            @(_busy ? "Importing…" : "Import")
        </Button>
        <Button OnClick="() => _importing = false">Close</Button>
    </Footer>
</Dialog>

@code {
    private bool _loading = true;
    private AuthorizationDecision _canImport = AuthorizationDecision.Deny("Checking…");
    private bool _importing;
    private bool _busy;
    private string? _importError;
    private CatalogImportOutcome? _importResult;
    private IBrowserFile? _catalogFile;
    private readonly Dictionary<BaselineLevel, IBrowserFile> _profileFiles = [];
    private CatalogSummary? _summary;
    private IReadOnlyList<Framework> _frameworks = [];
    private IReadOnlyList<Control> _controls = [];
    private Control? _selected;
    private string _family = "";
    private string _search = "";

    // The families in catalog order (controls arrive grouped by family).
    private IReadOnlyList<string> Families => _controls.Select(c => c.Family).Distinct().ToArray();

    // A search spans the whole catalog; otherwise the chosen family. Capped so a
    // broad match never renders thousands of chips.
    private IReadOnlyList<Control> ShownControls
    {
        get
        {
            IEnumerable<Control> q = _controls;
            if (!string.IsNullOrWhiteSpace(_search))
                q = q.Where(c => c.Id.Contains(_search, StringComparison.OrdinalIgnoreCase)
                              || c.Title.Contains(_search, StringComparison.OrdinalIgnoreCase));
            else if (!string.IsNullOrEmpty(_family))
                q = q.Where(c => c.Family == _family);
            return q.Take(400).ToArray();
        }
    }


    private void Pick(BaselineLevel level, IBrowserFile file) => _profileFiles[level] = file;

    private async Task Import()
    {
        if (_busy || _catalogFile is null) return;
        _busy = true;
        _importError = null;
        _importResult = null;

        var opened = new List<Stream>();
        try
        {
            var actor = await Me.AtAsync(ScopeTarget.Instance);
            if (actor is null) { _importError = "You are not signed in."; return; }

            var profiles = new Dictionary<BaselineLevel, Stream>();
            foreach (var (level, file) in _profileFiles)
            {
                var s = file.OpenReadStream(ControlCatalogImportService.MaxBytes);
                opened.Add(s);
                profiles[level] = s;
            }

            await using var catalog = _catalogFile.OpenReadStream(ControlCatalogImportService.MaxBytes);

            var result = await Importer.ImportAsync(
                actor, catalog, profiles, $"Uploaded · {_catalogFile.Name}");

            if (!result.Success) { _importError = result.Error; return; }
            _importResult = result.Value;

            // Re-read rather than patch the fields: the import may have retired a prior
            // catalog and changed the control set the browser below is showing.
            await Reload();
        }
        catch (Exception ex)
        {
            _importError = ex.Message;
        }
        finally
        {
            foreach (var s in opened) await s.DisposeAsync();
            _busy = false;
        }
    }

    private async Task Reload()
    {
        _summary = await Catalog.CurrentCatalogAsync();
        _frameworks = await Catalog.FrameworksAsync();
        _controls = await Catalog.ControlsAsync();
        _selected = _controls.FirstOrDefault(c => c.Id == _selected?.Id) ?? _controls.FirstOrDefault();
        _family = _selected?.Family ?? Families.FirstOrDefault() ?? "";
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _canImport = await Me.CanAsync(Capability.EditPolicyWeights, ScopeTarget.Instance);
            _summary = await Catalog.CurrentCatalogAsync();
            _frameworks = await Catalog.FrameworksAsync();
            _controls = await Catalog.ControlsAsync();
            _selected = _controls.FirstOrDefault(c => c.Id == "CM-6") ?? _controls.FirstOrDefault();
            _family = _selected?.Family ?? Families.FirstOrDefault() ?? "";
        }
        catch { }
        _loading = false;
    }

    private static string KindLabel(FrameworkKind k) => k switch
    {
        FrameworkKind.Oscal => "OSCAL import", FrameworkKind.Curated => "Curated", FrameworkKind.Overlay => "Overlay", _ => k.ToString(),
    };
    private static string KindClass(FrameworkKind k) => k switch
    {
        FrameworkKind.Oscal => "ctlpanel__base--in", FrameworkKind.Curated => "ctlpanel__base--dash", _ => "ctlpanel__base--ovl",
    };
}
