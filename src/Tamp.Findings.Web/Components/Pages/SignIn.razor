@* Sign-in.

   Static SSR on purpose: this page should not need a circuit to show someone a
   button. It is also the page most likely to be reached by someone whose
   session has just expired, so the less machinery between the request and the
   rendered page, the better.

   Anonymous by necessity — it is the page that exists to stop people being
   anonymous. *@
@page "/signin"
@attribute [AllowAnonymous]
@layout SignInLayout
@inject NavigationManager Nav
@inject SetupToken Setup
@inject ISignInOptions SignInOptions
@rendermode InteractiveServer

<PageTitle>Sign in — tamp.findings</PageTitle>

<div class="signin">
    <div class="signin__brand">
        <div class="brand">tamp<span class="brand__accent">.findings</span></div>
        <div class="kicker">attestation evidence</div>
    </div>

    <Card Class="signin__card">
        <h1>Sign in</h1>

        @if (Reason is { Length: > 0 })
        {
            <div class="row" style="margin: var(--space-3) 0">
                <Chip Label="Refused" Tone="var(--color-critical)" Style="Chip.ChipStyle.Solid" Glyph="✕" />
                <span>@ReasonText</span>
            </div>
        }

        @if (Setup.IsRequired)
        {
            @* Only while nobody has claimed the instance. Once an admin
               exists this disappears and the token stops working. *@
            <div class="claim">
                <div class="row">
                    <Chip Label="Unclaimed" Tone="var(--color-medium)" Style="Chip.ChipStyle.Dashed" Glyph="?" />
                    <span>No administrator exists on this instance yet.</span>
                </div>
                <TextField Label="Setup token" Mono="true" @bind-Value="_setupToken"
                           Help="Printed in this instance's startup log. Whoever can read that log is the operator — that is what the token proves." />
                <p class="field__help">
                    Enter it to claim the administrator seat. A wrong token creates no account, so
                    the instance stays claimable.
                </p>
            </div>
        }
        else
        {
            <p class="muted">
                tamp.findings uses your identity provider. It never stores a password.
            </p>
        }

        @* One button per configured provider (TFND-111 shipped the registry;
           this page only ever offered the built-in GitHub scheme, so a
           provider added through the admin screen had a working endpoint and
           no way to reach it).

           A plain link, not a Blazor navigation: this leaves the app entirely
           and hands off to the OAuth handler, which has to be a full request. *@
        @if (_options is null)
        {
            <p class="muted">Loading sign-in options…</p>
        }
        else if (_options.Count == 0)
        {
            @* Said out loud rather than rendered as a card with no buttons.
               No provider is configured, so NOBODY can sign in — including
               whoever needs to sign in to fix it. That is an operator problem
               and the page should name it, not look merely empty. *@
            <div class="row" style="margin: var(--space-3) 0">
                <Chip Label="No providers" Tone="var(--color-critical)" Style="Chip.ChipStyle.Solid" Glyph="✕" />
                <span>This instance has no identity provider configured, so there is no way to sign in.</span>
            </div>
            <p class="field__help">
                An operator has to add one — either the built-in GitHub OAuth credentials in the
                environment, or a provider in the system administration screen.
            </p>
        }
        else
        {
            foreach (var option in _options)
            {
                <a class="btn btn--primary" href="@Href(option)">
                    <Icon Name="lock" Size="14" />
                    <span>Continue with @option.DisplayName</span>
                </a>
            }
        }

        <p class="field__help">
            New accounts start with read access and no role. An administrator grants roles per
            client, project or component — until then you can see evidence and change nothing.
        </p>
    </Card>
</div>

@code {
    /// <summary>Set by /auth/denied so the reason survives the redirect.</summary>
    [SupplyParameterFromQuery] public string? Reason { get; set; }

    /// <summary>Where to return after signing in. Defaults to the portfolio.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string? _setupToken;

    /// <summary>
    /// Null until loaded — distinct from an empty list, which means no provider
    /// is configured. The page renders those two states differently and must
    /// never show "nobody can sign in" merely because the query has not
    /// returned yet.
    /// </summary>
    private IReadOnlyList<SignInOption>? _options;

    protected override async Task OnInitializedAsync() =>
        _options = await SignInOptions.AvailableAsync();

    private string Href(SignInOption option)
    {
        // Only a LOCAL path is ever forwarded. An absolute URL here would
        // make this an open redirect — a phisher could send someone a
        // tamp.findings sign-in link that lands them somewhere else
        // afterwards, having just typed a password into a real login page.
        var target = ReturnUrl is { Length: > 0 } r && r.StartsWith('/') && !r.StartsWith("//")
            ? r
            : Routes.Portfolio;

        var href = $"{option.LoginPath}?returnUrl={Uri.EscapeDataString(target)}";

        // Only sent while the instance is unclaimed. Appending it once an
        // admin exists would put a useless secret-shaped value in browser
        // history and proxy logs for no reason.
        //
        // Offered on EVERY provider, not just the first: the claim is of the
        // instance, not of a particular way in, and whoever is holding the
        // startup log may not have an account with the provider that happens
        // to be listed first.
        if (Setup.IsRequired && !string.IsNullOrWhiteSpace(_setupToken))
        {
            href += $"&setupToken={Uri.EscapeDataString(_setupToken)}";
        }

        return href;
    }

    private string ReasonText => Reason switch
    {
        "not_approved" =>
            "This account is not approved on this instance yet. An administrator has to approve it.",
        "no_email" =>
            "Your identity provider did not share an email address, which this instance requires.",
        "setup_token" =>
            "That setup token was wrong, so no account was created. The instance is still unclaimed — "
            + "check the startup log and try again.",
        _ => "Sign-in did not complete. Try again, or ask an administrator to check the logs.",
    };
}
