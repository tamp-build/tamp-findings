@page "/c/{Client}/policy"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject Tamp.Findings.Application.Projects.ClientQuery Clients
@inject Tamp.Findings.Application.Policy.ClientPolicyService Svc
@inject Tamp.Findings.Application.Policy.PolicyTemplateService Templates
@using Tamp.Findings.Domain.Risk
@using Tamp.Findings.Domain.Values
@using Tamp.Findings.Application.Policy
@using Tamp.Findings.Application.Authorization

<PageTitle>Policy — @Client</PageTitle>

<div class="stack">
    <nav class="crumbs">
        <a href="@Routes.Portfolio">Portfolio</a>
        <span class="crumbs__sep">/</span>
        <a href="@Routes.Client(Client)">@Client</a>
        <span class="crumbs__sep">/</span>
        <span>Policy</span>
    </nav>

    @if (_loading)
    {
        <p class="muted">Loading…</p>
    }
    else if (_view is null)
    {
        <Card><p>No client <code class="mono">@Client</code>. <a href="@Routes.Portfolio">← Portfolio</a></p></Card>
    }
    else
    {
        <div class="cathero">
            <div>
                <h1>@_view.Name — policy</h1>
                <div class="muted">The client layer (ADR 0007): the template it inherits, plus its own hardening. A client can only add or tighten; switching the template needs InfoSec approval.</div>
            </div>
        </div>

        @if (_message is { } msg)
        {
            <Card>
                <div class="row"><Chip Label="@_messageChip" Tone="@_messageTone" /> <span>@msg</span></div>
            </Card>
        }

        <Card>
            <div class="kicker">Inherited template</div>
            <div class="row" style="flex-wrap: wrap; gap: 10px">
                <span>@(_view.TemplateLabel ?? "None — this client inherits no template.")</span>
                <select @bind="_selectedTemplateId" class="mono">
                    <option value="">— pick a template —</option>
                    @foreach (var t in _templates)
                    {
                        <option value="@t.Id">@t.Name v@(t.Version)</option>
                    }
                </select>
                <button class="btn" disabled="@(_busy || string.IsNullOrEmpty(_selectedTemplateId) || !_canEdit)" @onclick="RequestSwitchAsync">Request switch</button>
            </div>
            <p class="field__help">Switching swaps the baseline every project under this client inherits, so it goes to InfoSec.</p>
        </Card>

        <div class="cathero"><div><h2>Client hardening</h2><div class="muted">Applied on top of the template. Applies directly — it can only tighten.</div></div></div>

        <Card>
            <div class="kicker">Enforcement mode</div>
            <div class="row">
                <button class="cattab @(_layer!.Mode == null ? "cattab--active" : null)" @onclick="() => _layer.Mode = null">Inherit</button>
                <button class="cattab @(_layer.Mode == EnforcementMode.Advisory ? "cattab--active" : null)" @onclick="() => _layer.Mode = EnforcementMode.Advisory">Advisory</button>
                <button class="cattab @(_layer.Mode == EnforcementMode.Enforcing ? "cattab--active" : null)" @onclick="() => _layer.Mode = EnforcementMode.Enforcing">Enforcing</button>
            </div>
        </Card>

        <Card Padded="false">
            <ScrollBox Label="Acceptance gates (add or tighten)">
                <table class="table table--rows">
                    <thead><tr><th>Gate</th><th>On</th><th class="align-end">Threshold</th></tr></thead>
                    <tbody>
                        @foreach (var key in GateEvaluator.WellKnownGateKeys)
                        {
                            var on = _layer!.Gates.TryGetValue(key, out var g) && g.Enabled;
                            <tr class="@(on ? null : "contrib__row--off")">
                                <td><div>@GateEvaluator.Label(key)</div><div class="mono muted cat__rule">@key</div></td>
                                <td><input type="checkbox" checked="@on" @onchange="e => ToggleGate(key, (bool)e.Value!)" /></td>
                                <td class="align-end">
                                    @if (on && GateService.TakesThreshold(key))
                                    {
                                        <input class="mono" style="width: 5rem; text-align: right" type="number" step="any"
                                               value="@(g!.Threshold?.ToString() ?? "")"
                                               @onchange="e => SetThreshold(key, e.Value?.ToString())" />
                                    }
                                    else { <span class="muted">—</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </ScrollBox>
        </Card>

        <div class="covgrid">
            <Card>
                <div class="kicker">Additional required scanners</div>
                @foreach (var s in ScannerClasses)
                {
                    <label class="row" style="gap: 6px">
                        <input type="checkbox" checked="@_layer!.RequiredScanners.Contains(s)" @onchange="e => ToggleScanner(s, (bool)e.Value!)" /> @s
                    </label>
                }
            </Card>
            <Card>
                <div class="kicker">Additional denied licences</div>
                <input class="mono" style="width: 100%" value="@string.Join(", ", _layer!.DeniedLicenses)" @onchange="e => SetDenied(e.Value?.ToString())" />
            </Card>
        </div>

        <Card>
            <div class="kicker">POA&M deadlines (days) — shorter than the template only</div>
            <div class="row" style="flex-wrap: wrap; gap: 16px">
                @foreach (var sev in Severities)
                {
                    <label class="row" style="gap: 6px">@sev
                        <input class="mono" style="width: 5rem" type="number"
                               value="@(_layer!.PoamDeadlineDays.TryGetValue(sev, out var d) ? d.ToString() : "")"
                               @onchange="e => SetPoam(sev, e.Value?.ToString())" />
                    </label>
                }
            </div>
        </Card>

        <div class="row">
            <button class="btn" disabled="@(_busy || !_canEdit)" @onclick="SaveHardeningAsync">@(_busy ? "Saving…" : "Save hardening")</button>
            @if (!_canEdit) { <span class="field__help">You need the policy-authoring capability to save.</span> }
        </div>
    }
</div>

@code {
    [Parameter] public string Client { get; set; } = "";

    private bool _loading = true, _busy, _canEdit;
    private Guid _clientId;
    private ClientPolicyView? _view;
    private PolicyLayer? _layer;
    private IReadOnlyList<PolicyTemplateCard> _templates = [];
    private string _selectedTemplateId = "";
    private string? _message, _messageChip, _messageTone;

    private static readonly string[] Severities = ["Critical", "High", "Medium", "Low"];
    private static readonly string[] ScannerClasses =
    [
        PolicyTemplateDefaults.ScannerClasses.StaticAnalysis, PolicyTemplateDefaults.ScannerClasses.DynamicScan,
        PolicyTemplateDefaults.ScannerClasses.Secrets, PolicyTemplateDefaults.ScannerClasses.Iac,
        PolicyTemplateDefaults.ScannerClasses.Sbom, PolicyTemplateDefaults.ScannerClasses.Coverage,
    ];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _message = null;
        var detail = await Clients.LoadAsync(Client, await Me.VisibleAsync());
        if (detail is null) { _view = null; _loading = false; return; }

        _clientId = detail.Id;
        _canEdit = await Me.CanAsync(Capability.EditPolicyWeights, new ScopeTarget(_clientId, null));
        _view = await Svc.LoadAsync(_clientId);
        _layer = _view is null ? null : Clone(_view.Overlay);
        _templates = await Templates.LibraryAsync();
        _loading = false;
    }

    private void ToggleGate(string key, bool on)
    {
        if (on) _layer!.Gates[key] = new GateConfig { Enabled = true, Threshold = _layer.Gates.GetValueOrDefault(key)?.Threshold };
        else _layer!.Gates.Remove(key);
    }
    private void SetThreshold(string key, string? raw)
    {
        if (_layer!.Gates.TryGetValue(key, out var g)) g.Threshold = double.TryParse(raw, out var v) ? v : null;
    }
    private void ToggleScanner(string s, bool on)
    {
        if (on) { if (!_layer!.RequiredScanners.Contains(s)) _layer.RequiredScanners.Add(s); }
        else _layer!.RequiredScanners.Remove(s);
    }
    private void SetDenied(string? raw) =>
        _layer!.DeniedLicenses = (raw ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct().ToList();
    private void SetPoam(string sev, string? raw)
    {
        if (int.TryParse(raw, out var v) && v > 0) _layer!.PoamDeadlineDays[sev] = v;
        else _layer!.PoamDeadlineDays.Remove(sev);
    }

    private async Task RequestSwitchAsync()
    {
        if (!Guid.TryParse(_selectedTemplateId, out var newId)) return;
        _busy = true;
        var actor = await Me.AtAsync(new ScopeTarget(_clientId, null));
        var res = await Svc.RequestTemplateSwitchAsync(actor!, _clientId, newId);
        _busy = false;
        if (res.Success) { _message = "Template switch submitted to InfoSec for approval."; _messageChip = "Submitted"; _messageTone = "var(--color-band-orange)"; }
        else { _message = res.Error; _messageChip = "Refused"; _messageTone = "var(--color-critical)"; }
    }

    private async Task SaveHardeningAsync()
    {
        if (_layer is null) return;
        _busy = true;
        var actor = await Me.AtAsync(new ScopeTarget(_clientId, null));
        var res = await Svc.SaveHardeningAsync(actor!, _clientId, _layer);
        _busy = false;
        if (res.Success) { _message = "Client hardening saved. Applies to every project under this client on their next evaluation."; _messageChip = "Applied"; _messageTone = "var(--color-pass)"; }
        else { _message = res.Error; _messageChip = "Refused"; _messageTone = "var(--color-critical)"; }
    }

    private static PolicyLayer Clone(PolicyLayer l) => new()
    {
        SchemaVersion = l.SchemaVersion,
        Mode = l.Mode,
        RequiredScanners = [.. l.RequiredScanners],
        DeniedLicenses = [.. l.DeniedLicenses],
        Gates = l.Gates.ToDictionary(k => k.Key, v => new GateConfig { Enabled = v.Value.Enabled, Threshold = v.Value.Threshold }),
        PoamDeadlineDays = new(l.PoamDeadlineDays),
    };
}
