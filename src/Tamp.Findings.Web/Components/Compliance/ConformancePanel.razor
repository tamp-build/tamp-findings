@using Tamp.Findings.Domain.Compliance
@using Tamp.Findings.Application.Compliance
@inject CurrentUser Me
@inject ConformanceDispositionService Disposition

@* ADR-conformance evidence (v3 §5 / ADR 0006). Four-valued verdicts, never
   collapsed to pass/fail: Unknown and Error block and are never green. A
   dispositioned fail stays listed (red OUTLINE, not fill) with its justification.
   A blocking finding can be risk-accepted (VEX-disposition, TFND-198) by InfoSec
   (Capability.AcceptRisk) with a justification and optional expiry — the same
   accept-risk contract as a POA&M; a dispositioned finding no longer blocks. *@

<div class="stack">
    <div class="confgrid">
        <div class="conftile conftile--pass"><span class="conftile__n">@Report.Pass</span><span class="conftile__l">✓ Pass</span></div>
        <div class="conftile conftile--fail"><span class="conftile__n">@Report.Fail</span><span class="conftile__l">✕ Fail</span></div>
        <div class="conftile conftile--unknown"><span class="conftile__n">@Report.Unknown</span><span class="conftile__l">? Unknown</span></div>
        <div class="conftile conftile--error"><span class="conftile__n">@Report.Error</span><span class="conftile__l">! Error</span></div>
        @if (Report.Dispositioned > 0)
        {
            <div class="conftile conftile--disp"><span class="conftile__n">@Report.Dispositioned</span><span class="conftile__l">⊘ Dispositioned</span></div>
        }
    </div>

    <div class="mono conf__run">
        conformance.evaluated · @(Report.CommitSha?[..Math.Min(7, Report.CommitSha.Length)] ?? "—") ·
        rules @(Report.RulesSha ?? "—") · @Report.Findings.Count rules ·
        @Report.Deterministic deterministic, @Report.Semantic semantic · frozen @Report.EvaluatedAt.ToString("u")
    </div>

    @if (Report.ControlCounts.Count > 0)
    {
        <div class="conf__controls">
            <span class="ctlpanel__baselabel">Controls</span>
            @foreach (var (id, n) in Report.ControlCounts.OrderBy(c => c.Key))
            {
                <button class="ctlchip mono @(_control == id ? "ctlchip--sel" : null)" @onclick="() => Toggle(id)">@id · @n</button>
            }
            @if (_control is not null)
            {
                <button class="conf__clear" @onclick="() => _control = null">clear filter</button>
            }
        </div>
    }

    @foreach (var f in Shown)
    {
        <div class="confcard confcard--@Tone(f)">
            <div class="confcard__head">
                <span class="confverdict confverdict--@Tone(f)">@Glyph(f.Verdict) @f.Verdict.ToString().ToUpperInvariant()</span>
                <div class="confcard__claim">
                    <div>@f.Claim</div>
                    <div class="mono muted cat__rule">@f.RuleId · @f.AdrRef@(f.Location is { } loc ? $" · {loc}" : "")</div>
                </div>
                <div class="confcard__badges">
                    <span class="confbadge @(f.Method == ConformanceMethod.Deterministic ? "confbadge--det" : "confbadge--sem")">
                        @(f.Method == ConformanceMethod.Deterministic ? "≡ DETERMINISTIC" : $"~ SEMANTIC · {f.ModelId}")
                    </span>
                    @if (f.VerifyVerdict != VerifyOutcome.NotRun)
                    {
                        <span class="confbadge mono">@(f.VerifyVerdict == VerifyOutcome.Confirmed ? "✓ verify pass confirmed" : "✕ disputed")</span>
                    }
                    @foreach (var c in f.ControlRefs)
                    {
                        <span class="ctlpanel__base ctlpanel__base--in">@c</span>
                    }
                </div>
            </div>

            @if (f.Verdict is ConformanceVerdict.Fail && (f.AdrQuote is not null || f.CodeEvidence is not null))
            {
                <div class="confsplit">
                    @if (f.AdrQuote is { } q)
                    {
                        <div class="confsplit__quote"><div class="ctlpanel__baselabel">ADR says</div><p>@q</p></div>
                    }
                    @if (f.CodeEvidence is { } codeText)
                    {
                        <pre class="confsplit__code mono">@codeText</pre>
                    }
                </div>
            }
            else if (f.Verdict is ConformanceVerdict.Unknown)
            {
                <p class="field__help">No answer — the rule could not be evaluated. Remedy: re-anchor the rule or fix the pipeline. It blocks; a missing answer is never a pass.</p>
            }
            else if (f.Verdict is ConformanceVerdict.Error)
            {
                <p class="field__help">Evaluation broke — operator alerted. The last good verdict is not carried forward.</p>
            }

            @if (f.Dispositioned)
            {
                <div class="confdisp">
                    <div class="row"><Chip Label="⊘ Dispositioned with justification" Tone="var(--color-medium)" /></div>
                    <p>@f.DispositionJustification</p>
                    <p class="field__help mono">accepted by @f.DispositionedByLogin · InfoSec · AcceptRisk@(f.DispositionExpiry is { } exp ? $" · expires {exp:yyyy-MM-dd}" : "")</p>
                </div>
            }
            else if (f.Verdict is not ConformanceVerdict.Pass)
            {
                <div class="confcard__act">
                    <Button Variant="Button.ButtonVariant.Secondary"
                            Disabled="@(!_can.Allowed || _busy)"
                            DisabledReason="@(_can.Allowed ? null : _can.Reason)"
                            OnClick="@(() => OpenAccept(f))">Accept risk…</Button>
                </div>
            }
        </div>
    }
</div>

<Dialog Open="@(_accept is not null)" OpenChanged="AcceptOpenChanged" Title="Accept conformance risk" Width="620">
    <ChildContent>
        @if (_accept is { } f)
        {
            <p class="field__help">
                Accepting risk records a reviewed deviation for <strong>@f.RuleId · @f.AdrRef</strong>
                (@f.Verdict.ToString().ToUpperInvariant()). The finding stays listed but no longer blocks the
                build. This is InfoSec's call (AcceptRisk) and is written to the audit trail — the same
                contract as a POA&M risk acceptance.
            </p>
            <TextField Label="Justification" @bind-Value="_justification" Multiline Rows="4"
                       Help="Why is this deviation acceptable? Recorded on the finding and in the audit log." />
            <TextField Label="Expiry (optional)" Type="date" @bind-Value="_expiry" Mono
                       Help="After this date the acceptance lapses and the finding blocks again. Leave blank for no expiry." />
            @if (_actionError is not null)
            {
                <p class="field__help" style="color: var(--color-critical)">@_actionError</p>
            }
        }
    </ChildContent>
    <Footer>
        <Button Variant="Button.ButtonVariant.Text" OnClick="@(() => _accept = null)">Cancel</Button>
        <Button Variant="Button.ButtonVariant.Primary" Disabled="_busy" OnClick="SubmitAccept">Accept risk</Button>
    </Footer>
</Dialog>

@code {
    [Parameter, EditorRequired] public ConformanceReport Report { get; set; } = default!;
    // The build's project — needed to author a disposition and gate it. Optional so the
    // panel still renders read-only (no accept action) when a host doesn't supply them.
    [Parameter] public Guid ClientId { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    // Raised after a successful disposition so the host reloads the report.
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _control;
    private AuthorizationDecision _can = AuthorizationDecision.Deny("loading");
    private ConformanceFindingRow? _accept;
    private string _justification = "";
    private string _expiry = "";
    private bool _busy;
    private string? _actionError;

    private ScopeTarget Here => ProjectId == Guid.Empty ? ScopeTarget.Instance : ScopeTarget.Project(ClientId, ProjectId);

    protected override async Task OnParametersSetAsync()
    {
        _can = ProjectId == Guid.Empty ? AuthorizationDecision.Deny("no project") : await Me.CanAsync(Capability.AcceptRisk, Here);
    }

    private void OpenAccept(ConformanceFindingRow f)
    {
        _accept = f; _justification = ""; _expiry = ""; _actionError = null;
    }

    private void AcceptOpenChanged(bool open)
    {
        if (!open) _accept = null;
    }

    private async Task SubmitAccept()
    {
        if (_accept is null || _busy) return;
        if (string.IsNullOrWhiteSpace(_justification)) { _actionError = "A justification is required."; return; }
        DateTimeOffset? expiry = null;
        if (!string.IsNullOrWhiteSpace(_expiry))
        {
            if (!DateTimeOffset.TryParse(_expiry, out var parsed)) { _actionError = "Expiry is not a valid date."; return; }
            expiry = parsed;
        }
        _busy = true; _actionError = null;
        try
        {
            var actor = await Me.AtAsync(Here);
            if (actor is null) { _actionError = "You must be signed in to accept risk."; return; }
            var result = await Disposition.DisposeAsync(actor, Here, ProjectId, _accept.Id, _justification.Trim(), expiry);
            if (!result.Success) { _actionError = result.Error; return; }
            _accept = null;
            await OnChanged.InvokeAsync();
        }
        finally { _busy = false; }
    }

    private IEnumerable<ConformanceFindingRow> Shown =>
        _control is null ? Report.Findings : Report.Findings.Where(f => f.ControlRefs.Contains(_control));

    private void Toggle(string id) => _control = _control == id ? null : id;

    private static string Tone(ConformanceFindingRow f) =>
        f.Dispositioned ? "disp"
        : f.Verdict switch
        {
            ConformanceVerdict.Pass => "pass",
            ConformanceVerdict.Fail => "fail",
            ConformanceVerdict.Unknown => "unknown",
            _ => "error",
        };

    private static string Glyph(ConformanceVerdict v) => v switch
    {
        ConformanceVerdict.Pass => "✓", ConformanceVerdict.Fail => "✕", ConformanceVerdict.Unknown => "?", _ => "!",
    };
}
