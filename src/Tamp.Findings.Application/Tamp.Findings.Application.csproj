<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tamp.Findings.Application</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>Application layer for tamp.findings (ADR 0002). Owns the authorization evaluator, the query/command services and the audit write path. Api, Web and Mcp are three transports over this — authorization is decided here, once, so a transport that forgets to check is not a vulnerability.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- IDataProtectionProvider. Identity-provider secrets are encrypted at
         rest by the Application layer rather than by a transport, so the
         protector lives where the write happens (TFND-111). -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <!-- HttpClient + JsonContent for the GitHub App client (TFND-23). -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The OSCAL and PDF writers are internal because nothing outside the
         exporter should build one, and their OUTPUT SHAPE is what a FedRAMP
         assessor's tooling consumes — so it has to be asserted. -->
    <InternalsVisibleTo Include="Tamp.Findings.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tamp.Findings.Domain\Tamp.Findings.Domain.csproj" />
    <ProjectReference Include="..\Tamp.Findings.Data\Tamp.Findings.Data.csproj" />
  </ItemGroup>

</Project>
