<Project Sdk="Microsoft.NET.Sdk">

  <!--
    tamp.findings build orchestrator (TFND-14). Drives the whole build via
    Tamp wrappers and ingests every scanner's output back into the running
    tamp.findings API at http://localhost:5080 — closing the dogfood loop.

    Inherits SecurityPipelineBuild from Tamp.Security.Pipeline, which adds
    Sbom / OpenGrep / OsvScanner / Trivy / DependencyTrack / DefectDojo
    targets for free. We layer on TruffleHog (not in the meta), .NET-side
    Compile/Test/Coverage, and an Ingest target that POSTs SARIF/JSON
    payloads to the tamp.findings API.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tamp.Findings.Build</RootNamespace>
    <AssemblyName>Tamp.Findings.Build</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- This is a build script; it never ships. -->
    <Authors></Authors>
    <Description></Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tamp.Security.Pipeline" />
    <PackageReference Include="Tamp.TruffleHog.V3" />
    <PackageReference Include="Tamp.GitVersion.V6" />
    <PackageReference Include="Tamp.DotNetCoverage.V18" />
    <PackageReference Include="Tamp.Coverlet.V6" />
    <PackageReference Include="Tamp.ReportGenerator.V5" />
  </ItemGroup>

</Project>
